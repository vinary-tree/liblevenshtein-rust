// American English Text-Speak / SMS Abbreviations
// Normalizes informal spellings to standard forms for fuzzy matching
//
// NOTE: Single-letter expansions (c->see, r->are, u->you, n->and, etc.)
// have been removed because they violate the bounded expansion guarantee
// and can cause runaway normalization when combined with other rules.

@version "1.0.0";

// ============================================================
// Common abbreviations with numbers
// ============================================================

[id: 220, name: "b4 for before", weight: 0.0, group: text_speak]
b4 -> before / #_#;

[id: 221, name: "l8r for later", weight: 0.0, group: text_speak]
l8r -> later / #_#;

[id: 222, name: "l8 for late", weight: 0.0, group: text_speak]
