[id: 13939, name: "ढ ḍha", weight: 0.05, group: nepali_retroflex, ipa: "/ɖʱʌ/"]
ढ -> ɖʱʌ;

[id: 13940, name: "ण ṇa", weight: 0.05, group: nepali_retroflex, ipa: "/ɳʌ/"]
ण -> ɳʌ;

