[id: 3438, name: "г to g", weight: 0.2, group: serbian_consonants]
г -> g;

[id: 3439, name: "Г to g", weight: 0.2, group: serbian_consonants]
Г -> g;

[id: 3440, name: "д to d", weight: 0.2, group: serbian_consonants]
д -> d;

[id: 3441, name: "Д to d", weight: 0.2, group: serbian_consonants]
