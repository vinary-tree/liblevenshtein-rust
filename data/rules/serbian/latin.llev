// Serbian Latin Script Phonetic Rules
// ====================================
// Phonetic rules for Serbian (Srpski jezik) - Latin script.
// Normalizes Serbian Latin digraphs and diacritics.
//
// Key features:
//   - Perfect phonemic orthography: one letter = one sound
//   - Latin digraphs: lj, nj, dž (treated as single phonemes)
//   - Diacritics: č, ć, š, ž, đ
//   - Latin script more common in casual/modern use
//
// Serbian Latin alphabet (30 letters including digraphs):
// A B C Č Ć D Dž Đ E F G H I J K L Lj M N Nj O P R S Š T U V Z Ž
//
// Rule IDs: 3464-3499

@name "Serbian Latin Phonetic Rules"
@version "1.0.0"
@author "liblevenshtein"
@description "Phonetic normalization rules for Serbian Latin script"

// ============================================================
// DIGRAPHS (highest priority - must match before singles)
// ============================================================
// Note: Case variants removed - case-insensitive matching is automatic

// Lj/lj → ʎ (palatal lateral approximant)
[id: 3464, name: "lj to ʎ", weight: 0.05, group: serbian_latin_digraphs, ipa: "/ʎ/"]
lj -> ʎ;

// Nj/nj → ɲ (palatal nasal)
[id: 3467, name: "nj to ɲ", weight: 0.05, group: serbian_latin_digraphs, ipa: "/ɲ/"]
nj -> ɲ;

// Dž/dž → d͡ʒ (voiced postalveolar affricate)
[id: 3470, name: "dž to d͡ʒ", weight: 0.05, group: serbian_latin_digraphs, ipa: "/d͡ʒ/"]
dž -> d͡ʒ;

// ============================================================
// DIACRITICAL CONSONANTS
// ============================================================
// Note: Case variants removed - case-insensitive matching is automatic

// Č/č → t͡ʃ (voiceless postalveolar affricate)
[id: 3473, name: "č to t͡ʃ", weight: 0.1, group: serbian_latin_diacritics, ipa: "/t͡ʃ/"]
č -> t͡ʃ;

// Ć/ć → tɕ (voiceless alveolo-palatal affricate, softer than č)
[id: 3475, name: "ć to tɕ", weight: 0.1, group: serbian_latin_diacritics, ipa: "/tɕ/"]
ć -> tɕ;

// Š/š → ʃ (voiceless postalveolar fricative)
[id: 3477, name: "š to ʃ", weight: 0.1, group: serbian_latin_diacritics, ipa: "/ʃ/"]
š -> ʃ;

// Ž/ž → ʒ (voiced postalveolar fricative)
[id: 3479, name: "ž to ʒ", weight: 0.1, group: serbian_latin_diacritics, ipa: "/ʒ/"]
ž -> ʒ;

// Đ/đ → dʑ (voiced alveolo-palatal affricate)
[id: 3481, name: "đ to dʑ", weight: 0.1, group: serbian_latin_diacritics, ipa: "/dʑ/"]
đ -> dʑ;

// ============================================================
// PLAIN CONSONANTS WITH IPA TRANSFORMATIONS
// ============================================================

// C/c → t͡s (voiceless alveolar affricate)
[id: 3485, name: "c to t͡s", weight: 0.1, group: serbian_latin_consonants, ipa: "/t͡s/"]
c -> t͡s;

// H/h → x (voiceless velar fricative)
[id: 3491, name: "h to x", weight: 0.1, group: serbian_latin_consonants, ipa: "/x/"]
h -> x;

