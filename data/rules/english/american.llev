// After N
[id: 520, name: "yod-drop new", weight: 0.2, group: american_yod, ipa: "/nuː/"]
new -> nuː;

[id: 521, name: "yod-drop news", weight: 0.2, group: american_yod, ipa: "/nuːz/"]
news -> nuːz;

[id: 522, name: "yod-drop nude", weight: 0.2, group: american_yod, ipa: "/nuːd/"]
nude -> nuːd;

[id: 523, name: "yod-drop nuisance", weight: 0.2, group: american_yod, ipa: "/nuːsəns/"]
nuisance -> nuːsəns;

