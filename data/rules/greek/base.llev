δ -> ð;

[id: 3275, name: "ζ to z", weight: 0.15, group: greek_consonants]
ζ -> z;

// Note: θ (theta) passes through unchanged - already in IPA form

[id: 3277, name: "κ to k", weight: 0.15, group: greek_consonants]
κ -> k;

[id: 3278, name: "λ to l", weight: 0.15, group: greek_consonants]
