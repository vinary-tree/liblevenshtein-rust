@startuml wallbreaker-scdawg-walk
' Current WallBreaker candidate paths. The query does not run the separate
' experimental BidirectionalExtension helper.
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam sequence {
  ArrowColor #37474F
  LifeLineBorderColor #455A64
  ParticipantBorderColor #D84315
  ParticipantBackgroundColor #FFCCBC
  ParticipantFontColor #102027
}

title WallBreaker — one snapshot, two exact candidate paths

actor "Caller" as C #E3F2FD
participant "WallBreakerQuery\nquery and bound" as Q #FFCCBC
participant "PatternSplitter" as S #FBE9E7
participant "Snapshot dictionary\nsubstring + term cursor" as D #C8E6C9
participant "Whole-term verifier\nexact distance <latex>\le k</latex>" as V #E1BEE7

C -> Q : create query iterator
Q -> D : capture one immutable root
alt no nonempty surviving-piece proof
  note over Q #FFF3E0: short/empty query, unrestricted Damerau,\nor undersized caller splitter
  loop each complete term in captured revision
    Q -> D : borrow next complete term
    D --> Q : borrowed term
    Q -> V : length prune; exact whole-term distance
    V --> Q : accepted term and distance, if any
  end
else surviving-piece proof applies
  Q -> S : split by algorithm and edit bound
  note over S #FBE9E7: Standard: <latex>k+1</latex> pieces;\nTransposition/MergeAndSplit: <latex>2k+1</latex> pieces
  loop each nonempty piece
    Q -> D : exact substring matches in captured root
    D --> Q : this piece's candidate occurrences
    Q -> V : exact whole-term distance
    V --> Q : accepted term and distance, if any
  end
end
Q --> C : deduplicated accepted terms, first-seen order
@enduml
