    {
      "name": "llev_query_cursor_release_batch",
      "rustModule": "index"
    },
    {
      "name": "llev_query_cursor_reduce",
      "rustModule": "index"
    },
    {
      "name": "llev_query_cursor_free",
      "rustModule": "index"
    },
    {
      "name": "llev_owned_string_free",
      "rustModule": "phonetic"
    },
    {
      "name": "llev_phonetic_pattern_compile_regex",
      "rustModule": "phonetic"
    },
    {
      "name": "llev_phonetic_pattern_compile_llre",
