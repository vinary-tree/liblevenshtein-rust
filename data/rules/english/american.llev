[id: 543, name: "yod-drop lunar", weight: 0.2, group: american_yod, ipa: "/luːnəɹ/"]
lunar -> luːnəɹ;

[id: 544, name: "yod-drop ludicrous", weight: 0.2, group: american_yod, ipa: "/luːdɪkɹəs/"]
ludicrous -> luːdɪkɹəs;

[id: 545, name: "yod-drop illuminate", weight: 0.2, group: american_yod, ipa: "/luːmɪneɪt/"]
luminate -> luːmɪneɪt;

// After Z
[id: 550, name: "yod-drop zeus", weight: 0.2, group: american_yod, ipa: "/zuːs/"]
zeus -> zuːs;

[id: 551, name: "yod-drop resume", weight: 0.2, group: american_yod, ipa: "/zuːm/"]
zume -> zuːm;

// ============================================================
// T-FLAPPING RULES (American English)
// ============================================================
// In American English, intervocalic /t/ becomes a flap (sounds like /d/)
// This occurs between vowels, especially in unstressed syllables.

[id: 560, name: "t-flap water", weight: 0.25, group: american_flapping]
water -> wader;

[id: 561, name: "t-flap butter", weight: 0.25, group: american_flapping]
