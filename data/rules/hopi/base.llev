// Hopi Base Phonetic Rules
// ========================
// Phonetic rules for Hopi (Hopilàvayi).
// Spoken by approximately 7,000 people in northeastern Arizona.
//
// Hopi features:
//   - Uto-Aztecan language family
//   - 6 vowel qualities with length distinction
//   - Minimal labial consonants (p is marginal)
//   - Labialized velars and uvulars: kw, qw
//   - Voiceless sonorants: l̥, r̥, m̥, n̥, w̥, y̥
//   - Word-final vowel devoicing
//   - Complex syllable structure
//   - Falling pitch on long vowels
//
// Orthography (Third Mesa):
//   - Long vowels marked with double letters or macron
//   - ö for /ø/ or central vowel
//   - ng for velar nasal /ŋ/
//   - ' for glottal stop
//
// Rule IDs: 9400-9599

@name "Hopi Phonetic Rules"
@version "1.0.0"
@author "liblevenshtein"
@description "Phonetic normalization rules for Hopi (Hopilàvayi)"

// ============================================================
// SHORT VOWELS (weight 0.05)
// ============================================================

[id: 9400, name: "a short", weight: 0.05, group: hopi_vowels, ipa: "/a/"]
a -> a;

[id: 9401, name: "e short", weight: 0.05, group: hopi_vowels, ipa: "/e/"]
e -> e;

[id: 9402, name: "i short", weight: 0.05, group: hopi_vowels, ipa: "/i/"]
i -> i;

[id: 9403, name: "o short", weight: 0.05, group: hopi_vowels, ipa: "/o/"]
o -> o;

[id: 9404, name: "u short", weight: 0.05, group: hopi_vowels, ipa: "/u/"]
u -> u;

// Central/front rounded vowel (varies by dialect)
[id: 9405, name: "o umlaut", weight: 0.05, group: hopi_vowels, ipa: "/ø/"]
ö -> ø;

// ============================================================
// LONG VOWELS (weight 0.05)
// Marked by doubling or macron
// ============================================================

[id: 9410, name: "aa long", weight: 0.05, group: hopi_long_vowels, ipa: "/aː/"]
aa -> aː;

[id: 9411, name: "ee long", weight: 0.05, group: hopi_long_vowels, ipa: "/eː/"]
ee -> eː;

[id: 9412, name: "ii long", weight: 0.05, group: hopi_long_vowels, ipa: "/iː/"]
ii -> iː;

[id: 9413, name: "oo long", weight: 0.05, group: hopi_long_vowels, ipa: "/oː/"]
oo -> oː;

[id: 9414, name: "uu long", weight: 0.05, group: hopi_long_vowels, ipa: "/uː/"]
uu -> uː;

[id: 9415, name: "oo umlaut long", weight: 0.05, group: hopi_long_vowels, ipa: "/øː/"]
öö -> øː;

// Macron variants
[id: 9416, name: "a macron long", weight: 0.05, group: hopi_long_vowels, ipa: "/aː/"]
ā -> aː;

[id: 9417, name: "e macron long", weight: 0.05, group: hopi_long_vowels, ipa: "/eː/"]
ē -> eː;

[id: 9418, name: "i macron long", weight: 0.05, group: hopi_long_vowels, ipa: "/iː/"]
ī -> iː;

[id: 9419, name: "o macron long", weight: 0.05, group: hopi_long_vowels, ipa: "/oː/"]
ō -> oː;

[id: 9420, name: "u macron long", weight: 0.05, group: hopi_long_vowels, ipa: "/uː/"]
ū -> uː;

// ============================================================
// FALLING TONE VOWELS (weight 0.05)
// Marked with grave accent
// ============================================================

[id: 9425, name: "a falling", weight: 0.05, group: hopi_falling_tone, ipa: "/a˥˩/"]
à -> a˥˩;

[id: 9426, name: "e falling", weight: 0.05, group: hopi_falling_tone, ipa: "/e˥˩/"]
è -> e˥˩;

[id: 9427, name: "i falling", weight: 0.05, group: hopi_falling_tone, ipa: "/i˥˩/"]
ì -> i˥˩;

[id: 9428, name: "o falling", weight: 0.05, group: hopi_falling_tone, ipa: "/o˥˩/"]
ò -> o˥˩;

[id: 9429, name: "u falling", weight: 0.05, group: hopi_falling_tone, ipa: "/u˥˩/"]
ù -> u˥˩;

// ============================================================
// STOPS (weight 0.05)
// p is marginal in Hopi
// ============================================================

[id: 9430, name: "p marginal", weight: 0.05, group: hopi_stops, ipa: "/p/"]
p -> p;

[id: 9431, name: "t", weight: 0.05, group: hopi_stops, ipa: "/t/"]
t -> t;

[id: 9432, name: "k", weight: 0.05, group: hopi_stops, ipa: "/k/"]
k -> k;

[id: 9433, name: "kw labialized velar", weight: 0.05, group: hopi_stops, ipa: "/kʷ/"]
kw -> kʷ;

// Uvular stops
[id: 9434, name: "q uvular", weight: 0.05, group: hopi_stops, ipa: "/q/"]
q -> q;

[id: 9435, name: "qw labialized uvular", weight: 0.05, group: hopi_stops, ipa: "/qʷ/"]
qw -> qʷ;

// ============================================================
// GLOTTAL STOP (weight 0.05)
// ============================================================

[id: 9438, name: "glottal stop apostrophe", weight: 0.05, group: hopi_glottal, ipa: "/ʔ/"]
' -> ʔ;

[id: 9439, name: "glottal stop modifier", weight: 0.05, group: hopi_glottal, ipa: "/ʔ/"]
ʼ -> ʔ;

// ============================================================
// FRICATIVES (weight 0.05)
// ============================================================

[id: 9440, name: "s", weight: 0.05, group: hopi_fricatives, ipa: "/s/"]
s -> s;

[id: 9441, name: "h", weight: 0.05, group: hopi_fricatives, ipa: "/h/"]
h -> h;

[id: 9442, name: "v labiodental", weight: 0.05, group: hopi_fricatives, ipa: "/v/"]
v -> v;

// ============================================================
// NASALS (weight 0.05)
// ============================================================

[id: 9445, name: "m", weight: 0.05, group: hopi_nasals, ipa: "/m/"]
m -> m;

[id: 9446, name: "n", weight: 0.05, group: hopi_nasals, ipa: "/n/"]
n -> n;

[id: 9447, name: "ng velar nasal", weight: 0.05, group: hopi_nasals, ipa: "/ŋ/"]
ng -> ŋ;

// Velar nasal symbol
[id: 9448, name: "ng symbol", weight: 0.05, group: hopi_nasals, ipa: "/ŋ/"]
ŋ -> ŋ;

// ============================================================
// VOICELESS SONORANTS (weight 0.05)
// Distinctive feature of Hopi
// ============================================================

[id: 9450, name: "m voiceless", weight: 0.05, group: hopi_voiceless_sonorants, ipa: "/m̥/"]
m̥ -> m̥;

[id: 9451, name: "n voiceless", weight: 0.05, group: hopi_voiceless_sonorants, ipa: "/n̥/"]
n̥ -> n̥;

[id: 9452, name: "l voiceless", weight: 0.05, group: hopi_voiceless_sonorants, ipa: "/l̥/"]
l̥ -> l̥;

[id: 9453, name: "r voiceless", weight: 0.05, group: hopi_voiceless_sonorants, ipa: "/r̥/"]
r̥ -> r̥;

[id: 9454, name: "w voiceless", weight: 0.05, group: hopi_voiceless_sonorants, ipa: "/ʍ/"]
w̥ -> ʍ;

[id: 9455, name: "y voiceless", weight: 0.05, group: hopi_voiceless_sonorants, ipa: "/j̊/"]
y̥ -> j̊;

// ============================================================
// LIQUIDS AND APPROXIMANTS (weight 0.05)
// ============================================================

[id: 9460, name: "l", weight: 0.05, group: hopi_liquids, ipa: "/l/"]
l -> l;

[id: 9461, name: "r tap", weight: 0.05, group: hopi_liquids, ipa: "/ɾ/"]
r -> ɾ;

[id: 9462, name: "w", weight: 0.05, group: hopi_approximants, ipa: "/w/"]
w -> w;

[id: 9463, name: "y", weight: 0.05, group: hopi_approximants, ipa: "/j/"]
y -> j;

// ============================================================
// CONSONANT CLUSTERS (weight 0.05)
// ============================================================

[id: 9470, name: "ts affricate", weight: 0.05, group: hopi_clusters, ipa: "/t͡s/"]
ts -> t͡s;

[id: 9471, name: "ky palatalized", weight: 0.05, group: hopi_clusters, ipa: "/kʲ/"]
ky -> kʲ;

[id: 9472, name: "nk cluster", weight: 0.05, group: hopi_clusters, ipa: "/ŋk/"]
nk -> ŋk;

[id: 9473, name: "ngw cluster", weight: 0.05, group: hopi_clusters, ipa: "/ŋʷ/"]
ngw -> ŋʷ;

// ============================================================
// COMMON WORDS
// ============================================================

[id: 9500, name: "hopi", weight: 0.02, group: hopi_common]
hopi -> hopi;

[id: 9501, name: "hopilavayi hopi language", weight: 0.02, group: hopi_common]
hopilàvayi -> hopila˥˩vaji;

[id: 9502, name: "katsina spirit", weight: 0.02, group: hopi_common]
katsina -> kat͡sina;

[id: 9503, name: "lolma good", weight: 0.02, group: hopi_common]
lolma -> lolma;

[id: 9504, name: "kwakwha thank you", weight: 0.02, group: hopi_common]
kwakwhá -> kʷakʷha˦;

[id: 9505, name: "nuutungk hello", weight: 0.02, group: hopi_common]
nu'ùtungk -> nuʔu˥˩tuŋk;

[id: 9506, name: "paahu water", weight: 0.02, group: hopi_common]
pàahu -> pa˥˩ahu;

[id: 9507, name: "tuuwaqatsi earth life", weight: 0.02, group: hopi_common]
tuuwaqatsi -> tuːwaqat͡si;

[id: 9508, name: "qa not", weight: 0.02, group: hopi_common]
qa -> qa;

[id: 9509, name: "taawa sun", weight: 0.02, group: hopi_common]
taawa -> taːwa;

