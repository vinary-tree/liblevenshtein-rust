// COMMON WORDS
// NOTE: Identity mappings removed in v1.0.1 (inuktitut->inuktitut, inuk->inuk,
// inuit->inuit, nunavut->nunavut, ai->ai, taima->taima)
// Only transformations are retained.
// ============================================================

[id: 8751, name: "syllabic inuktitut", weight: 0.02, group: inuktitut_common]
ᐃᓄᒃᑎᑐᑦ -> inuktitut;

[id: 8756, name: "qujannamiik thank you", weight: 0.02, group: inuktitut_common]
qujannamiik -> qujanːamiːk;

