@startuml registry-topology
' Normative release ownership and publish-order DAG for 4.0.0-rc.4.
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam rectangle {
  RoundCorner 14
  BorderColor #37474F
  FontColor #102027
}
skinparam ArrowColor #37474F
skinparam ArrowThickness 2
top to bottom direction

title Vinary Tree 4.0.0-rc.4 — one owner per artifact, exact edges

rectangle "1 · Standalone ABI owner\nvinary-tree-interop\ntag v4.0.0-rc.4\nall shared resource-type packages" as INTEROP #C8E6C9

rectangle "2 · Dictionary producer\nlibdictenstein\nconstruction · CRUD · persistence" as LDICT #B2DFDB
rectangle "3 · Matching consumer\nliblevenshtein-rust\nautomata · queries · matching" as LLEV #FFCCBC
rectangle "4 · WFST toolkit\nlling-llang" as LLING #FFF9C4
rectangle "5 · Bridge toolkit\nduallity" as DUAL #BBDEFB

rectangle "6 · Standalone JS runtime owner\njavascript-runtime\n@vinary-tree/vinary-tree\n6 native + browser-WASM + WASI" as RUNTIME #D1C4E9
rectangle "7 · Scoped project facades\n@vinary-tree/libdictenstein\n@vinary-tree/liblevenshtein\n@vinary-tree/lling-llang\n@vinary-tree/duallity" as SCOPED #E1BEE7
rectangle "8 · Legacy-name compatibility owner\nliblevenshtein-npm\nliblevenshtein@4.0.0-rc.4\nnext only; latest remains 2.0.4" as COMPAT #F8BBD0

INTEROP -[#2E7D32]-> LDICT : exact ABI package
INTEROP -[#2E7D32]-> LLEV
LDICT -[#00796B]-> LLEV : producer before consumer
LLEV -[#D84315]-> LLING : exact optional integration
LDICT -[#00796B]-> LLING
LLING -[#F9A825]-> DUAL
LLEV -[#D84315]-> DUAL
LDICT -[#00796B]-> DUAL

INTEROP -[#2E7D32]-> RUNTIME
LDICT -[#00796B]-> RUNTIME
LLEV -[#D84315]-> RUNTIME
LLING -[#F9A825]-> RUNTIME
DUAL -[#1976D2]-> RUNTIME
RUNTIME -[#6A1B9A]-> SCOPED : exact runtime identity
SCOPED -[#AD1457]-> COMPAT : exact scoped facade

note right of INTEROP #E8F5E9
  Project workflows consume this owner.
  They never package or republish it.
end note

note right of RUNTIME #EDE7F6
  This is a sibling repository,
  never an embedded project package.
end note

note right of COMPAT #FCE4EC
  Both version-4 npm layers publish
  under the next dist-tag during RC.
end note

legend bottom
  |= Color |= Artifact role |
  |<#C8E6C9> green | shared ABI owner |
  |<#B2DFDB> teal | dictionary producer |
  |<#FFCCBC> orange | matching consumer |
  |<#FFF9C4> yellow | WFST toolkit |
  |<#BBDEFB> blue | bridge toolkit |
  |<#D1C4E9> purple | JavaScript runtime |
  |<#F8BBD0> pink | legacy-name compatibility |
endlegend
@enduml
