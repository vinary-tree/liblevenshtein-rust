χ -> x;

[id: 3289, name: "ψ to ps", weight: 0.15, group: greek_consonants]
ψ -> ps;

// ============================================================
// CONSONANTS (uppercase)
// ============================================================

[id: 3290, name: "Β to v", weight: 0.15, group: greek_consonants]
Β -> v;

[id: 3291, name: "Γ to g", weight: 0.15, group: greek_consonants, ipa: "/ɡ/"]
Γ -> ɡ;

