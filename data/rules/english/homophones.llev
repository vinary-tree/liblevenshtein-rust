// English Homophones
// Normalizes sound-alike words to canonical standard spellings for fuzzy matching

@version "1.0.0";

// ============================================================
// Letter-name homophones (spelled-out letter names -> letters)
// These normalize word forms to allow matching queries like "oh" to "o"
// ============================================================

[id: 300, name: "oh to o", weight: 0.0, group: letter_homophones]
oh -> o / #_#;

[id: 301, name: "aye to i", weight: 0.0, group: letter_homophones]
aye -> i / #_#;

// ============================================================
// Common homophones normalized to most frequent spelling
// ============================================================

// to/too/two family -> "to"
[id: 310, name: "too to to", weight: 0.0, group: homophones]
too -> to / #_#;

[id: 311, name: "two to to", weight: 0.0, group: homophones]
two -> to / #_#;

