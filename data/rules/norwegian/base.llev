// Norwegian Base Phonetic Rules
// ==============================
// Phonetic rules for Norwegian (norsk).
// North Germanic language spoken in Norway.
//
// Key features:
//   - Three extra vowels: æ (ae), ø (oe), å (o)
//   - KJ/SKJ: voiceless palatal fricative
//   - Silent letters: hv → v, hj → j
//   - Bokmål vs Nynorsk spelling differences handled uniformly
//
// Rule IDs: 3733-3799

@name "Norwegian Base Phonetic Rules"
@version "1.0.0"
@author "liblevenshtein"
@description "Phonetic normalization rules for Norwegian"

// ============================================================
// TRIGRAPHS (highest priority)
// ============================================================

// SKJ → ʃ (sj-sound, voiceless postalveolar fricative)
[id: 3733, name: "skj trigraph", weight: 0.02, group: norwegian_trigraphs, ipa: "/ʃ/"]
skj -> ʃ;

[id: 3734, name: "Skj trigraph", weight: 0.02, group: norwegian_trigraphs, ipa: "/ʃ/"]
Skj -> ʃ;

[id: 3735, name: "SKJ trigraph", weight: 0.02, group: norwegian_trigraphs, ipa: "/ʃ/"]
SKJ -> ʃ;

// ============================================================
// DIGRAPHS (high priority)
// ============================================================

// KJ → ç (voiceless palatal fricative, distinct from SJ)
[id: 3736, name: "kj digraph", weight: 0.05, group: norwegian_digraphs, ipa: "/ç/"]
kj -> ç;

[id: 3737, name: "Kj digraph", weight: 0.05, group: norwegian_digraphs, ipa: "/ç/"]
Kj -> ç;

[id: 3738, name: "KJ digraph", weight: 0.05, group: norwegian_digraphs, ipa: "/ç/"]
KJ -> ç;

// SJ → ʃ (sj-sound, voiceless postalveolar fricative)
[id: 3739, name: "sj digraph", weight: 0.05, group: norwegian_digraphs, ipa: "/ʃ/"]
sj -> ʃ;

[id: 3740, name: "Sj digraph", weight: 0.05, group: norwegian_digraphs, ipa: "/ʃ/"]
Sj -> ʃ;

[id: 3741, name: "SJ digraph", weight: 0.05, group: norwegian_digraphs, ipa: "/ʃ/"]
SJ -> ʃ;

// NG → ŋ (velar nasal)
[id: 3742, name: "ng digraph", weight: 0.05, group: norwegian_digraphs, ipa: "/ŋ/"]
ng -> ŋ;

[id: 3743, name: "NG digraph", weight: 0.05, group: norwegian_digraphs, ipa: "/ŋ/"]
NG -> ŋ;

// ============================================================
// SILENT CONSONANT CLUSTERS
// ============================================================

// HV → V (h is silent)
[id: 3744, name: "hv to v", weight: 0.05, group: norwegian_silent]
hv -> v;

[id: 3745, name: "Hv to v", weight: 0.05, group: norwegian_silent]
Hv -> v;

[id: 3746, name: "HV to V", weight: 0.05, group: norwegian_silent]
HV -> v;

// HJ → j (h is silent)
[id: 3747, name: "hj to j", weight: 0.05, group: norwegian_silent, ipa: "/j/"]
hj -> j;

[id: 3748, name: "Hj to j", weight: 0.05, group: norwegian_silent, ipa: "/j/"]
Hj -> j;

[id: 3749, name: "HJ to j", weight: 0.05, group: norwegian_silent, ipa: "/j/"]
HJ -> j;

// ============================================================
// SPECIAL VOWELS
// ============================================================

// Æ → æ (uppercase normalization only)
[id: 3751, name: "AE ligature", weight: 0.1, group: norwegian_vowels, ipa: "/æ/"]
Æ -> æ;

// Ø → ø (uppercase normalization only)
[id: 3753, name: "O slash", weight: 0.1, group: norwegian_vowels, ipa: "/ø/"]
Ø -> ø;

// Å/å → ɔ (rounded back vowel)
[id: 3754, name: "a ring to o", weight: 0.1, group: norwegian_vowels, ipa: "/ɔ/"]
å -> ɔ;

[id: 3755, name: "A ring to o", weight: 0.1, group: norwegian_vowels, ipa: "/ɔ/"]
Å -> ɔ;

// ============================================================
// STANDARD VOWELS
// ============================================================
// Note: Standard vowels (a, e, i, o, u, y) pass through unchanged.
// Identity mappings removed as they are no-ops - unmapped characters
// pass through the phonetic transformation unchanged.

// ============================================================
// CONSONANTS
// ============================================================

// C → k (foreign letter, pronounced as k)
[id: 3770, name: "c consonant", weight: 0.2, group: norwegian_consonants]
c -> k;

[id: 3771, name: "C consonant", weight: 0.2, group: norwegian_consonants]
C -> k;

// Q → k (foreign letter, pronounced as k)
[id: 3792, name: "q consonant", weight: 0.2, group: norwegian_consonants]
q -> k;

[id: 3793, name: "Q consonant", weight: 0.2, group: norwegian_consonants]
Q -> k;

// W → v (foreign letter, pronounced as v)
[id: 3802, name: "w consonant", weight: 0.2, group: norwegian_consonants]
w -> v;

[id: 3803, name: "W consonant", weight: 0.2, group: norwegian_consonants]
W -> v;

// X → ks (pronounced as k+s)
[id: 3804, name: "x consonant", weight: 0.2, group: norwegian_consonants]
x -> ks;

[id: 3805, name: "X consonant", weight: 0.2, group: norwegian_consonants]
X -> ks;

// Z → s (foreign letter, pronounced as s)
[id: 3806, name: "z consonant", weight: 0.2, group: norwegian_consonants]
z -> s;

[id: 3807, name: "Z consonant", weight: 0.2, group: norwegian_consonants]
Z -> s;

// Note: Other consonants (b, d, f, g, h, j, k, l, m, n, p, r, s, t, v) pass through unchanged.
// Identity mappings removed as they are no-ops - unmapped characters
// pass through the phonetic transformation unchanged.

