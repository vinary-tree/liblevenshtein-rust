@startuml backend-taxonomy
' The dictionary backends provided by libdictenstein and exposed through
' liblevenshtein. All implement the Dictionary trait; they split into an
' IN-MEMORY family and a DISK-PERSISTED (durable, non-volatile) family. Every
' Persistent* type is DYNAMIC (insert/remove) with a lock-free on-disk overlay —
' "persistent" = persisted to disk, NOT immutable. Each has a *Char UTF-8 variant.
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam class {
  BackgroundColor #E8F5E9
  BorderColor #2E7D32
  FontColor #102027
  AttributeFontColor #102027
}
skinparam ArrowColor #2E7D32

title Dictionary backend taxonomy (libdictenstein) — in-memory vs disk-persisted

interface "Dictionary  «trait»" as T #C8E6C9 {
  contains · prefix · edges
  build from terms; optional V values
}

package "In-memory" #E8F5E9 {
  class "DoubleArrayTrie(Char)" as DAT {
    u8 / u32 · **static** (read-only)
    wait-free · <latex>\mathcal{O}(1)</latex> transitions
    best: fast static dictionaries
  }
  class "DynamicDawg(Char / U64)" as DD {
    u8 / u32 / u64 · **dynamic**
    RwLock · SIMD + bloom
    (U64 lock-free via ArcSwap)
    best: general dynamic use
  }
  class "SuffixAutomaton(Char)" as SA {
    u8 / u32 · **dynamic** · RwLock
    best: substring / infix search
  }
  class "Scdawg(Char)" as SC {
    u8 / u32 · **dynamic** · RwLock
    bidirectional substring index
    best: backs WallBreaker
  }
  class "PathMapDictionary(Char)" as PM {
    **dynamic** · persistent
    (structural-sharing) map
    best: update-heavy workloads
  }
  class "BijectiveMap" as BIJ {
    **dynamic** · term ↔ integer id
    (both directions)
    best: id assignment & lookup
  }
}

package "Disk-persisted  (durable · dynamic · lock-free overlay / CAS)" #B2DFDB {
  class "PersistentARTrie(Char / U64)" as PART {
    prefix · mmap · disk-persisted
    Adaptive Radix Trie + B-trie buckets
    best: huge / durable prefix dictionaries
  }
  class "PersistentScdawg(Char)" as PSC {
    bidirectional substring · disk-persisted
  }
  class "PersistentSuffixAutomaton(Char)\nPersistentSuffixTree(Char)" as PSA {
    substring · disk-persisted
  }
  class "PersistentVocabARTrie" as PV {
    term ↔ id vocabulary · disk-persisted
  }
}

T <|-- DAT
T <|-- DD
T <|-- SA
T <|-- SC
T <|-- PM
T <|-- BIJ
T <|-- PART
T <|-- PSC
T <|-- PSA
T <|-- PV
@enduml
