// British English Phonetic Rules (Received Pronunciation)
// =========================================================
// Dialect-specific rules for British English (RP) phonetic transformations.
// These rules layer on top of the shared zompist base rules.
//
// Key British English (RP) Features:
//   - Non-rhotic: R dropped after vowels before consonants or word-end
//     Examples: car -> cah, farm -> fahm, bird -> bahd
//   - Broad 'a': Short 'a' becomes 'ah' in BATH words
//     Examples: bath -> bahth, class -> clahs, can't -> cahnt
//   - Preserved yod: Keep /j/ sound after alveolars (unlike American)
//     Examples: tune stays "tyoon", new stays "nyoo"

@name "British English Dialect Rules (Received Pronunciation)"
@version "2.0.0"
@author "liblevenshtein"
@description "Dialect-specific phonetic rules for British RP"

// Import the shared Zompist base rules
@include "english/zompist.llev"

// ============================================================
// Symbol Definitions
// ============================================================

@define VOWEL = [aeiou]
@define CONSONANT = [bcdfghjklmnpqrstvwxyz]

// ============================================================
// RP VOWEL PATTERNS (Dialect-Specific)
// ============================================================
// These rules were moved from zompist.llev because GA and RP
// have different vowel qualities for these patterns.

// GOAT vowel class - RP uses /əʊ/
[id: 400, name: "oa digraph RP", weight: 0.1, group: british_goat, ipa: "/əʊ/"]
// oa -> əʊ (boat -> bəʊt, road -> ɹəʊd)
oa -> əʊ;

[id: 401, name: "oe digraph RP", weight: 0.1, group: british_goat, ipa: "/əʊ/"]
// oe -> əʊ (toe -> təʊ, foe -> fəʊ)
oe -> əʊ;

// OUGH patterns - RP specific
[id: 410, name: "through pattern RP", weight: 0.0, group: british_ough, ipa: "/θɹuː/"]
// through -> θɹuː (rhymes with "threw")
through -> θɹuː / #_#;

[id: 411, name: "rough ending RP", weight: 0.0, group: british_ough, ipa: "/ʌf/"]
// rough -> ɹʌf, tough -> tʌf (STRUT vowel)
ough -> ʌf / [rt]_;

[id: 412, name: "enough pattern RP", weight: 0.0, group: british_ough, ipa: "/ɪnʌf/"]
// enough -> ɪnʌf
enough -> ɪnʌf / #_#;

[id: 413, name: "cough pattern RP", weight: 0.0, group: british_ough, ipa: "/kɒf/"]
// cough -> kɒf (LOT vowel in RP)
cough -> kɒf / #_#;

[id: 414, name: "ough pattern RP", weight: 0.0, group: british_ough, ipa: "/əʊ/"]
// ough -> əʊ (dough -> dəʊ, though -> ðəʊ) - GOAT vowel
ough -> əʊ;

[id: 415, name: "aught pattern RP", weight: 0.0, group: british_ough, ipa: "/ɔːt/"]
// aught -> ɔːt (caught -> kɔːt, daughter -> dɔːtə) - THOUGHT vowel
aught -> ɔːt;

[id: 416, name: "ought pattern RP", weight: 0.0, group: british_ough, ipa: "/ɔːt/"]
// ought -> ɔːt (bought -> bɔːt, thought -> θɔːt) - THOUGHT vowel
ought -> ɔːt;

// ============================================================
// NON-RHOTIC R-DROPPING RULES (British RP)
// ============================================================
// In British RP, /r/ is dropped after vowels when not followed
// by another vowel. This creates distinctive vowel qualities.

// AR patterns (car, far, star -> kɑː, fɑː, stɑː) - START vowel /ɑː/
[id: 600, name: "r-drop car", weight: 0.2, group: british_nonrhotic, ipa: "/kɑː/"]
car -> kɑː / _#;

[id: 601, name: "r-drop far", weight: 0.2, group: british_nonrhotic, ipa: "/fɑː/"]
