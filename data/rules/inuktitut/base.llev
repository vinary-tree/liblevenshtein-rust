[id: 8679, name: "syllabic ji", weight: 0.05, group: inuktitut_syllabics, ipa: "/ji/"]
ᔨ -> ji;

[id: 8680, name: "syllabic vi", weight: 0.05, group: inuktitut_syllabics, ipa: "/vi/"]
ᕕ -> vi;

[id: 8681, name: "syllabic ri", weight: 0.05, group: inuktitut_syllabics, ipa: "/ʁi/"]
