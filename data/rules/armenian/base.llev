[id: 4732, name: "piwr upper aspirated", weight: 0.05, group: armenian_aspirated, ipa: "/pʰ/"]
\u0553 -> pʰ;

[id: 4733, name: "piwr lower aspirated", weight: 0.05, group: armenian_aspirated, ipa: "/pʰ/"]
\u0583 -> pʰ;

[id: 4734, name: "ke upper aspirated", weight: 0.05, group: armenian_aspirated, ipa: "/kʰ/"]
\u0554 -> kʰ;

[id: 4735, name: "ke lower aspirated", weight: 0.05, group: armenian_aspirated, ipa: "/kʰ/"]
\u0584 -> kʰ;

// ============================================================
