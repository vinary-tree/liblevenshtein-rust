// grep-streaming-pipeline.dot — the streaming grep ingestion pipeline.
// A source byte stream is peeled layer by layer — transparent decompression,
// archive entry extraction, document text extraction, tokenisation — and each
// emitted token is fuzzy-matched (Levenshtein / phonetic) against the dictionary,
// streaming matches out. Nothing is fully buffered: layers pipe into one another.
// Color: source = query-input teal (#B2EBF2); the decompress/extract/tokenise
//   stages = intersection amber (#FFF3E0, with #FFE0B2 for the document stage as a
//   container shade); fuzzy match = phonetic pink (#F8BBD0); matches = dictionary
//   green (#C8E6C9). A red-bordered note flags the archive-hardening checks.
//   src/grep/source.rs · src/grep/{compression,archive,document}/
digraph grep_streaming_pipeline {
  rankdir=LR;
  graph [bgcolor=transparent, fontname="DejaVu Sans", fontsize=12, labelloc=t,
         label="Grep — streaming decompress → extract → fuzzy match"];
  node  [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=10,
         color="#455A64", fontcolor="#102027"];
  edge  [color="#37474F", fontname="DejaVu Sans", fontsize=9];

  source   [label="source: file / stdin", shape=oval, fillcolor="#B2EBF2", color="#00838F"];
  decomp   [label="decompress: gz / zst / xz / bz2", fillcolor="#FFF3E0", color="#EF6C00"];
  archive  [label="archive extract: tar / zip\n(entry-glob filter)", fillcolor="#FFF3E0", color="#EF6C00"];
  document [label="document extract: PDF / DOCX / XLSX\nEPUB / ODT / text", fillcolor="#FFE0B2", color="#EF6C00"];
  tokenise [label="tokenise", fillcolor="#FFF3E0", color="#EF6C00"];
  fuzzy    [label="per-token fuzzy match\n(Levenshtein / phonetic)", fillcolor="#F8BBD0", color="#AD1457"];
  matches  [label="matches", shape=oval, fillcolor="#C8E6C9", color="#2E7D32"];

  harden   [label="hardening: zip-slip path checks\n+ decompression-bomb limits",
            shape=note, fillcolor="#FFCDD2", color="#C62828", fontcolor="#102027", fontsize=9];

  source   -> decomp   -> archive -> document -> tokenise -> fuzzy -> matches;
  harden   -> archive  [style=dashed, color="#C62828", arrowhead=none];
}
