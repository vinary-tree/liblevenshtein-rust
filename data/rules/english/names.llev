acre -> eɪkɚ / #_#;

[id: 2947, name: "aker to acre phonetic", weight: 0.0, group: cmudict_name_homophones]
aker -> eɪkɚ / #_#;

[id: 2948, name: "achy to aikey phonetic", weight: 0.0, group: cmudict_name_homophones]
achy -> eɪki / #_#;

[id: 2949, name: "aikey to achy phonetic", weight: 0.0, group: cmudict_name_homophones]
aikey -> eɪki / #_#;

