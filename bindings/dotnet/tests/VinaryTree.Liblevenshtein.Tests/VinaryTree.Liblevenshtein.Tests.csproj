<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(VinaryTreeInteropRoot)/bindings/dotnet/src/VinaryTree.Interop/VinaryTree.Interop.csproj" />
    <ProjectReference Include="../../src/VinaryTree.Liblevenshtein/VinaryTree.Liblevenshtein.csproj" />
    <!-- C8 property tests build dictionaries with the libdictenstein sibling's
         DynamicDawg, which implements the same VinaryTree.Interop.IDictionaryResource
         this facade's Transducer consumes. -->
    <ProjectReference Include="$(LibdictensteinRoot)/bindings/dotnet/src/VinaryTree.Libdictenstein/VinaryTree.Libdictenstein.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CsCheck" Version="4.8.0" />
  </ItemGroup>
</Project>
