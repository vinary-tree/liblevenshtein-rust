@startuml position-set-state
' How a Levenshtein-automaton STATE is represented at run time.
' A state is a SET of positions ⟨i,e⟩ (i = chars of W consumed, e = edits used),
' kept minimal by subsumption, stored in a small inline vector, and recycled
' through a pool so steady-state querying performs no heap allocation.
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam class {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
  FontColor #102027
  AttributeFontColor #102027
}
skinparam ArrowColor #1565C0
skinparam ArrowThickness 2

title Automaton State = a subsumption-reduced set of positions <latex>\langle i,e\rangle</latex>

class "State" as S #BBDEFB {
  positions : SmallVec<Position>
  --
  insert(<latex>\langle i,e\rangle</latex>)  : drops subsumed positions
  is_accepting() : any <latex>\langle \vert W\vert, e\rangle</latex> with <latex>e \le k</latex>
}

class "Position  <latex>\langle i,e\rangle</latex>" as P {
  i : usize   ' chars of W consumed
  e : usize   ' edits used so far (<latex>e \le k</latex>)
}

class "StatePool" as Pool #E3F2FD {
  free : Vec<State>
  --
  acquire() -> State   ' reuse, no alloc
  release(State)
}

class "Subsumption  <latex>\le\chi</latex>" as Sub #E3F2FD {
  <latex>\langle i,e\rangle \le \langle i',e'\rangle</latex>  iff
  <latex>e \le e' \land \vert i - i'\vert \le e' - e</latex>
}

S "1" *-down- "1..*" P : holds
Pool -right-> S : acquires / recycles
Sub .up.> S : prunes dominated\npositions on insert

note bottom of P
  Only <latex>\mathcal{O}(\vert W\vert)</latex> distinct states arise for fixed k;
  each is computed lazily on first visit.
end note
@enduml
