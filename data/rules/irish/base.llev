[id: 4924, name: "O vowel", weight: 0.15, group: irish_vowels]
O -> o;

[id: 4925, name: "u vowel", weight: 0.15, group: irish_vowels]
u -> u;

[id: 4926, name: "U vowel", weight: 0.15, group: irish_vowels]
U -> u;

