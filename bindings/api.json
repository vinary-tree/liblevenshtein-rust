    },
    {
      "name": "llev_transducer_snapshot",
      "rustModule": "index"
    },
    {
      "name": "llev_transducer_free",
      "rustModule": "index"
    },
    {
      "name": "llev_transducer_unit_domain",
      "rustModule": "index"
    },
    {
      "name": "llev_transducer_query_utf8",
      "rustModule": "index"
    },
    {
      "name": "llev_transducer_query_bytes",
      "rustModule": "index"
    },
    {
      "name": "llev_transducer_query_u64",
      "rustModule": "index"
