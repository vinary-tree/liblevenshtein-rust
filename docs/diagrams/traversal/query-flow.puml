@startuml query-flow
' How an approximate query is answered: build one automaton from the query,
' then intersect it with the dictionary in a single traversal.
' Color legend:
'   teal   = query input          green = dictionary / accepted candidates
'   blue   = constructed automaton  orange = the intersection traversal
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam rectangle {
  RoundCorner 14
  BorderColor #455A64
  FontColor #102027
}
skinparam ArrowColor #37474F
skinparam ArrowThickness 2

title Query: find every dictionary term within edit distance k of W

rectangle "Query term  W\nmax edit distance  k" as W #B2EBF2
rectangle "Dictionary  D\nDAWG / trie / DAWG-of-suffixes" as D #C8E6C9

rectangle "Build Levenshtein automaton  A(W, k)\nrecognizes every string s with  d(W, s) <latex>\le</latex> k\nconstruction:  O(<latex>\vert W\vert</latex>)" as A #E3F2FD

rectangle "Simultaneous traversal   A(W, k)  <latex>\cap</latex>  D\none depth-first pass over shared edges\ntraversal:  O(<latex>\vert D\vert</latex>)" as I #FFE0B2

rectangle "Candidates\n{ (term, distance) : distance <latex>\le</latex> k }" as C #C8E6C9

W -[#00838F,thickness=2]down-> A
A -[#1565C0,thickness=2]down-> I
D -[#2E7D32,thickness=2]right-> I
I -[#EF6C00,thickness=2]down-> C
@enduml
