@startuml query-flow
' How an approximate query is answered: build one automaton from the query,
' then intersect it with the dictionary in a single traversal.
' Color legend:
'   teal   = query input          green = dictionary / accepted candidates
'   blue   = constructed automaton  orange = the intersection traversal
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam rectangle {
  RoundCorner 14
  BorderColor #455A64
  FontColor #102027
}
skinparam ArrowColor #37474F
skinparam ArrowThickness 2

title Query: find every dictionary term within edit distance k of W

rectangle "Query term  W\nmax edit distance  k" as W #B2EBF2
rectangle "Dictionary  D\nDAWG / trie / DAWG-of-suffixes" as D #C8E6C9

rectangle "Build Levenshtein automaton  <latex>A(W, k)</latex>\nrecognizes every string s with  <latex>d(W, s) \le k</latex>\nconstruction:  <latex>\mathcal{O}(\vert W\vert)</latex>" as A #E3F2FD

rectangle "Simultaneous traversal   <latex>A(W, k) \cap D</latex>\none depth-first pass over shared edges\ntraversal:  <latex>\mathcal{O}(\vert D\vert)</latex>" as I #FFE0B2

rectangle "Candidates\n<latex>\{ (\text{term}, \text{distance}) : \text{distance} \le k \}</latex>" as C #C8E6C9

W -[#00838F,thickness=2]down-> A
A -[#1565C0,thickness=2]down-> I
D -[#2E7D32,thickness=2]right-> I
I -[#EF6C00,thickness=2]down-> C
@enduml
