// ============================================================
// MARKER SIMPLIFICATION
// ============================================================

[id: 4430, name: "double retroflex flap", weight: 0.2, group: punjabi_simplification]
ɽɽ -> ɽ;

[id: 4431, name: "double retroflex lateral", weight: 0.2, group: punjabi_simplification]
ɭɭ -> ɭ;

[id: 4432, name: "double retroflex t", weight: 0.2, group: punjabi_simplification]
ʈʈ -> ʈ;

[id: 4433, name: "double retroflex d", weight: 0.2, group: punjabi_simplification]
ɖɖ -> ɖ;

[id: 4434, name: "double retroflex nasal", weight: 0.2, group: punjabi_simplification]
ɳɳ -> ɳ;

[id: 4435, name: "double palatal sh", weight: 0.2, group: punjabi_simplification]
ʃʃ -> ʃ;

[id: 4436, name: "double ai vowel", weight: 0.2, group: punjabi_simplification]
ɛːɛː -> ɛː;

[id: 4437, name: "double au vowel", weight: 0.2, group: punjabi_simplification]
ɔːɔː -> ɔː;

