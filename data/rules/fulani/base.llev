// Fulani (Fula/Pulaar/Fulfulde) Base Phonetic Rules
// ==================================================
// Phonetic rules for Fulani (Fulfulde / Pulaar / Fula).
// Spoken by approximately 20-40 million people across West and Central Africa.
//
// Fulani features:
//   - Niger-Congo language family (Atlantic branch)
//   - Implosive consonants: ɓ, ɗ, ʄ (bilabial, alveolar, palatal)
//   - Prenasalized stops: mb, nd, nj, ng
//   - Initial consonant gradation (mutation based on grammatical context)
//   - Long vowels (doubled in orthography)
//   - Palatal consonants: c, j, ny, ñ
//   - No tones (unlike many African languages)
//
// Orthography variants:
//   - Latin script (most common): ɓ, ɗ, ƴ, ɲ/ny, ŋ/ng
//   - Ajami (Arabic-based): used in religious contexts
//   - ADLaM script: modern indigenous alphabet
//
// Consonant Gradation (Grade Alternation):
//   - Continuant grade: f, s, h, w, y
//   - Stop grade: p, t, c, k
//   - Prenasalized grade: mb, nd, nj, ng
//   Example: wuro → furo → mburo (house, various grammatical forms)
//
// Rule IDs: 17650-17699

@name "Fulani Phonetic Rules"
@version "1.0.1"
@author "liblevenshtein"
@description "Phonetic normalization rules for Fulani (Fula/Pulaar/Fulfulde)"
// Changelog v1.0.1: Removed identity mappings - unmapped characters pass through unchanged

// ============================================================
// IMPLOSIVES (weight 0.02 - highly distinctive)
// ============================================================
// Fulani has three implosive consonants, crucial to the language
// Note: IPA implosive symbols (ɓ, ɗ, ʄ) pass through unchanged

// b' - bilabial implosive alternative representation
[id: 17651, name: "bilabial implosive alt", weight: 0.02, group: fulani_implosives, ipa: "/ɓ/"]
b' -> ɓ;

// d' - alveolar implosive alternative representation
[id: 17653, name: "alveolar implosive alt", weight: 0.02, group: fulani_implosives, ipa: "/ɗ/"]
d' -> ɗ;

// ƴ - palatal implosive (common orthographic representation)
[id: 17655, name: "palatal implosive hook", weight: 0.02, group: fulani_implosives, ipa: "/ʄ/"]
ƴ -> ʄ;

// y' - palatal implosive alternative representation
[id: 17656, name: "palatal implosive alt", weight: 0.02, group: fulani_implosives, ipa: "/ʄ/"]
y' -> ʄ;

// ============================================================
// PRENASALIZED STOPS (weight 0.03)
// ============================================================
// Prenasalized consonants are phonemic in Fulani
// Note: mb and nd pass through unchanged

[id: 17660, name: "prenasalized nj", weight: 0.03, group: fulani_prenasalized, ipa: "/ɲd͡ʒ/"]
nj -> ɲd͡ʒ;

[id: 17661, name: "prenasalized ng", weight: 0.03, group: fulani_prenasalized, ipa: "/ŋɡ/"]
ng -> ŋɡ;

[id: 17662, name: "prenasalized ng alt", weight: 0.03, group: fulani_prenasalized, ipa: "/ŋɡ/"]
ŋg -> ŋɡ;

// ============================================================
// PALATAL CONSONANTS (weight 0.05)
// ============================================================
// Note: IPA palatal nasal (ɲ) passes through unchanged

// c - voiceless palatal affricate (like English "ch")
[id: 17664, name: "c palatal affricate", weight: 0.05, group: fulani_palatals, ipa: "/t͡ʃ/"]
c -> t͡ʃ;

// j - voiced palatal affricate (like English "j")
[id: 17665, name: "j voiced palatal", weight: 0.05, group: fulani_palatals, ipa: "/d͡ʒ/"]
j -> d͡ʒ;

// ny - palatal nasal alternative
[id: 17667, name: "palatal nasal digraph", weight: 0.05, group: fulani_palatals, ipa: "/ɲ/"]
ny -> ɲ;

// ñ - palatal nasal (Spanish-style)
[id: 17668, name: "palatal nasal tilde", weight: 0.05, group: fulani_palatals, ipa: "/ɲ/"]
ñ -> ɲ;

// ============================================================
// VELAR AND GLOTTAL (weight 0.05)
// ============================================================
// Note: IPA velar nasal (ŋ) passes through unchanged

// Glottal stop (word-medial/final)
[id: 17671, name: "glottal stop", weight: 0.05, group: fulani_velars, ipa: "/ʔ/"]
' -> ʔ;

// ============================================================
// PLAIN STOPS (weight 0.05)
// ============================================================
// Note: p, t, k, b, d pass through unchanged

[id: 17678, name: "g voiced velar", weight: 0.05, group: fulani_stops, ipa: "/ɡ/"]
g -> ɡ;

// ============================================================
// FRICATIVES (weight 0.05)
// ============================================================
// Note: f, s, h pass through unchanged

// ============================================================
// NASALS (weight 0.05)
// ============================================================
// Note: m, n pass through unchanged

// ============================================================
// LIQUIDS AND APPROXIMANTS (weight 0.05)
// ============================================================
// Note: l, w pass through unchanged

[id: 17688, name: "r tap/flap", weight: 0.05, group: fulani_liquids, ipa: "/ɾ/"]
r -> ɾ;

[id: 17690, name: "y palatal approximant", weight: 0.05, group: fulani_approximants]
y -> j;

// ============================================================
// LONG VOWELS (weight 0.05)
// ============================================================
// Long vowels are phonemic and written as doubled letters

[id: 17692, name: "aa long", weight: 0.05, group: fulani_long_vowels, ipa: "/aː/"]
aa -> aː;

[id: 17693, name: "ee long", weight: 0.05, group: fulani_long_vowels, ipa: "/eː/"]
ee -> eː;

[id: 17694, name: "ii long", weight: 0.05, group: fulani_long_vowels, ipa: "/iː/"]
ii -> iː;

[id: 17695, name: "oo long", weight: 0.05, group: fulani_long_vowels, ipa: "/oː/"]
oo -> oː;

[id: 17696, name: "uu long", weight: 0.05, group: fulani_long_vowels, ipa: "/uː/"]
uu -> uː;

// ============================================================
// SIMPLIFICATIONS (weight 0.2)
// ============================================================
// For fuzzy matching, reduce geminates

[id: 17698, name: "double implosive b", weight: 0.2, group: fulani_simplification]
ɓɓ -> ɓ;

[id: 17699, name: "double implosive d", weight: 0.2, group: fulani_simplification]
ɗɗ -> ɗ;

