use Test;
use NativeCall;
use Liblevenshtein;

module Producer {
    use Libdictenstein;
    our sub dictionary() { dynamic-dawg() }
    our sub byte-dictionary() { dynamic-dawg(BYTE) }
    our sub token-dictionary() { dynamic-dawg(U64) }
}

is abi-version(), ABI-VERSION, 'ABI generation matches';
ok api-revision() >= API-REVISION, 'API revision is compatible';
ok build-features() +& BUILD-FEATURE-CORE, 'core feature is present';
isa-ok (OK), Status, 'status values retain their generated enum type';
isa-ok (STANDARD), Algorithm, 'algorithm values retain their generated enum type';
isa-ok (TRAVERSAL), QueryOrder, 'query-order values retain their generated enum type';
isa-ok (ENGLISH-ORTHOGRAPHY), PhoneticRuleSetKind,
    'phonetic rule-set values retain their generated enum type';
is nativesizeof(RawMatch), 48, 'match layout matches LP64 C';
is nativesizeof(RawBatch), 24, 'batch layout matches LP64 C';
is nativesizeof(RawQueryCacheStats), 64, 'query-cache stats layout matches LP64 C';
is nativesizeof(RawSpecializedQueryStats), 40,
    'specialized query stats layout matches LP64 C';
is nativesizeof(OwnedString), 16, 'owned string layout matches LP64 C';

is distance('kitten', 'sitting'), 3, 'standard distance';
ok !distance('kitten', 'sitting', :threshold(2)).defined,
    'threshold reports above-bound as Nil';
is distance('kitten', 'sitting', :threshold(3)), 3,
    'threshold reports an in-bound exact distance';
is damerau-distance('ab', 'ba'), 1, 'optimal-string-alignment distance';
is true-damerau-distance('CA', 'ABC'), 2,
    'unrestricted Damerau-Levenshtein distance';
is merge-and-split-distance('rn', 'm'), 1,
    'merge-and-split is a distinct direct distance family';
is hamming-distance('abc', 'bca'), 3,
    'Hamming counts mismatched Unicode scalar positions';
nok hamming-distance('é', 'ex').defined,
    'Hamming is undefined, not zero, for unequal scalar counts';
is indel-distance('a', 'b'), 2,
    'indel replacement costs deletion plus insertion';
my $affine = AffineGapCosts.new(
    gap-open => 3, gap-extend => 2, substitution => 10,
);
is affine-gap-distance('a', 'abcd', $affine), 9,
    'affine gap opening is paid once per run';
nok affine-gap-distance('a', 'abcd', $affine, :threshold(8)).defined,
    'affine threshold excludes an exact distance above the bound';
is affine-gap-distance('a', 'abcd', $affine, :threshold(9)), 9,
    'affine threshold retains the exact boundary';

my $binary-left = Buf.new(0xff, 0x00);
my $binary-right = Buf.new(0x00, 0x00);
is distance($binary-left, $binary-right), 1,
    'arbitrary bytes are compared without UTF-8 decoding';
is hamming-distance($binary-left, $binary-right), 1,
    'Hamming byte overload preserves non-UTF-8 data';
is indel-distance($binary-left, $binary-right), 2,
    'indel byte overload does not substitute';
is affine-gap-distance($binary-left, $binary-right, $affine), 10,
    'affine byte overload uses native bytes and configured costs';
is distance([0, 2**64 - 1], [0, 2**64 - 2]), 1,
    'u64 overload preserves the full unsigned token range';
is hamming-distance([0, 2**64 - 1], [0, 2**64 - 2]), 1,
    'Hamming u64 overload preserves full-width inequality';
is indel-distance([0, 2**64 - 1], [0, 2**64 - 2]), 2,
    'indel u64 overload does not substitute';
dies-ok { distance([2**64], [0]) },
    'out-of-range u64 tokens are rejected before native conversion';
dies-ok { distance(Buf.new(0xff), 'a') },
    'mixed byte and Unicode domains are not silently coerced';
dies-ok {
    affine-gap-distance('a', 'b', AffineGapCosts.new(
        gap-open => 2**128, gap-extend => 1, substitution => 1,
    ))
}, 'unrepresentable affine cost is rejected before native conversion';
dies-ok { indel-distance('a', 'b', :threshold(-1)) },
    'negative thresholds are rejected before native conversion';

for ^8 {
    is distance('', ''), 0, 'repeated empty text arguments remain valid';
    is distance('', 'A'), 1, 'nonempty text following empty arguments remains valid';
    is distance(Buf.new(), Buf.new(0)), 1,
        'nonempty byte argument following empty arguments remains valid';
    is distance([], [0]), 1,
        'nonempty u64 argument following empty arguments remains valid';
}

# Metamorphic differential check: ASCII symbols, byte values, and u64 tokens
# represent the same equality pattern, so every native domain dispatcher must
# return the same semantic distance and inclusive threshold result.
my @sequences = ([], [0], [1], [0, 1], [1, 0], [0, 2, 1]);
for @sequences -> $left {
    for @sequences -> $right {
        my $text-left = $left.map({ chr(65 + $_) }).join;
        my $text-right = $right.map({ chr(65 + $_) }).join;
        my $bytes-left = Buf.new($left.list);
        my $bytes-right = Buf.new($right.list);
        for &distance, &damerau-distance, &true-damerau-distance,
            &merge-and-split-distance, &hamming-distance, &indel-distance
            -> &family {
            my $text = family($text-left, $text-right);
            if $text.defined {
                is family($bytes-left, $bytes-right), $text,
                    'byte dispatcher agrees with Unicode scalar oracle';
                is family($left, $right), $text,
                    'u64 dispatcher agrees with Unicode scalar oracle';
                is family($left, $right, :threshold($text)), $text,
                    'inclusive u64 threshold retains the exact boundary';
                if $text > 0 {
                    nok family($bytes-left, $bytes-right,
                        :threshold($text - 1)).defined,
                        'byte threshold excludes the next smaller bound';
                }
            } else {
                nok family($bytes-left, $bytes-right).defined,
                    'byte dispatcher preserves an undefined Unicode score';
                nok family($left, $right).defined,
                    'u64 dispatcher preserves an undefined Unicode score';
            }
        }
        my $text-affine = affine-gap-distance($text-left, $text-right, $affine);
        is affine-gap-distance($bytes-left, $bytes-right, $affine), $text-affine,
            'affine byte dispatcher agrees with Unicode scalar oracle';
        is affine-gap-distance($left, $right, $affine), $text-affine,
            'affine u64 dispatcher agrees with Unicode scalar oracle';
    }
}

# Standalone automata are independent of dictionary resources. This is the
# canonical short executable example; the exhaustive differential/limit suite
# lives in 02-standalone-automata.rakutest.
my $generalized-example = GeneralizedAutomaton.new(0, [
    GeneralizedOperation.new(
        consume-source => 1, consume-target => 1, weight => 0,
        name => 'equal', applicability => APPLICABILITY-EQUAL,
    ),
]);
ok $generalized-example.evaluate('é', 'é').accepting,
    'generalized complete-pair evaluation uses native Unicode scalars';
my $generalized-online-example = $generalized-example.online('é');
ok $generalized-online-example.advance('é').accepting,
    'generalized online state advances one Unicode scalar';
ok $generalized-online-example.observation.accepting,
    'generalized online observation is stable without advancing';
$generalized-online-example.close;
$generalized-example.close;

my $universal-example = UniversalAutomaton.new(
    1, variant => UNIVERSAL-TRANSPOSITION,
);
ok $universal-example.evaluate('ab', 'ba').accepting,
    'universal transposition variant evaluates a complete pair';
my $universal-online-example = $universal-example.online('ab');
$universal-online-example.advance('b');
ok $universal-online-example.advance('a').accepting,
    'universal online state preserves the variant';
ok $universal-online-example.observation.accepting,
    'universal online observation is stable without advancing';
$universal-online-example.close;
$universal-example.close;

my $dictionary = Producer::dictionary();
$dictionary<cat> = 7;
$dictionary<cot> = Nil;
$dictionary<dog> = 9;
$dictionary<ba> = 10;
$dictionary<m> = 11;
$dictionary<ABC> = 12;
my $provider = $dictionary.snapshot;
my $transducer = Transducer.new(:dictionary($provider));
for ^3 {
    is $transducer.query('', 1).map(*.term).List.elems, 1,
        'empty Unicode query remains valid after repeated NativeCall';
    is $transducer.query('cut', 1).map(*.term).List.elems, 2,
        'nonempty Unicode query remains valid after an empty query';
}
throws-like { $transducer.query('cut', -1) }, X::AdHoc,
    'transducer rejects negative maximum distance before native conversion';
is $transducer.unit-domain, (UNICODE-SCALAR),
    'the transducer reports its provider unit domain';
my @matches = $transducer.query(
    'cut', 1, order => DISTANCE-THEN-TERM,
).list;
is-deeply @matches.map({ [.term, .distance] }).Array,
    [['cat', 1], ['cot', 1]],
    'resource-backed Unicode query is ordered and materialized';
is @matches[0].id, 7, 'present dictionary ID is preserved';
ok !@matches[1].id.defined, 'absent dictionary ID remains undefined';

is-deeply $transducer.query-ranked('cut', 1).map(*.term).Array,
    ['cat', 'cot'], 'ranked traversal streams native distance-then-term order';
is-deeply $transducer.query-mode('cut',
    minimum-distance => 1, maximum-distance => 1).map(*.term).Array,
    ['cat', 'cot'], 'inclusive exact-distance mode retains both candidates';
is $transducer.query-mode('cut', maximum-distance => 0).list.elems, 0,
    'exact mode excludes above-bound terms in the native automaton';
throws-like {
    $transducer.query-mode('cut',
        minimum-distance => 2, maximum-distance => 1)
}, X::AdHoc, 'unordered distance interval fails before native traversal';
my $scored = $transducer.query-suggestions('cut', 1,
    -> $term, $distance, $id { $term eq 'cot' ?? 10e0 !! 0e0 });
is-deeply $scored.map(*.term).Array, ['cot', 'cat'],
    'host scorer sorts only within one native distance layer';
my $early-ranked = $transducer.query-mode('cut', maximum-distance => 1);
is $early-ranked.next-batch(1).elems, 1,
    'ranked mode returns bounded owned batches';
$early-ranked.close;
nok $early-ranked.opened, 'early close releases ranked native cursor';
my $bad-scorer = $transducer.query-suggestions('cut', 1,
    -> $term, $distance, $id { die 'host scorer failed' });
dies-ok { $bad-scorer.next-batch(1) },
    'host scorer exception stays in Raku';
nok $bad-scorer.opened, 'host scorer failure closes the native cursor';
my @filtered = $transducer.query-filtered('cut', 1,
    -> $id { !$id.defined }).map(*.term).Array;
is-deeply @filtered, ['cot'],
    'native value filter rejects a final node before term materialization';
my $bad-filter = $transducer.query-filtered('cut', 1,
    -> $id { die 'filter failed' });
dies-ok { $bad-filter.next-batch(1) },
    'NativeCall callback exceptions are contained and rethrown in Raku';
nok $bad-filter.opened, 'callback failure closes the native cursor';
my $uniform-costs = ContextualCosts.new(
    substitution => -> $context, $query, $dictionary {
        $query eq $dictionary ?? 0e0 !! 1e0
    },
    insertion => -> $context, $dictionary { 1e0 },
    deletion => -> $context, $query { 1e0 },
    minimum-nonzero-cost => 1e0,
);
is-deeply $transducer.query-contextual('cut', 1e0, $uniform-costs)
    .map(*.term).Array.sort.Array, ['cat', 'cot'],
    'contextual NativeCall costs recover exact unit-cost Rust traversal';
is $transducer.query-contextual('cut', 1e0, $uniform-costs)
    .reduce-batches(-> $count, $batch { $count + $batch.elems },
        0, batch-size => 1), 2,
    'specialized cursor reduces bounded pages and closes';
my $bad-contextual = $transducer.query-contextual('cut', 1e0,
    ContextualCosts.new(
        substitution => -> $context, $query, $dictionary {
            die 'contextual cost failed'
        },
        insertion => -> $context, $dictionary { 1e0 },
        deletion => -> $context, $query { 1e0 },
        minimum-nonzero-cost => 1e0,
    ));
dies-ok { $bad-contextual.next-batch(1) },
    'contextual callback failure is rethrown after returning from native code';
nok $bad-contextual.opened, 'contextual callback failure closes its cursor';
for <cat cut dog é> -> $query {
    for 0..2 -> $limit {
        my @native = $transducer.query($query, $limit)
            .map({ [.term, .distance] }).Array.sort({ $^a[0] cmp $^b[0] });
        my @contextual = $transducer.query-contextual(
            $query, $limit.Num, $uniform-costs,
        ).map({ [.term, .cost.Int] }).Array.sort({ $^a[0] cmp $^b[0] });
        my @pruned = $transducer.query-pruned($query, $limit,
            PrefixVisitor.new(
                enter => -> $unit, $depth { True },
                leave => -> $unit, $depth { },
            ),
        ).map({ [.term, .cost.Int] }).Array.sort({ $^a[0] cmp $^b[0] });
        is-deeply @contextual, @native,
            'uniform contextual callback agrees with native Rust query';
        is-deeply @pruned, @native,
            'unpruned prefix visitor agrees with native Rust query';
    }
}
my @entered;
my @left;
my $visitor = PrefixVisitor.new(
    enter => -> $unit, $depth { @entered.push([$unit, $depth]); True },
    leave => -> $unit, $depth { @left.push([$unit, $depth]) },
    permits => -> $prefix { $prefix ne 'cat' },
    score => -> $prefix { $prefix.chars.Num },
);
my $prefix-cursor = $transducer.query-pruned('cut', 1, $visitor);
my @prefix-matches = $prefix-cursor.list;
is-deeply @prefix-matches.map(*.term).Array, ['cot'],
    'prefix visitor rejects cat while retaining cot';
is @prefix-matches[0].score, 3e0,
    'prefix score is copied from the synchronous callback';
is @entered.elems, @left.elems,
    'native DFS balances enter and leave on exhaustion';
my $early-prefix = $transducer.query-pruned('cut', 1,
    PrefixVisitor.new(
        enter => -> $unit, $depth { @entered.push([$unit, $depth]); True },
        leave => -> $unit, $depth { @left.push([$unit, $depth]) },
    ));
$early-prefix.next-batch(1);
ok $early-prefix.stats.nodes-visited > 0,
    'prefix query exposes exact native traversal counters';
$early-prefix.close;
is @entered.elems, @left.elems,
    'early close unwinds every entered native prefix';
my $bad-prefix = $transducer.query-pruned('cut', 1,
    PrefixVisitor.new(
        enter => -> $unit, $depth { die 'prefix failed' },
        leave => -> $unit, $depth { },
    ));
dies-ok { $bad-prefix.next-batch(1) },
    'prefix callback failure is rethrown after returning from native code';
nok $bad-prefix.opened, 'prefix callback failure closes its cursor';

my $batch-cursor = $transducer.query('cut', 1);
isa-ok $batch-cursor, QueryCursor, 'queries return the public iterator type';
is $batch-cursor.next-batch(1).elems, 1,
    'next-batch materializes one bounded native batch';
$batch-cursor.close;

my $cache = QueryCache.new(:$transducer, max-entries => 8, max-weight => 2**20);
my @cold = $cache.query('cut', 1).map(*.term).List;
my @hit = $cache.query('cut', 1).map(*.term).List;
is-deeply @hit, @cold, 'resident query results remain exact';
is-deeply [$cache.stats.requests, $cache.stats.hits, $cache.stats.misses],
    [2, 1, 1], 'TinyLFU/SIEVE cache distinguishes cold and resident requests';
is $cache.elems, 1, 'cache exposes resident entries through elems';
ok $cache.stats.resident-weight > 0, 'cache reports bounded logical weight';
$cache.reset-stats;
is $cache.stats.requests, 0, 'counter reset preserves a live cache';
is $cache.elems, 1, 'counter reset does not clear residency';
$cache.clear;
is $cache.elems, 0, 'clear drops resident results';
is $cache.query('', 1).map(*.term).List.elems, 1,
    'cache accepts an empty Unicode query through owned bytes';
is $cache.query('cut', 1).map(*.term).List.elems, 2,
    'cache accepts a nonempty Unicode query after an empty query';
throws-like { $cache.query('cut', -1) }, X::AdHoc,
    'negative maximum distance is rejected before native conversion';
$cache.close;
nok $cache.opened, 'query cache closes deterministically';

sub query-terms(Algorithm:D $algorithm, Str:D $input, Int:D $maximum --> List:D) {
    my $variant = Transducer.new(:dictionary($provider), :$algorithm);
    LEAVE $variant.close;
    $variant.query($input, $maximum).map(*.term).List
}
nok query-terms(STANDARD, 'ab', 1).grep(* eq 'ba'),
    'standard Levenshtein excludes one-edit transposition';
ok query-terms(TRANSPOSITION, 'ab', 1).grep(* eq 'ba'),
    'optimal string alignment admits an adjacent transposition';
ok query-terms(MERGE-AND-SPLIT, 'rn', 1).grep(* eq 'm'),
    'merge-and-split admits one two-to-one edit';
ok query-terms(DAMERAU-LEVENSHTEIN, 'CA', 2).grep(* eq 'ABC'),
    'unrestricted Damerau-Levenshtein composes edits through history';
nok query-terms(TRANSPOSITION, 'CA', 2).grep(* eq 'ABC'),
    'optimal string alignment remains distinct from unrestricted Damerau';
if build-features() +& BUILD-FEATURE-PHONETIC {
    my $language = PhoneticPattern.new(regex => 'cat');
    is-deeply $transducer.query($language, 0).map(*.term).Array,
        ['cat'], 'typed language-product query uses native traversal';
    $language.close;
}

my $fixed = $transducer.snapshot;
$transducer.close;
is $fixed.query('cut', 1).reduce-batches(
    -> $count, $batch { $count + $batch.elems }, 0, batch-size => 1,
), 2, 'bounded reduction consumes a captured snapshot';
$fixed.close;
$provider.close;
$dictionary.close;

my $byte-dictionary = Producer::byte-dictionary();
$byte-dictionary.ASSIGN-KEY(Buf.new(0), 1);
my $byte-provider = $byte-dictionary.snapshot;
my $byte-transducer = Transducer.new(:dictionary($byte-provider));
is $byte-transducer.query(Buf.new(), 1).list.elems, 1,
    'empty byte query crosses the stable owned-buffer boundary';
is $byte-transducer.query(Buf.new(0), 1).list.elems, 1,
    'nonempty byte query follows an empty byte query';
$byte-transducer.close;
$byte-provider.close;
$byte-dictionary.close;

my $token-dictionary = Producer::token-dictionary();
$token-dictionary.ASSIGN-KEY([0], 1);
my $token-provider = $token-dictionary.snapshot;
my $token-transducer = Transducer.new(:dictionary($token-provider));
is $token-transducer.query([], 1).list.elems, 1,
    'empty u64 query uses a nonzero backing allocation';
is $token-transducer.query([0], 1).list.elems, 1,
    'nonempty u64 query follows an empty u64 query';
$token-transducer.close;
$token-provider.close;
$token-dictionary.close;

if build-features() +& (BUILD-FEATURE-PHONETIC) {
    my $pattern = PhoneticPattern.new(regex => 'cat');
    ok $pattern.accepts('cat'), 'phonetic regex accepts a member';
    nok $pattern.accepts('cot'), 'phonetic regex rejects a non-member';
    ok $pattern.size.grep(* <= 0).elems == 0,
        'pattern exposes structural size';
    $pattern.close;

    my $rules = PhoneticRuleSet.new(builtin => ENGLISH-ORTHOGRAPHY);
    ok $rules.elems > 0, 'built-in rule set has rules';
    isa-ok $rules.apply('KNIGHT'), Str, 'rule application returns text';
    $rules.close;
}

done-testing;
