// Oromo Base Phonetic Rules
// =========================
// Phonetic rules for Oromo (Afaan Oromoo).
// Spoken by approximately 45 million people in Ethiopia and Kenya,
// making it the most spoken Cushitic language.
//
// Oromo features:
//   - Afroasiatic language family (Cushitic branch)
//   - Latin script (Qubee alphabet)
//   - Glottal stop is phonemic
//   - Long vowels marked with double letters
//   - Pharyngeal consonants
//   - Ejective consonants
//   - ATR vowel distinction
//
// Orthography:
//   - aa, ee, ii, oo, uu for long vowels
//   - dh for retroflex /ɖ/
//   - ph for /pʰ/ or /f/
//   - x for /tʼ/
//   - q for /kʼ/
//   - ' for glottal stop
//
// Rule IDs: 12900-12999

@name "Oromo Phonetic Rules"
@version "1.0.0"
@author "liblevenshtein"
@description "Phonetic normalization rules for Oromo"

// ============================================================
// SHORT VOWELS (weight 0.05)
// ============================================================

[id: 12900, name: "a short", weight: 0.05, group: oromo_vowels, ipa: "/a/"]
a -> a;

[id: 12901, name: "e short", weight: 0.05, group: oromo_vowels, ipa: "/e/"]
e -> e;

[id: 12902, name: "i short", weight: 0.05, group: oromo_vowels, ipa: "/i/"]
i -> i;

[id: 12903, name: "o short", weight: 0.05, group: oromo_vowels, ipa: "/o/"]
o -> o;

[id: 12904, name: "u short", weight: 0.05, group: oromo_vowels, ipa: "/u/"]
u -> u;

// ============================================================
// LONG VOWELS (weight 0.05)
// ============================================================

[id: 12908, name: "aa long", weight: 0.05, group: oromo_long, ipa: "/aː/"]
aa -> aː;

[id: 12909, name: "ee long", weight: 0.05, group: oromo_long, ipa: "/eː/"]
ee -> eː;

[id: 12910, name: "ii long", weight: 0.05, group: oromo_long, ipa: "/iː/"]
ii -> iː;

[id: 12911, name: "oo long", weight: 0.05, group: oromo_long, ipa: "/oː/"]
oo -> oː;

[id: 12912, name: "uu long", weight: 0.05, group: oromo_long, ipa: "/uː/"]
uu -> uː;

// ============================================================
// EJECTIVE CONSONANTS (weight 0.05)
// ============================================================

[id: 12916, name: "x ejective t", weight: 0.05, group: oromo_ejective, ipa: "/tʼ/"]
x -> tʼ;

[id: 12917, name: "q ejective k", weight: 0.05, group: oromo_ejective, ipa: "/kʼ/"]
q -> kʼ;

[id: 12918, name: "c ejective affricate", weight: 0.05, group: oromo_ejective, ipa: "/t͡ʃʼ/"]
c -> t͡ʃʼ;

[id: 12919, name: "ph ejective p", weight: 0.05, group: oromo_ejective, ipa: "/pʼ/"]
ph -> pʼ;

// ============================================================
// STOPS (weight 0.05)
// ============================================================

[id: 12922, name: "p", weight: 0.05, group: oromo_stops, ipa: "/p/"]
p -> p;

[id: 12923, name: "b", weight: 0.05, group: oromo_stops, ipa: "/b/"]
b -> b;

[id: 12924, name: "t", weight: 0.05, group: oromo_stops, ipa: "/t/"]
t -> t;

[id: 12925, name: "d", weight: 0.05, group: oromo_stops, ipa: "/d/"]
d -> d;

[id: 12926, name: "k", weight: 0.05, group: oromo_stops, ipa: "/k/"]
k -> k;

[id: 12927, name: "g", weight: 0.05, group: oromo_stops, ipa: "/ɡ/"]
g -> ɡ;

[id: 12928, name: "glottal stop", weight: 0.05, group: oromo_stops, ipa: "/ʔ/"]
' -> ʔ;

// ============================================================
// RETROFLEX (weight 0.05)
// ============================================================

[id: 12931, name: "dh retroflex", weight: 0.05, group: oromo_retroflex, ipa: "/ɖ/"]
dh -> ɖ;

// ============================================================
// AFFRICATES (weight 0.05)
// ============================================================

[id: 12934, name: "ch voiceless", weight: 0.05, group: oromo_affricates, ipa: "/t͡ʃ/"]
ch -> t͡ʃ;

[id: 12935, name: "j voiced", weight: 0.05, group: oromo_affricates, ipa: "/d͡ʒ/"]
j -> d͡ʒ;

// ============================================================
// FRICATIVES (weight 0.05)
// ============================================================

[id: 12938, name: "f", weight: 0.05, group: oromo_fricatives, ipa: "/f/"]
f -> f;

[id: 12939, name: "s", weight: 0.05, group: oromo_fricatives, ipa: "/s/"]
s -> s;

[id: 12940, name: "z loanword", weight: 0.05, group: oromo_fricatives, ipa: "/z/"]
z -> z;

[id: 12941, name: "sh postalveolar", weight: 0.05, group: oromo_fricatives, ipa: "/ʃ/"]
sh -> ʃ;

[id: 12942, name: "h", weight: 0.05, group: oromo_fricatives, ipa: "/h/"]
h -> h;

// ============================================================
// NASALS (weight 0.05)
// ============================================================

[id: 12946, name: "m", weight: 0.05, group: oromo_nasals, ipa: "/m/"]
m -> m;

[id: 12947, name: "n", weight: 0.05, group: oromo_nasals, ipa: "/n/"]
n -> n;

[id: 12948, name: "ny palatal nasal", weight: 0.05, group: oromo_nasals, ipa: "/ɲ/"]
ny -> ɲ;

// ============================================================
// LIQUIDS AND APPROXIMANTS (weight 0.05)
// ============================================================

[id: 12952, name: "l", weight: 0.05, group: oromo_liquids, ipa: "/l/"]
l -> l;

[id: 12953, name: "r", weight: 0.05, group: oromo_liquids, ipa: "/r/"]
r -> r;

[id: 12954, name: "w", weight: 0.05, group: oromo_approximants, ipa: "/w/"]
w -> w;

[id: 12955, name: "y", weight: 0.05, group: oromo_approximants, ipa: "/j/"]
y -> j;

// ============================================================
// GEMINATION (weight 0.05)
// ============================================================

[id: 12958, name: "bb geminate", weight: 0.05, group: oromo_geminate, ipa: "/bː/"]
bb -> bː;

[id: 12959, name: "dd geminate", weight: 0.05, group: oromo_geminate, ipa: "/dː/"]
dd -> dː;

[id: 12960, name: "ff geminate", weight: 0.05, group: oromo_geminate, ipa: "/fː/"]
ff -> fː;

[id: 12961, name: "gg geminate", weight: 0.05, group: oromo_geminate, ipa: "/ɡː/"]
gg -> ɡː;

[id: 12962, name: "kk geminate", weight: 0.05, group: oromo_geminate, ipa: "/kː/"]
kk -> kː;

[id: 12963, name: "ll geminate", weight: 0.05, group: oromo_geminate, ipa: "/lː/"]
ll -> lː;

[id: 12964, name: "mm geminate", weight: 0.05, group: oromo_geminate, ipa: "/mː/"]
mm -> mː;

[id: 12965, name: "nn geminate", weight: 0.05, group: oromo_geminate, ipa: "/nː/"]
nn -> nː;

[id: 12966, name: "ss geminate", weight: 0.05, group: oromo_geminate, ipa: "/sː/"]
ss -> sː;

[id: 12967, name: "tt geminate", weight: 0.05, group: oromo_geminate, ipa: "/tː/"]
tt -> tː;

// ============================================================
// COMMON WORDS (weight 0.02)
// ============================================================

[id: 12980, name: "oromoo oromo", weight: 0.02, group: oromo_common]
oromoo -> oromoː;

[id: 12981, name: "akkam hello how are you", weight: 0.02, group: oromo_common]
akkam -> akːam;

[id: 12982, name: "galatoomaa thank you", weight: 0.02, group: oromo_common]
galatoomaa -> ɡalatoːmaː;

[id: 12983, name: "eeyee yes", weight: 0.02, group: oromo_common]
eeyee -> eːjeː;

[id: 12984, name: "lakki no", weight: 0.02, group: oromo_common]
lakki -> lakːi;

[id: 12985, name: "bishaanii water", weight: 0.02, group: oromo_common]
bishaanii -> biʃaniː;

[id: 12986, name: "buddeenaa bread food", weight: 0.02, group: oromo_common]
buddeenaa -> budːeːnaː;

[id: 12987, name: "mana house", weight: 0.02, group: oromo_common]
mana -> mana;

[id: 12988, name: "nama person", weight: 0.02, group: oromo_common]
