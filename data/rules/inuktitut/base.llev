[id: 8693, name: "syllabic ku", weight: 0.05, group: inuktitut_syllabics, ipa: "/ku/"]
ᑯ -> ku;

[id: 8694, name: "syllabic gu", weight: 0.05, group: inuktitut_syllabics, ipa: "/ɡu/"]
