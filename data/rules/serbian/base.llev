// ============================================================

[id: 3434, name: "б to b", weight: 0.2, group: serbian_consonants]
б -> b;

[id: 3435, name: "Б to b", weight: 0.2, group: serbian_consonants]
Б -> b;

[id: 3436, name: "в to v", weight: 0.2, group: serbian_consonants]
в -> v;

