cabal-version: 3.6
name: vinary-tree-liblevenshtein
version: 4.0.0
x-release-candidate: rc.2
synopsis: Fast streaming Levenshtein automata for Haskell
description: Snapshot-consistent, bounded-batch bindings to liblevenshtein.
category: Text
license: Apache-2.0
license-file: LICENSE
author: Dylon Edwards
maintainer: dylon.devo@gmail.com
build-type: Simple

flag strict
  description: Treat compiler warnings as errors during development and CI.
  default: False
  manual: True

library
  exposed-modules: VinaryTree.Liblevenshtein
  hs-source-dirs: src
  pkgconfig-depends: liblevenshtein
  default-language: GHC2021
  ghc-options: -Wall -Wcompat
  if flag(strict)
    ghc-options: -Werror
  build-depends:
    base >=4.18 && <5,
    bytestring >=0.11 && <0.13,
    text >=2.0 && <2.2,
    vinary-tree-interop >=4 && <5

test-suite snapshot
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  default-language: GHC2021
  ghc-options: -Wall -Wcompat -threaded
  if flag(strict)
    ghc-options: -Werror
  build-depends:
    base,
    bytestring,
    directory,
    filepath,
    text,
    vinary-tree-interop,
    vinary-tree-libdictenstein,
    vinary-tree-liblevenshtein

-- C8 property-based tests (QuickCheck) against an in-language oracle.
test-suite property
  type: exitcode-stdio-1.0
  main-is: PropertyMain.hs
  hs-source-dirs: test
  default-language: GHC2021
  ghc-options: -Wall -Wcompat -threaded
  if flag(strict)
    ghc-options: -Werror
  build-depends:
    base,
    QuickCheck,
    text,
    vinary-tree-interop,
    vinary-tree-libdictenstein,
    vinary-tree-liblevenshtein

-- C9 leak-discipline tests (performGC + weak pointers).
test-suite leak
  type: exitcode-stdio-1.0
  main-is: LeakMain.hs
  hs-source-dirs: test
  default-language: GHC2021
  ghc-options: -Wall -Wcompat -threaded
  if flag(strict)
    ghc-options: -Werror
  build-depends:
    base,
    text,
    vinary-tree-interop,
    vinary-tree-libdictenstein,
    vinary-tree-liblevenshtein
