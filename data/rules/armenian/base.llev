// ============================================================
// MARKER SIMPLIFICATION
// Simplify IPA markers for fuzzy matching
// Affricates at 0.15 (must fire before single letters at 0.2)
// ============================================================

// Affricate simplifications (weight 0.15 - fire first)
[id: 4803, name: "simplify aspirated ts affricate", weight: 0.15, group: armenian_simplification]
t͡sʰ -> t͡s;

[id: 4804, name: "simplify dz affricate", weight: 0.15, group: armenian_simplification]
d͡zd͡z -> d͡z;

[id: 4805, name: "simplify aspirated ch affricate", weight: 0.15, group: armenian_simplification]
t͡ʃʰ -> t͡ʃ;

[id: 4806, name: "double sh", weight: 0.15, group: armenian_simplification]
ʃʃ -> ʃ;

[id: 4807, name: "double zh", weight: 0.15, group: armenian_simplification]
ʒʒ -> ʒ;

[id: 4808, name: "double gh", weight: 0.15, group: armenian_simplification]
ɣɣ -> ɣ;

[id: 4809, name: "double ch affricate", weight: 0.15, group: armenian_simplification]
t͡ʃt͡ʃ -> t͡ʃ;

[id: 4810, name: "double ts affricate", weight: 0.15, group: armenian_simplification]
t͡st͡s -> t͡s;

[id: 4811, name: "double dzh affricate", weight: 0.15, group: armenian_simplification]
d͡ʒd͡ʒ -> d͡ʒ;

// Aspirated simplifications (weight 0.2 - fire after affricates)
[id: 4812, name: "simplify aspirated t", weight: 0.2, group: armenian_simplification]
tʰ -> t;

[id: 4813, name: "simplify aspirated p", weight: 0.2, group: armenian_simplification]
pʰ -> p;

[id: 4814, name: "simplify aspirated k", weight: 0.2, group: armenian_simplification]
kʰ -> k;

[id: 4815, name: "simplify open e", weight: 0.2, group: armenian_simplification]
ɛ -> e;

[id: 4816, name: "simplify open o", weight: 0.2, group: armenian_simplification]
ɔ -> o;

[id: 4817, name: "simplify schwa", weight: 0.2, group: armenian_simplification]
ə -> e;

