[id: 3263, name: "υ to i", weight: 0.1, group: greek_vowels]
υ -> i;

[id: 3264, name: "ω to o", weight: 0.1, group: greek_vowels]
ω -> o;

// ============================================================
// BASE VOWELS (uppercase)
// ============================================================

[id: 3265, name: "Α to a", weight: 0.1, group: greek_vowels]
Α -> a;

[id: 3266, name: "Ε to e", weight: 0.1, group: greek_vowels]
