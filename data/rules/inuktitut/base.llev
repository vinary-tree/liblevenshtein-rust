// ============================================================
// INUKTITUT SYLLABICS - U series (ᐅ)
// ============================================================

[id: 8690, name: "syllabic u", weight: 0.05, group: inuktitut_syllabics, ipa: "/u/"]
ᐅ -> u;

[id: 8691, name: "syllabic pu", weight: 0.05, group: inuktitut_syllabics, ipa: "/pu/"]
ᐳ -> pu;

[id: 8692, name: "syllabic tu", weight: 0.05, group: inuktitut_syllabics, ipa: "/tu/"]
