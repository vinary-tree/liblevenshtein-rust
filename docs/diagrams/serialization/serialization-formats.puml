@startuml serialization-formats
' Supported compact dictionary and OperationSet persistence formats.
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam class {
  BackgroundColor #F9FBE7
  BorderColor #9E9D24
  FontColor #102027
  AttributeFontColor #102027
}
skinparam note {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
}
skinparam ArrowColor #37474F
skinparam ArrowThickness 2

title Compact binary persistence — bincode or protobuf, optionally gzip wrapped

interface "DictionarySerializer\n«trait»" as Ser #F0F4C3 {
  serialize(&Dictionary) -> bytes
  deserialize(bytes) -> Dictionary
}

class "BincodeSerializer" as Bin #F9FBE7 {
  «feature = serialization»
  compact Rust binary
  exact-consumption decode
}

class "ProtobufSerializer" as Pb #F9FBE7 {
  «feature = protobuf»
  portable schema
  binary interchange
}

class "GzipSerializer<S>" as Gz #F0F4C3 {
  «feature = compression»
  inner : S
  --
  serialize()   : gzip(inner bytes)
  deserialize() : inner(gunzip(bytes))
}

class "Dictionary" as Dict #C8E6C9 {
  DoubleArrayTrie · DynamicDawg
  SuffixAutomaton · Scdawg
}

class "OperationSet" as Ops #C8E6C9 {
  explicit applicability · exact f64 bits
  canonical restrictions · retained rule order
}

Bin ..|> Ser
Pb  ..|> Ser
Gz  ..|> Ser : implements
Gz  o--> Ser : wraps bincode or protobuf
Ser -down-> Dict : "round trip"
Bin -down-> Ops : to/from_binary
Pb -down-> Ops : to/from_protobuf
Gz -down-> Ops : optional outer wrapper

note bottom of Ops
  JSON, TOML, and newline-delimited text are
  intentionally outside the persistence surface.
  Gzip is compression, not a third format.
end note
@enduml
