// Vietnamese Phonetic Rules
// =========================
// Phonetic rules for Vietnamese (Tiếng Việt).
// Strips tonal diacritics and normalizes vowels for phonetic matching.
//
// Key features:
//   - Latin script with extensive diacritics
//   - 6 tones marked with diacritics (stripped for matching)
//   - Special vowels: ă, â, ê, ô, ơ, ư
//   - Special consonant: đ (voiced alveolar)
//   - Digraphs: ch, gh, gi, kh, ng, ngh, nh, ph, qu, th, tr
//
// Vietnamese vowels (12 base forms):
// a, ă, â, e, ê, i, o, ô, ơ, u, ư, y
//
// Tone marks (on all vowels):
// - No mark (ngang): flat tone
// - Grave (huyền): à, falling tone
// - Acute (sắc): á, rising tone
// - Hook (hỏi): ả, dipping-rising tone
// - Tilde (ngã): ã, creaky rising tone
// - Dot below (nặng): ạ, low falling tone
//
// Rule IDs: 2950-2999

@name "Vietnamese Phonetic Rules"
@version "1.0.0"
@author "liblevenshtein"
@description "Phonetic normalization rules for Vietnamese"

// ============================================================
// DIGRAPHS (highest priority - must match before singles)
// ============================================================

// NGH must come before NG (longer match first)
[id: 2950, name: "ngh to ŋ", weight: 0.02, group: vietnamese_digraphs, ipa: "/ŋ/"]
ngh -> ŋ;

[id: 2951, name: "NGH to ŋ", weight: 0.02, group: vietnamese_digraphs, ipa: "/ŋ/"]
NGH -> ŋ;

[id: 2952, name: "Ngh to ŋ", weight: 0.02, group: vietnamese_digraphs, ipa: "/ŋ/"]
Ngh -> ŋ;

// NG (velar nasal)
[id: 2953, name: "ng to ŋ", weight: 0.03, group: vietnamese_digraphs, ipa: "/ŋ/"]
NG -> ŋ;

[id: 2954, name: "Ng to ŋ", weight: 0.03, group: vietnamese_digraphs, ipa: "/ŋ/"]
Ng -> ŋ;

// CH (like English "ch")
[id: 2955, name: "ch to t͡ɕ", weight: 0.03, group: vietnamese_digraphs, ipa: "/t͡ɕ/"]
CH -> t͡ɕ;

[id: 2956, name: "Ch to t͡ɕ", weight: 0.03, group: vietnamese_digraphs, ipa: "/t͡ɕ/"]
Ch -> t͡ɕ;

// GH (like "g" before e, ê, i)
[id: 2957, name: "gh to g", weight: 0.03, group: vietnamese_digraphs]
gh -> g;

[id: 2958, name: "GH to g", weight: 0.03, group: vietnamese_digraphs]
GH -> g;

[id: 2959, name: "Gh to g", weight: 0.03, group: vietnamese_digraphs]
Gh -> g;

// GI (like "z" in Northern, "y" in Southern)
[id: 2960, name: "gi to z", weight: 0.03, group: vietnamese_digraphs]
gi -> z;

[id: 2961, name: "GI to z", weight: 0.03, group: vietnamese_digraphs]
GI -> z;

[id: 2962, name: "Gi to z", weight: 0.03, group: vietnamese_digraphs]
Gi -> z;

// KH (voiceless velar fricative)
[id: 2963, name: "kh to x", weight: 0.03, group: vietnamese_digraphs, ipa: "/x/"]
KH -> x;

[id: 2964, name: "Kh to x", weight: 0.03, group: vietnamese_digraphs, ipa: "/x/"]
Kh -> x;

// NH (palatal nasal, like Spanish ñ)
[id: 2965, name: "nh to ɲ", weight: 0.03, group: vietnamese_digraphs, ipa: "/ɲ/"]
nh -> ɲ;

[id: 2966, name: "NH to ɲ", weight: 0.03, group: vietnamese_digraphs, ipa: "/ɲ/"]
NH -> ɲ;

[id: 2967, name: "Nh to ɲ", weight: 0.03, group: vietnamese_digraphs, ipa: "/ɲ/"]
Nh -> ɲ;

// PH (like "f")
[id: 2968, name: "ph to f", weight: 0.03, group: vietnamese_digraphs]
ph -> f;

[id: 2969, name: "PH to f", weight: 0.03, group: vietnamese_digraphs]
PH -> f;

[id: 2970, name: "Ph to f", weight: 0.03, group: vietnamese_digraphs]
Ph -> f;

// QU (like "kw")
[id: 2971, name: "qu to kw", weight: 0.03, group: vietnamese_digraphs]
qu -> kw;

[id: 2972, name: "QU to kw", weight: 0.03, group: vietnamese_digraphs]
QU -> kw;

[id: 2973, name: "Qu to kw", weight: 0.03, group: vietnamese_digraphs]
Qu -> kw;

// TH (aspirated t)
[id: 2974, name: "th to tʰ", weight: 0.03, group: vietnamese_digraphs, ipa: "/tʰ/"]
TH -> tʰ;

[id: 2975, name: "Th to tʰ", weight: 0.03, group: vietnamese_digraphs, ipa: "/tʰ/"]
Th -> tʰ;

// TR (retroflex, like "ch" in some dialects)
[id: 2976, name: "tr to tr", weight: 0.03, group: vietnamese_digraphs]
TR -> tr;

[id: 2977, name: "Tr to tr", weight: 0.03, group: vietnamese_digraphs]
Tr -> tr;

// ============================================================
// SPECIAL CONSONANT: Đ (voiced alveolar stop)
// ============================================================

[id: 2978, name: "đ to d", weight: 0.05, group: vietnamese_consonants]
đ -> d;

[id: 2979, name: "Đ to d", weight: 0.05, group: vietnamese_consonants]
Đ -> d;

