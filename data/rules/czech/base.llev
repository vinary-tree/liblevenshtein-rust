// Czech Base Phonetic Rules
// =========================
// Phonetic rules for Czech (čeština).
// West Slavic language spoken in the Czech Republic.
//
// Key features:
//   - Háčky (caron): č(ch), š(sh), ž(zh), ř(rzh - unique!)
//   - Čárka (acute): á, é, í, ó, ú, ý (long vowels)
//   - Kroužek: ů (long u, historically from uo)
//   - Soft consonants: ď, ť, ň
//
// Rule IDs: 3300-3349

@name "Czech Base Phonetic Rules"
@version "1.0.0"
@author "liblevenshtein"
@description "Phonetic normalization rules for Czech"

// ============================================================
// SPECIAL CONSONANTS WITH HÁČEK (caron)
// ============================================================

// Č/č → t͡ʃ (voiceless postalveolar affricate)
[id: 3300, name: "c hacek", weight: 0.05, group: czech_caron, ipa: "/t͡ʃ/"]
č -> t͡ʃ;

[id: 3301, name: "C hacek", weight: 0.05, group: czech_caron, ipa: "/t͡ʃ/"]
Č -> t͡ʃ;

// Š/š → ʃ (voiceless postalveolar fricative)
[id: 3302, name: "s hacek", weight: 0.05, group: czech_caron, ipa: "/ʃ/"]
š -> ʃ;

[id: 3303, name: "S hacek", weight: 0.05, group: czech_caron, ipa: "/ʃ/"]
Š -> ʃ;

// Ž/ž → ʒ (voiced postalveolar fricative)
[id: 3304, name: "z hacek", weight: 0.05, group: czech_caron, ipa: "/ʒ/"]
ž -> ʒ;

[id: 3305, name: "Z hacek", weight: 0.05, group: czech_caron, ipa: "/ʒ/"]
Ž -> ʒ;

// Ř/ř → r̝ (raised alveolar trill - unique Czech sound)
[id: 3306, name: "r hacek", weight: 0.05, group: czech_caron, ipa: "/r̝/"]
ř -> r̝;

[id: 3307, name: "R hacek", weight: 0.05, group: czech_caron, ipa: "/r̝/"]
Ř -> r̝;

// ============================================================
// SOFT CONSONANTS
// ============================================================

// Ď/ď → ɟ (voiced palatal plosive)
[id: 3308, name: "d hacek", weight: 0.05, group: czech_soft, ipa: "/ɟ/"]
ď -> ɟ;

[id: 3309, name: "D hacek", weight: 0.05, group: czech_soft, ipa: "/ɟ/"]
Ď -> ɟ;

// Ť/ť → c (voiceless palatal plosive)
[id: 3310, name: "t hacek", weight: 0.05, group: czech_soft, ipa: "/c/"]
ť -> c;

[id: 3311, name: "T hacek", weight: 0.05, group: czech_soft, ipa: "/c/"]
Ť -> c;

// Ň/ň → ɲ (palatal nasal, like Spanish ñ)
[id: 3312, name: "n hacek", weight: 0.05, group: czech_soft, ipa: "/ɲ/"]
ň -> ɲ;

[id: 3313, name: "N hacek", weight: 0.05, group: czech_soft, ipa: "/ɲ/"]
Ň -> ɲ;

// ============================================================
// VOWELS WITH ČÁRKA (acute) - long vowels
// ============================================================

// Á/á → aː (long a)
[id: 3314, name: "a acute", weight: 0.1, group: czech_long_vowels, ipa: "/aː/"]
á -> aː;

[id: 3315, name: "A acute", weight: 0.1, group: czech_long_vowels, ipa: "/aː/"]
Á -> aː;

// É/é → eː (long e)
[id: 3316, name: "e acute", weight: 0.1, group: czech_long_vowels, ipa: "/eː/"]
é -> eː;

[id: 3317, name: "E acute", weight: 0.1, group: czech_long_vowels, ipa: "/eː/"]
É -> eː;

// Í/í → iː (long i)
[id: 3318, name: "i acute", weight: 0.1, group: czech_long_vowels, ipa: "/iː/"]
í -> iː;

[id: 3319, name: "I acute", weight: 0.1, group: czech_long_vowels, ipa: "/iː/"]
Í -> iː;

// Ó/ó → oː (long o, rare in native words)
[id: 3320, name: "o acute", weight: 0.1, group: czech_long_vowels, ipa: "/oː/"]
ó -> oː;

[id: 3321, name: "O acute", weight: 0.1, group: czech_long_vowels, ipa: "/oː/"]
Ó -> oː;

// Ú/ú → uː (long u at word start)
[id: 3322, name: "u acute", weight: 0.1, group: czech_long_vowels, ipa: "/uː/"]
ú -> uː;

[id: 3323, name: "U acute", weight: 0.1, group: czech_long_vowels, ipa: "/uː/"]
Ú -> uː;

// Ů/ů → uː (long u with kroužek, mid/end of word)
[id: 3324, name: "u ring", weight: 0.1, group: czech_long_vowels, ipa: "/uː/"]
ů -> uː;

[id: 3325, name: "U ring", weight: 0.1, group: czech_long_vowels, ipa: "/uː/"]
Ů -> uː;

// Ý/ý → iː (long y, same sound as í)
[id: 3326, name: "y acute", weight: 0.1, group: czech_long_vowels, ipa: "/iː/"]
ý -> iː;

[id: 3327, name: "Y acute", weight: 0.1, group: czech_long_vowels, ipa: "/iː/"]
Ý -> iː;

// ============================================================
// STANDARD VOWELS
// ============================================================
// Note: Standard short vowels (a, e, i, o, u) are already in IPA form,
// no transformation needed (unmapped characters pass through unchanged)

// A → a (case normalization only)
[id: 3329, name: "A vowel", weight: 0.15, group: czech_vowels]
A -> a;

// E → e (case normalization only)
[id: 3331, name: "E vowel", weight: 0.15, group: czech_vowels]
E -> e;

// I → i (case normalization only)
[id: 3333, name: "I vowel", weight: 0.15, group: czech_vowels]
I -> i;

// O → o (case normalization only)
[id: 3335, name: "O vowel", weight: 0.15, group: czech_vowels]
O -> o;

// U → u (case normalization only)
[id: 3337, name: "U vowel", weight: 0.15, group: czech_vowels]
U -> u;

// Y/y → i (y and i have same pronunciation)
[id: 3338, name: "y vowel", weight: 0.15, group: czech_vowels]
y -> i;

[id: 3339, name: "Y vowel", weight: 0.15, group: czech_vowels]
Y -> i;

// ============================================================
// CONSONANTS
// ============================================================
// Note: Standard consonants (b, d, f, g, h, j, k, l, m, n, p, r, s, t, v, z)
// are already in IPA form, no transformation needed (unmapped characters pass through unchanged)

[id: 3341, name: "B consonant", weight: 0.2, group: czech_consonants]
B -> b;

[id: 3342, name: "c consonant", weight: 0.2, group: czech_consonants, ipa: "/t͡s/"]
c -> t͡s;

[id: 3343, name: "C consonant", weight: 0.2, group: czech_consonants, ipa: "/t͡s/"]
C -> t͡s;

[id: 3345, name: "D consonant", weight: 0.2, group: czech_consonants]
D -> d;

[id: 3347, name: "F consonant", weight: 0.2, group: czech_consonants]
F -> f;

[id: 3349, name: "G consonant", weight: 0.2, group: czech_consonants, ipa: "/ɡ/"]
G -> ɡ;

[id: 3351, name: "H consonant", weight: 0.2, group: czech_consonants]
H -> h;

[id: 3353, name: "J consonant", weight: 0.2, group: czech_consonants, ipa: "/j/"]
J -> j;

[id: 3355, name: "K consonant", weight: 0.2, group: czech_consonants]
K -> k;

[id: 3357, name: "L consonant", weight: 0.2, group: czech_consonants]
L -> l;

[id: 3359, name: "M consonant", weight: 0.2, group: czech_consonants]
M -> m;

[id: 3361, name: "N consonant", weight: 0.2, group: czech_consonants]
N -> n;

[id: 3363, name: "P consonant", weight: 0.2, group: czech_consonants]
P -> p;

[id: 3364, name: "q consonant", weight: 0.2, group: czech_consonants]
q -> kv;

[id: 3365, name: "Q consonant", weight: 0.2, group: czech_consonants]
Q -> kv;

[id: 3367, name: "R consonant", weight: 0.2, group: czech_consonants]
R -> r;

[id: 3369, name: "S consonant", weight: 0.2, group: czech_consonants]
S -> s;

[id: 3371, name: "T consonant", weight: 0.2, group: czech_consonants]
T -> t;

[id: 3373, name: "V consonant", weight: 0.2, group: czech_consonants]
V -> v;

[id: 3374, name: "w consonant", weight: 0.2, group: czech_consonants]
w -> v;

[id: 3375, name: "W consonant", weight: 0.2, group: czech_consonants]
W -> v;

[id: 3376, name: "x consonant", weight: 0.2, group: czech_consonants]
x -> ks;

[id: 3377, name: "X consonant", weight: 0.2, group: czech_consonants]
X -> ks;

[id: 3379, name: "Z consonant", weight: 0.2, group: czech_consonants]
Z -> z;

