// Armenian Base Phonetic Rules
// ============================
// Phonetic rules for Armenian script romanization.
// Maps Armenian letters to Latin equivalents for phonetic matching.
//
// Armenian script created in 405 AD:
//   - 39 letters (originally 36)
//   - Has uppercase and lowercase
//   - Aspirated consonant series
//   - Two dialects: Eastern (Armenia) vs Western (diaspora)
//   - This implementation follows Eastern Armenian pronunciation
//
// Rule IDs: 4700-4799

@name "Armenian Base Phonetic Rules"
@version "1.0.0"
@author "liblevenshtein"
@description "Phonetic normalization rules for Armenian script"

// ============================================================
// VOWELS (weight 0.05)
// Armenian has 6 vowels (7 including schwa)
// Both uppercase and lowercase forms
// ============================================================

// Uppercase vowels
[id: 4700, name: "ayb upper", weight: 0.05, group: armenian_vowels]
\u0531 -> a;

[id: 4701, name: "ech upper", weight: 0.05, group: armenian_vowels]
\u0535 -> e;

[id: 4702, name: "e upper", weight: 0.05, group: armenian_vowels, ipa: "/ɛ/"]
\u0537 -> ɛ;

[id: 4703, name: "ini upper", weight: 0.05, group: armenian_vowels]
\u053B -> i;

[id: 4704, name: "oh upper", weight: 0.05, group: armenian_vowels]
\u0548 -> o;

[id: 4705, name: "o upper", weight: 0.05, group: armenian_vowels, ipa: "/ɔ/"]
\u0555 -> ɔ;

// Lowercase vowels
[id: 4710, name: "ayb lower", weight: 0.05, group: armenian_vowels]
\u0561 -> a;

[id: 4711, name: "ech lower", weight: 0.05, group: armenian_vowels]
\u0565 -> e;

[id: 4712, name: "e lower", weight: 0.05, group: armenian_vowels, ipa: "/ɛ/"]
\u0567 -> ɛ;

[id: 4713, name: "ini lower", weight: 0.05, group: armenian_vowels]
\u056B -> i;

[id: 4714, name: "oh lower", weight: 0.05, group: armenian_vowels]
\u0578 -> o;

[id: 4715, name: "o lower", weight: 0.05, group: armenian_vowels, ipa: "/ɔ/"]
\u0585 -> ɔ;

// Schwa (sometimes considered vowel, sometimes consonant)
[id: 4716, name: "et upper schwa", weight: 0.05, group: armenian_vowels, ipa: "/ə/"]
\u0538 -> ə;

[id: 4717, name: "et lower schwa", weight: 0.05, group: armenian_vowels, ipa: "/ə/"]
\u0568 -> ə;

// ============================================================
// CONSONANTS - VOICED STOPS
// ============================================================

[id: 4720, name: "ben upper", weight: 0.05, group: armenian_voiced_stops]
\u0532 -> b;

[id: 4721, name: "ben lower", weight: 0.05, group: armenian_voiced_stops]
\u0562 -> b;

[id: 4722, name: "gim upper", weight: 0.05, group: armenian_voiced_stops, ipa: "/ɡ/"]
\u0533 -> ɡ;

[id: 4723, name: "gim lower", weight: 0.05, group: armenian_voiced_stops, ipa: "/ɡ/"]
\u0563 -> ɡ;

[id: 4724, name: "da upper", weight: 0.05, group: armenian_voiced_stops]
\u0534 -> d;

[id: 4725, name: "da lower", weight: 0.05, group: armenian_voiced_stops]
\u0564 -> d;

// ============================================================
// CONSONANTS - VOICELESS STOPS (aspirated)
// ============================================================

[id: 4730, name: "to upper aspirated", weight: 0.05, group: armenian_aspirated, ipa: "/tʰ/"]
\u0539 -> tʰ;

[id: 4731, name: "to lower aspirated", weight: 0.05, group: armenian_aspirated, ipa: "/tʰ/"]
