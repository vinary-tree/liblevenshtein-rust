hai6 -> hɐi˨;

[id: 13684, name: "m4hai6 no", weight: 0.02, group: cantonese_common]
m4hai6 -> m̩˨˩hɐi˨;

[id: 13685, name: "seoi2 water", weight: 0.02, group: cantonese_common]
seoi2 -> sɵy˧˥;

[id: 13686, name: "min6baau1 bread", weight: 0.02, group: cantonese_common]
min6baau1 -> miːn˨paːu˥;

[id: 13687, name: "uk1 house", weight: 0.02, group: cantonese_common]
uk1 -> ʊk̚˥;

