// Swedish Base Phonetic Rules
// ===========================
// Phonetic rules for Swedish (svenska).
// North Germanic language spoken in Sweden and Finland.
//
// Key features:
//   - Three extra vowels: å (o-like), ä (e-like), ö (oe-like)
//   - SJ-sound: sj, skj, stj → unique fricative
//   - TJ/KJ: voiceless palatal fricative
//   - Silent consonants in clusters: dj, gj, hj, lj → j
//
// Rule IDs: 3650-3699

@name "Swedish Base Phonetic Rules"
@version "1.0.0"
@author "liblevenshtein"
@description "Phonetic normalization rules for Swedish"

// ============================================================
// TRIGRAPHS (highest priority)
// ============================================================

// STJ → ɧ (sj-sound, voiceless palatal-velar fricative)
[id: 3650, name: "stj trigraph", weight: 0.02, group: swedish_trigraphs, ipa: "/ɧ/"]
stj -> ɧ;

[id: 3651, name: "Stj trigraph", weight: 0.02, group: swedish_trigraphs, ipa: "/ɧ/"]
Stj -> ɧ;

[id: 3652, name: "STJ trigraph", weight: 0.02, group: swedish_trigraphs, ipa: "/ɧ/"]
STJ -> ɧ;

// SKJ → ɧ (sj-sound, voiceless palatal-velar fricative)
[id: 3653, name: "skj trigraph", weight: 0.02, group: swedish_trigraphs, ipa: "/ɧ/"]
skj -> ɧ;

[id: 3654, name: "Skj trigraph", weight: 0.02, group: swedish_trigraphs, ipa: "/ɧ/"]
Skj -> ɧ;

[id: 3655, name: "SKJ trigraph", weight: 0.02, group: swedish_trigraphs, ipa: "/ɧ/"]
SKJ -> ɧ;

// ============================================================
// DIGRAPHS (high priority)
// ============================================================

// SJ → ɧ (sj-sound, voiceless palatal-velar fricative)
[id: 3656, name: "sj digraph", weight: 0.05, group: swedish_digraphs, ipa: "/ɧ/"]
sj -> ɧ;

[id: 3657, name: "Sj digraph", weight: 0.05, group: swedish_digraphs, ipa: "/ɧ/"]
Sj -> ɧ;

[id: 3658, name: "SJ digraph", weight: 0.05, group: swedish_digraphs, ipa: "/ɧ/"]
SJ -> ɧ;

// TJ → ç (voiceless palatal fricative)
[id: 3659, name: "tj digraph", weight: 0.05, group: swedish_digraphs, ipa: "/ç/"]
tj -> ç;

[id: 3660, name: "Tj digraph", weight: 0.05, group: swedish_digraphs, ipa: "/ç/"]
Tj -> ç;

[id: 3661, name: "TJ digraph", weight: 0.05, group: swedish_digraphs, ipa: "/ç/"]
TJ -> ç;

// KJ → ç (same sound as tj, voiceless palatal fricative)
[id: 3662, name: "kj digraph", weight: 0.05, group: swedish_digraphs, ipa: "/ç/"]
kj -> ç;

[id: 3663, name: "Kj digraph", weight: 0.05, group: swedish_digraphs, ipa: "/ç/"]
Kj -> ç;

[id: 3664, name: "KJ digraph", weight: 0.05, group: swedish_digraphs, ipa: "/ç/"]
KJ -> ç;

// NG → ŋ (velar nasal)
[id: 3665, name: "ng digraph", weight: 0.05, group: swedish_digraphs, ipa: "/ŋ/"]
ng -> ŋ;

[id: 3666, name: "NG digraph", weight: 0.05, group: swedish_digraphs, ipa: "/ŋ/"]
NG -> ŋ;

// ============================================================
// SILENT CONSONANT CLUSTERS → J
// ============================================================

// DJ → j (d is silent)
[id: 3667, name: "dj to j", weight: 0.05, group: swedish_silent, ipa: "/j/"]
dj -> j;

[id: 3668, name: "DJ to j", weight: 0.05, group: swedish_silent, ipa: "/j/"]
DJ -> j;

// GJ → j (g is silent)
[id: 3669, name: "gj to j", weight: 0.05, group: swedish_silent, ipa: "/j/"]
gj -> j;

[id: 3670, name: "GJ to j", weight: 0.05, group: swedish_silent, ipa: "/j/"]
GJ -> j;

// HJ → j (h is silent)
[id: 3671, name: "hj to j", weight: 0.05, group: swedish_silent, ipa: "/j/"]
hj -> j;

[id: 3672, name: "HJ to j", weight: 0.05, group: swedish_silent, ipa: "/j/"]
HJ -> j;

// LJ → j (l is silent)
[id: 3673, name: "lj to j", weight: 0.05, group: swedish_silent, ipa: "/j/"]
lj -> j;

[id: 3674, name: "LJ to j", weight: 0.05, group: swedish_silent, ipa: "/j/"]
LJ -> j;

// ============================================================
// SPECIAL VOWELS
// ============================================================

// Å/å → ɔ (rounded back vowel, like English "or")
[id: 3675, name: "a ring to o", weight: 0.1, group: swedish_vowels, ipa: "/ɔ/"]
å -> ɔ;

[id: 3676, name: "A ring to o", weight: 0.1, group: swedish_vowels, ipa: "/ɔ/"]
Å -> ɔ;

// Ä/ä → ɛ (front vowel, like English "air")
[id: 3677, name: "a umlaut to ae", weight: 0.1, group: swedish_vowels, ipa: "/ɛ/"]
ä -> ɛ;

[id: 3678, name: "A umlaut to ae", weight: 0.1, group: swedish_vowels, ipa: "/ɛ/"]
Ä -> ɛ;

// Ö/ö → ø (front rounded vowel)
[id: 3679, name: "o umlaut to oe", weight: 0.1, group: swedish_vowels, ipa: "/ø/"]
ö -> ø;

[id: 3680, name: "O umlaut to oe", weight: 0.1, group: swedish_vowels, ipa: "/ø/"]
Ö -> ø;

// ============================================================
// STANDARD VOWELS
// ============================================================

[id: 3681, name: "a vowel", weight: 0.15, group: swedish_vowels]
a -> a;

[id: 3682, name: "A vowel", weight: 0.15, group: swedish_vowels]
A -> a;

[id: 3683, name: "e vowel", weight: 0.15, group: swedish_vowels]
e -> e;

[id: 3684, name: "E vowel", weight: 0.15, group: swedish_vowels]
E -> e;

[id: 3685, name: "i vowel", weight: 0.15, group: swedish_vowels]
i -> i;

[id: 3686, name: "I vowel", weight: 0.15, group: swedish_vowels]
I -> i;

[id: 3687, name: "o vowel", weight: 0.15, group: swedish_vowels]
o -> o;

[id: 3688, name: "O vowel", weight: 0.15, group: swedish_vowels]
O -> o;

[id: 3689, name: "u vowel", weight: 0.15, group: swedish_vowels]
u -> u;

[id: 3690, name: "U vowel", weight: 0.15, group: swedish_vowels]
U -> u;

[id: 3691, name: "y vowel", weight: 0.15, group: swedish_vowels, ipa: "/y/"]
y -> y;

[id: 3692, name: "Y vowel", weight: 0.15, group: swedish_vowels, ipa: "/y/"]
Y -> y;

