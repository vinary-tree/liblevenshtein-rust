// Nepali Base Phonetic Rules
// ==========================
// Phonetic rules for Nepali.
// Spoken by approximately 16 million native speakers in Nepal
// and parts of India.
//
// Nepali features:
//   - Indo-Aryan language (related to Hindi)
//   - Devanagari script
//   - Aspirated and breathy-voiced consonants
//   - Retroflex consonants
//   - Nasal vowels
//   - SOV word order
//   - No tones
//
// Orthography:
//   - Devanagari script (shared with Hindi)
//   - Inherent 'a' vowel (schwa deletion applies)
//   - Aspirated consonants marked with ह
//
// Rule IDs: 13900-13999

@name "Nepali Phonetic Rules"
@version "1.0.0"
@author "liblevenshtein"
@description "Phonetic normalization rules for Nepali"

// ============================================================
// VOWELS (weight 0.05)
// ============================================================

[id: 13900, name: "अ a", weight: 0.05, group: nepali_vowels, ipa: "/ʌ/"]
अ -> ʌ;

[id: 13901, name: "आ aa", weight: 0.05, group: nepali_vowels, ipa: "/aː/"]
आ -> aː;

[id: 13902, name: "इ i", weight: 0.05, group: nepali_vowels, ipa: "/i/"]
इ -> i;

[id: 13903, name: "ई ii", weight: 0.05, group: nepali_vowels, ipa: "/iː/"]
ई -> iː;

[id: 13904, name: "उ u", weight: 0.05, group: nepali_vowels, ipa: "/u/"]
उ -> u;

[id: 13905, name: "ऊ uu", weight: 0.05, group: nepali_vowels, ipa: "/uː/"]
ऊ -> uː;

[id: 13906, name: "ए e", weight: 0.05, group: nepali_vowels, ipa: "/e/"]
ए -> e;

[id: 13907, name: "ऐ ai", weight: 0.05, group: nepali_vowels, ipa: "/ʌi/"]
ऐ -> ʌi;

[id: 13908, name: "ओ o", weight: 0.05, group: nepali_vowels, ipa: "/o/"]
ओ -> o;

[id: 13909, name: "औ au", weight: 0.05, group: nepali_vowels, ipa: "/ʌu/"]
औ -> ʌu;

// ============================================================
// VOWEL MATRAS (weight 0.05)
// ============================================================

[id: 13912, name: "ा aa matra", weight: 0.05, group: nepali_matras, ipa: "/aː/"]
ा -> aː;

[id: 13913, name: "ि i matra", weight: 0.05, group: nepali_matras, ipa: "/i/"]
ि -> i;

[id: 13914, name: "ी ii matra", weight: 0.05, group: nepali_matras, ipa: "/iː/"]
ी -> iː;

[id: 13915, name: "ु u matra", weight: 0.05, group: nepali_matras, ipa: "/u/"]
ु -> u;

[id: 13916, name: "ू uu matra", weight: 0.05, group: nepali_matras, ipa: "/uː/"]
ू -> uː;

[id: 13917, name: "े e matra", weight: 0.05, group: nepali_matras, ipa: "/e/"]
े -> e;

[id: 13918, name: "ै ai matra", weight: 0.05, group: nepali_matras, ipa: "/ʌi/"]
ै -> ʌi;

[id: 13919, name: "ो o matra", weight: 0.05, group: nepali_matras, ipa: "/o/"]
ो -> o;

[id: 13920, name: "ौ au matra", weight: 0.05, group: nepali_matras, ipa: "/ʌu/"]
ौ -> ʌu;

// ============================================================
// VELAR STOPS (weight 0.05)
// ============================================================

[id: 13924, name: "क ka", weight: 0.05, group: nepali_velars, ipa: "/kʌ/"]
क -> kʌ;

[id: 13925, name: "ख kha", weight: 0.05, group: nepali_velars, ipa: "/kʰʌ/"]
ख -> kʰʌ;

[id: 13926, name: "ग ga", weight: 0.05, group: nepali_velars, ipa: "/ɡʌ/"]
ग -> ɡʌ;

[id: 13927, name: "घ gha", weight: 0.05, group: nepali_velars, ipa: "/ɡʱʌ/"]
घ -> ɡʱʌ;

[id: 13928, name: "ङ nga", weight: 0.05, group: nepali_velars, ipa: "/ŋʌ/"]
ङ -> ŋʌ;

// ============================================================
// PALATAL STOPS (weight 0.05)
// ============================================================

[id: 13930, name: "च ca", weight: 0.05, group: nepali_palatals, ipa: "/t͡sʌ/"]
च -> t͡sʌ;

[id: 13931, name: "छ cha", weight: 0.05, group: nepali_palatals, ipa: "/t͡sʰʌ/"]
छ -> t͡sʰʌ;

[id: 13932, name: "ज ja", weight: 0.05, group: nepali_palatals, ipa: "/d͡zʌ/"]
ज -> d͡zʌ;

[id: 13933, name: "झ jha", weight: 0.05, group: nepali_palatals, ipa: "/d͡zʱʌ/"]
झ -> d͡zʱʌ;

[id: 13934, name: "ञ nya", weight: 0.05, group: nepali_palatals, ipa: "/ɲʌ/"]
ञ -> ɲʌ;

