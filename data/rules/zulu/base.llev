sawubona -> sawuɓɔna;

[id: 12682, name: "ngiyabonga thank you", weight: 0.02, group: zulu_common]
ngiyabonga -> ŋɡijaɓɔŋɡa;

[id: 12683, name: "yebo yes", weight: 0.02, group: zulu_common]
yebo -> jɛɓɔ;

[id: 12684, name: "cha no", weight: 0.02, group: zulu_common]
cha -> t͡ʃa;

[id: 12685, name: "amanzi water", weight: 0.02, group: zulu_common]
amanzi -> amaⁿzi;

[id: 12686, name: "isinkwa bread food", weight: 0.02, group: zulu_common]
isinkwa -> isiŋkwa;

[id: 12687, name: "indlu house", weight: 0.02, group: zulu_common]
indlu -> iⁿɮu;

// Note: Identity mapping removed (umuntu -> umuntu)

[id: 12689, name: "ingane child", weight: 0.02, group: zulu_common]
ingane -> iŋɡanɛ;

