// Icelandic Phonetic Rules
// ========================
// Phonetic rules for Icelandic (Íslenska).
// Maps Icelandic orthography to phonetic representations.
//
// Key features:
//   - Archaic Norse orthography preserved
//   - Unique letters: Þ/þ (voiceless th), Ð/ð (voiced th), Æ/æ (ai)
//   - Accented vowels indicate quality, not just length
//   - Complex consonant clusters with special pronunciations
//
// Icelandic alphabet (32 letters):
// A Á B D Ð E É F G H I Í J K L M N O Ó P R S T U Ú V X Y Ý Þ Æ Ö
//
// Rule IDs: 3850-3950

@name "Icelandic Phonetic Rules"
@version "1.0.0"
@author "liblevenshtein"
@description "Phonetic normalization rules for Icelandic"

// ============================================================
// CONSONANT CLUSTERS (highest priority)
// ============================================================

// HV → kv (like "kv")
[id: 3850, name: "hv to kv", weight: 0.02, group: icelandic_clusters]
hv -> kv;

// LL → tl (special Icelandic pronunciation)
[id: 3853, name: "ll to tl", weight: 0.02, group: icelandic_clusters]
ll -> tl;

// RL → rtl (retroflex + lateral)
[id: 3855, name: "rl to rtl", weight: 0.02, group: icelandic_clusters]
rl -> rtl;

// RN → rtn (retroflex nasal)
[id: 3857, name: "rn to rtn", weight: 0.02, group: icelandic_clusters]
rn -> rtn;

// NN → tn (pre-aspirated)
[id: 3859, name: "nn to tn", weight: 0.02, group: icelandic_clusters]
nn -> tn;

// DJ → j
[id: 3861, name: "dj to j", weight: 0.02, group: icelandic_clusters]
dj -> j;

// GJ → j
[id: 3863, name: "gj to j", weight: 0.02, group: icelandic_clusters]
gj -> j;

// HJ → j
[id: 3865, name: "hj to j", weight: 0.02, group: icelandic_clusters]
hj -> j;

// FN → pn (devoiced)
[id: 3869, name: "fn to pn", weight: 0.02, group: icelandic_clusters]
fn -> pn;

// ============================================================
// UNIQUE LETTERS
// ============================================================

// Þ/þ → θ (voiceless dental fricative, like English "thing")
[id: 3871, name: "þ to θ", weight: 0.05, group: icelandic_unique, ipa: "/θ/"]
þ -> θ;

// Æ/æ → aɪ (diphthong)
[id: 3875, name: "æ to aɪ", weight: 0.05, group: icelandic_unique, ipa: "/aɪ/"]
æ -> aɪ;

// Ö/ö → ø (rounded front vowel)
[id: 3877, name: "ö to ø", weight: 0.05, group: icelandic_unique, ipa: "/ø/"]
ö -> ø;

// ============================================================
// ACCENTED VOWELS (different sounds, not just length)
// ============================================================

// Á/á → au (diphthong /au/)
[id: 3879, name: "á to au", weight: 0.1, group: icelandic_accents, ipa: "/au/"]
á -> au;

// É/é → jɛ (diphthong /jɛ/)
[id: 3881, name: "é to jɛ", weight: 0.1, group: icelandic_accents, ipa: "/jɛ/"]
é -> jɛ;

// Í/í → iː (long /iː/)
[id: 3883, name: "í to iː", weight: 0.1, group: icelandic_accents, ipa: "/iː/"]
í -> iː;

// Ó/ó → ou (diphthong /ou/)
[id: 3885, name: "ó to ou", weight: 0.1, group: icelandic_accents, ipa: "/ou/"]
ó -> ou;

// Ú/ú → uː (long /uː/)
[id: 3887, name: "ú to uː", weight: 0.1, group: icelandic_accents, ipa: "/uː/"]
ú -> uː;

// Ý/ý → iː (same as í in Modern Icelandic)
[id: 3889, name: "ý to iː", weight: 0.1, group: icelandic_accents, ipa: "/iː/"]
ý -> iː;

// ============================================================
// BASE VOWELS
// ============================================================

[id: 3896, name: "y to i", weight: 0.15, group: icelandic_vowels]
y -> i;

