// Slovak Base Phonetic Rules
// ==========================
// Phonetic rules for Slovak (slovenčina).
// West Slavic language spoken in Slovakia.
//
// Key features:
//   - Similar to Czech but NO ř
//   - Háčky (caron): č(ch), š(sh), ž(zh), ď, ť, ň, ľ(soft l)
//   - Čárka (acute): á, é, í, ó, ú, ý (long vowels)
//   - Ô → uo diphthong
//   - Dz, Dž as single phonemes
//
// Note: This file contains only lowercase transformations.
// Uppercase normalization is handled by case folding in the engine.
//
// Rule IDs: 3380, 3383, 3386, 3388, 3390, 3392, 3394, 3396, 3398,
//           3400, 3402, 3404, 3406, 3408, 3410, 3412, 3424, 3428,
//           3430, 3434, 3450, 3460, 3462

@name "Slovak Base Phonetic Rules"
@version "1.0.0"
@author "liblevenshtein"
@description "Phonetic normalization rules for Slovak"

// ============================================================
// DIGRAPHS (high priority)
// ============================================================

// dž → d͡ʒ (voiced postalveolar affricate)
[id: 3380, name: "dz hacek", weight: 0.05, group: slovak_digraphs, ipa: "/d͡ʒ/"]
dž -> d͡ʒ;

// dz → d͡z (voiced alveolar affricate)
[id: 3383, name: "dz digraph", weight: 0.05, group: slovak_digraphs, ipa: "/d͡z/"]
dz -> d͡z;

// ============================================================
// SPECIAL CONSONANTS WITH HÁČEK (caron)
// ============================================================

// č → t͡ʃ (voiceless postalveolar affricate)
[id: 3386, name: "c hacek", weight: 0.05, group: slovak_caron, ipa: "/t͡ʃ/"]
č -> t͡ʃ;

// š → ʃ (voiceless postalveolar fricative)
[id: 3388, name: "s hacek", weight: 0.05, group: slovak_caron, ipa: "/ʃ/"]
š -> ʃ;

// ž → ʒ (voiced postalveolar fricative)
[id: 3390, name: "z hacek", weight: 0.05, group: slovak_caron, ipa: "/ʒ/"]
ž -> ʒ;

// ============================================================
// SOFT CONSONANTS
// ============================================================

// ď → ɟ (voiced palatal plosive)
[id: 3392, name: "d hacek", weight: 0.05, group: slovak_soft, ipa: "/ɟ/"]
ď -> ɟ;

// ť → c (voiceless palatal plosive)
[id: 3394, name: "t hacek", weight: 0.05, group: slovak_soft, ipa: "/c/"]
ť -> c;

// ň → ɲ (palatal nasal, like Spanish ñ)
[id: 3396, name: "n hacek", weight: 0.05, group: slovak_soft, ipa: "/ɲ/"]
ň -> ɲ;

// ľ → ʎ (palatal lateral approximant - Slovak specific)
[id: 3398, name: "l hacek", weight: 0.05, group: slovak_soft, ipa: "/ʎ/"]
ľ -> ʎ;

// ============================================================
// SPECIAL VOWELS
// ============================================================

// ô → uo (diphthong, Slovak specific)
[id: 3400, name: "o circumflex", weight: 0.1, group: slovak_diphthongs, ipa: "/uo/"]
ô -> uo;

// ============================================================
// VOWELS WITH ČÁRKA (acute) - long vowels
// ============================================================

// á → aː (long a)
[id: 3402, name: "a acute", weight: 0.1, group: slovak_long_vowels, ipa: "/aː/"]
á -> aː;

// é → eː (long e)
[id: 3404, name: "e acute", weight: 0.1, group: slovak_long_vowels, ipa: "/eː/"]
é -> eː;

// í → iː (long i)
[id: 3406, name: "i acute", weight: 0.1, group: slovak_long_vowels, ipa: "/iː/"]
í -> iː;

// ó → oː (long o)
[id: 3408, name: "o acute", weight: 0.1, group: slovak_long_vowels, ipa: "/oː/"]
ó -> oː;

// ú → uː (long u)
[id: 3410, name: "u acute", weight: 0.1, group: slovak_long_vowels, ipa: "/uː/"]
ú -> uː;

// ý → iː (long y = long i)
[id: 3412, name: "y acute", weight: 0.1, group: slovak_long_vowels, ipa: "/iː/"]
ý -> iː;

// ============================================================
// STANDARD VOWELS
// ============================================================

// y → i (y and i have same pronunciation)
[id: 3424, name: "y vowel", weight: 0.15, group: slovak_vowels]
y -> i;

// ============================================================
// CONSONANTS
// ============================================================

// c → t͡s (voiceless alveolar affricate)
[id: 3428, name: "c consonant", weight: 0.2, group: slovak_consonants, ipa: "/t͡s/"]
c -> t͡s;

// g → ɡ (ASCII g to IPA voiced velar plosive)
[id: 3430, name: "g consonant", weight: 0.2, group: slovak_consonants, ipa: "/ɡ/"]
g -> ɡ;

// q → kv (loanword)
[id: 3434, name: "q consonant", weight: 0.2, group: slovak_consonants]
q -> kv;

// w → v (loanword)
[id: 3450, name: "w consonant", weight: 0.2, group: slovak_consonants]
w -> v;

// x → ks (loanword)
[id: 3460, name: "x consonant", weight: 0.2, group: slovak_consonants]
x -> ks;

