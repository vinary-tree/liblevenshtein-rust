[id: 3268, name: "Ι to i", weight: 0.1, group: greek_vowels]
Ι -> i;

[id: 3269, name: "Ο to o", weight: 0.1, group: greek_vowels]
Ο -> o;

[id: 3270, name: "Υ to i", weight: 0.1, group: greek_vowels]
Υ -> i;

[id: 3271, name: "Ω to o", weight: 0.1, group: greek_vowels]
Ω -> o;

// ============================================================
// CONSONANTS (lowercase)
// ============================================================

[id: 3272, name: "β to v", weight: 0.15, group: greek_consonants]
β -> v;

[id: 3273, name: "γ to g", weight: 0.15, group: greek_consonants, ipa: "/ɡ/"]
