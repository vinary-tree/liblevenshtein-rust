abels -> eɪbəlz / #_#;

[id: 2934, name: "ables to abels phonetic", weight: 0.0, group: cmudict_name_homophones]
ables -> eɪbəlz / #_#;

[id: 2935, name: "accouterment to accoutrement phonetic", weight: 0.0, group: cmudict_name_homophones]
accouterment -> əkutɚmənt / #_#;

