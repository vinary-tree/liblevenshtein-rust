supreme -> suːpɹiːm;

// After L
[id: 540, name: "yod-drop lute", weight: 0.2, group: american_yod, ipa: "/luːt/"]
lute -> luːt;

[id: 541, name: "yod-drop lude", weight: 0.2, group: american_yod, ipa: "/luːd/"]
lude -> luːd;

[id: 542, name: "yod-drop lure", weight: 0.2, group: american_yod, ipa: "/luːɹ/"]
