// Zompist English Phonetic Rules
// ================================
// Based on Mark Rosenfelder's (Zompist) English spelling rules
// https://zompist.com/spell.html
//
// These 62 rules transform English orthography to a normalized phonetic form.
// All rules are formally verified in Coq/Rocq (see docs/verification/phonetic/).
//
// Verified Properties:
//   - Theorem 1: Well-formedness (all rules satisfy structural constraints)
//   - Theorem 2: Bounded expansion (output <= input + 20 characters)
//   - Theorem 3: Non-confluence (rule order matters - proven constructively)
//   - Theorem 4: Termination (sequential application always terminates)
//   - Theorem 5: Idempotence (fixed points remain unchanged)

@name "Zompist English Phonetic Rules (Complete)"
@version "2.0"
@author "Based on Zompist's English spelling rules"
@description "Complete phonetic rewrite rules for English spelling normalization"

// ============================================================
// Symbol Definitions
// ============================================================

@define FRONT_VOWEL = [ei]
@define VOWEL = [aeiou]
@define CONSONANT = [bcdfghjklmnpqrstvwxyz]

// ============================================================
// Phase 1: Specific Multi-Character Patterns (HIGH PRIORITY)
// Must be matched before simpler rules consume their components
// ============================================================

[id: 110, name: "tion ending", weight: 0.0, group: affrication, ipa: "/ʃən/"]
// tion -> ʃən (nation -> naʃən)
tion -> ʃən;

[id: 111, name: "sion ending", weight: 0.0, group: affrication, ipa: "/ʒən/"]
// sion -> ʒən (vision -> viʒən)
sion -> ʒən;

[id: 112, name: "cious ending", weight: 0.0, group: affrication, ipa: "/ʃəs/"]
// cious -> ʃəs (precious -> preʃəs)
cious -> ʃəs;

[id: 113, name: "tious ending", weight: 0.0, group: affrication, ipa: "/ʃəs/"]
// tious -> ʃəs (cautious -> kɔːʃəs)
tious -> ʃəs;

// NOTE: OUGH/AUGHT/OUGHT patterns moved to dialect files (american.llev, british.llev)
// because GA and RP have different vowel qualities for these patterns.

[id: 130, name: "tch simplify", weight: 0.0, group: orthography, ipa: "/t͡ʃ/"]
// tch -> t͡ʃ (batch -> bæt͡ʃ, watch -> wɒt͡ʃ)
tch -> t͡ʃ;

[id: 131, name: "dge simplify", weight: 0.0, group: orthography, ipa: "/d͡ʒ/"]
// dge -> d͡ʒ (judge -> d͡ʒʌd͡ʒ, bridge -> brɪd͡ʒ)
dge -> d͡ʒ;

// ============================================================
// Phase 2: GH Rules (before generic gh deletion)
// ============================================================

[id: 35, name: "gh before vowel", weight: 0.0, group: gh_rules]
// gh -> g before vowels (ghost -> gost)
gh -> g / _$VOWEL;

// ============================================================
// Phase 3: Digraph Conversions
// ============================================================

[id: 1, name: "ch digraph", weight: 0.0, group: orthography, ipa: "/t͡ʃ/"]
// ch -> t͡ʃ sound (church -> t͡ʃɜːt͡ʃ)
ch -> t͡ʃ;

[id: 2, name: "sh digraph", weight: 0.0, group: orthography, ipa: "/ʃ/"]
// sh -> ʃ sound (ship -> ʃɪp)
sh -> ʃ;

[id: 3, name: "ph to f", weight: 0.0, group: orthography]
// ph -> f (phone -> fone)
ph -> f;

// ============================================================
// Phase 4: Initial Cluster Simplifications
// ============================================================

[id: 4, name: "wr initial", weight: 0.0, group: initial_clusters]
// wr -> r at word start (write -> rite)
wr -> r / #_;

[id: 5, name: "wh initial", weight: 0.0, group: initial_clusters]
// wh -> w at word start (what -> wat)
wh -> w / #_;

[id: 6, name: "gn initial", weight: 0.0, group: initial_clusters]
// gn -> n at word start (gnome -> nome)
gn -> n / #_;

[id: 7, name: "kn initial", weight: 0.0, group: initial_clusters]
// kn -> n at word start (knife -> nife)
kn -> n / #_;

[id: 8, name: "mn initial", weight: 0.0, group: initial_clusters]
// mn -> n at word start (mnemonic -> nemonic)
mn -> n / #_;

[id: 9, name: "pt initial", weight: 0.0, group: initial_clusters]
// pt -> t at word start (pterodactyl -> terodactyl)
pt -> t / #_;

[id: 10, name: "ps initial", weight: 0.0, group: initial_clusters]
// ps -> s at word start (psychology -> sycology)
ps -> s / #_;

[id: 11, name: "tm initial", weight: 0.0, group: initial_clusters]
// tm -> m at word start (tmesis -> mesis)
tm -> m / #_;

// ============================================================
// Phase 5: X Pronunciation (compound context first)
// ============================================================

[id: 41, name: "x voiced", weight: 0.0, group: x_rules]
// x -> gz before vowel (exam -> egzam, exact -> egzact)
// Simplified: only checks right context (left context requires NFA-based matching)
x -> gz / _[:VOWEL:];

[id: 40, name: "x default", weight: 0.0, group: x_rules]
// x -> ks elsewhere (box -> boks, fix -> fiks)
x -> ks;

// ============================================================
// Phase 6: Contextual Single-Character Rules
// ============================================================

[id: 20, name: "soft c", weight: 0.0, group: orthography]
// c -> s before front vowels (city -> sity)
c -> s / _$FRONT_VOWEL;

[id: 21, name: "hard c", weight: 0.0, group: orthography]
// c -> k elsewhere (cat -> kat)
c -> k;

[id: 22, name: "soft g", weight: 0.0, group: orthography, ipa: "/d͡ʒ/"]
// g -> d͡ʒ before front vowels (gem -> d͡ʒem)
g -> d͡ʒ / _$FRONT_VOWEL;

// ============================================================
// Phase 7: Additional Orthographic Rules
// ============================================================

[id: 132, name: "ck simplify", weight: 0.0, group: orthography]
// ck -> k (back -> bak, kick -> kik)
ck -> k;

[id: 133, name: "mb final", weight: 0.0, group: orthography]
// mb -> m at word end (lamb -> lam, climb -> clim)
mb -> m / _#;

[id: 134, name: "bt silent", weight: 0.0, group: orthography]
// bt -> t (debt -> det, doubt -> dowt)
bt -> t;

[id: 135, name: "mn final", weight: 0.0, group: orthography]
// mn -> m at word end (hymn -> him, column -> colum)
mn -> m / _#;

// ============================================================
// Phase 8: Geminate (Double Consonant) Simplification
// ============================================================
// English orthographic geminates don't represent phonetic length.
// These simplify doubled consonants to single consonants.
// Weight 0.0 = no phonetic distance (purely orthographic).

[id: 80, name: "bb simplify", weight: 0.0, group: geminates]
bb -> b;

[id: 81, name: "cc simplify", weight: 0.0, group: geminates]
cc -> c;

[id: 82, name: "dd simplify", weight: 0.0, group: geminates]
dd -> d;

[id: 83, name: "ff simplify", weight: 0.0, group: geminates]
ff -> f;

[id: 84, name: "gg simplify", weight: 0.0, group: geminates, ipa: "/ɡ/"]
gg -> ɡ;

[id: 140, name: "kk simplify", weight: 0.0, group: geminates]
kk -> k;

[id: 85, name: "ll simplify", weight: 0.0, group: geminates]
ll -> l;

[id: 86, name: "mm simplify", weight: 0.0, group: geminates]
mm -> m;

[id: 87, name: "nn simplify", weight: 0.0, group: geminates]
nn -> n;

[id: 88, name: "pp simplify", weight: 0.0, group: geminates]
pp -> p;

[id: 89, name: "rr simplify", weight: 0.0, group: geminates]
rr -> r;

[id: 90, name: "ss simplify", weight: 0.0, group: geminates]
ss -> s;

[id: 91, name: "tt simplify", weight: 0.0, group: geminates]
tt -> t;

[id: 141, name: "vv simplify", weight: 0.0, group: geminates]
vv -> v;

[id: 92, name: "zz simplify", weight: 0.0, group: geminates]
zz -> z;

// ============================================================
// Phase 9: Vowel Digraph Rules (weight=0.1)
// ============================================================

[id: 50, name: "ea digraph", weight: 0.1, group: vowel_digraphs, ipa: "/iː/"]
// ea -> iː (FLEECE vowel: meat -> miːt, read -> riːd)
ea -> iː;

[id: 51, name: "ee digraph", weight: 0.1, group: vowel_digraphs, ipa: "/iː/"]
// ee -> iː (FLEECE vowel: feet -> fiːt, see -> siː)
ee -> iː;

[id: 52, name: "ai digraph", weight: 0.1, group: vowel_digraphs, ipa: "/eɪ/"]
// ai -> eɪ (FACE vowel: rain -> reɪn, wait -> weɪt)
ai -> eɪ;

[id: 53, name: "ay digraph", weight: 0.1, group: vowel_digraphs, ipa: "/eɪ/"]
// ay -> eɪ (FACE vowel: day -> deɪ, say -> seɪ)
ay -> eɪ;

// NOTE: GOAT vowels (oa, oe) moved to dialect files (american.llev uses oʊ, british.llev uses əʊ)

[id: 56, name: "ou digraph", weight: 0.1, group: vowel_digraphs, ipa: "/aʊ/"]
// ou -> aʊ (MOUTH vowel: house -> haʊse, out -> aʊt)
ou -> aʊ;

[id: 58, name: "oi digraph", weight: 0.1, group: vowel_digraphs, ipa: "/ɔɪ/"]
// oi -> ɔɪ (CHOICE vowel: coin -> kɔɪn, oil -> ɔɪl)
oi -> ɔɪ;

[id: 59, name: "ey digraph", weight: 0.1, group: vowel_digraphs, ipa: "/eɪ/"]
// ey -> eɪ (FACE vowel: they -> ðeɪ, monkey -> mʌŋkeɪ)
ey -> eɪ;

[id: 60, name: "ie digraph", weight: 0.1, group: vowel_digraphs, ipa: "/aɪ/"]
// ie -> aɪ (PRICE vowel: pie -> paɪ, tie -> taɪ)
ie -> aɪ;

[id: 61, name: "oo digraph", weight: 0.1, group: vowel_digraphs, ipa: "/uː/"]
// oo -> uː (GOOSE vowel: food -> fuːd, moon -> muːn)
oo -> uː;

[id: 62, name: "ue final", weight: 0.1, group: vowel_digraphs, ipa: "/uː/"]
// ue -> uː at word end (GOOSE vowel: blue -> bluː, true -> truː)
ue -> uː / _#;

// ============================================================
// Phase 10: Phonetic Rules (weight=0.15)
// ============================================================

// TH Voiced/Voiceless Distinction
// English TH can be voiced /ð/ or voiceless /θ/.
// Voiced /ð/ appears in:
//   - Function words: the, this, that, they, them, there, then, than, though
//   - Medial position in common words: mother, father, brother, other, weather
//   - Word-final after vowels in some words: breathe, bathe, clothe

// Function words with voiced TH (must match before general th rule)
[id: 180, name: "the word", weight: 0.10, group: th_voiced, ipa: "/ð/"]
the -> ðə / #_#;

[id: 181, name: "this word", weight: 0.10, group: th_voiced, ipa: "/ð/"]
this -> ðɪs / #_#;

[id: 182, name: "that word", weight: 0.10, group: th_voiced, ipa: "/ð/"]
that -> ðæt / #_#;

[id: 183, name: "they word", weight: 0.10, group: th_voiced, ipa: "/ð/"]
they -> ðeɪ / #_#;

[id: 184, name: "them word", weight: 0.10, group: th_voiced, ipa: "/ð/"]
them -> ðem / #_#;

[id: 185, name: "there word", weight: 0.10, group: th_voiced, ipa: "/ð/"]
there -> ðɛər / #_#;

[id: 186, name: "then word", weight: 0.10, group: th_voiced, ipa: "/ð/"]
then -> ðen / #_#;

[id: 187, name: "than word", weight: 0.10, group: th_voiced, ipa: "/ð/"]
than -> ðæn / #_#;

[id: 188, name: "these word", weight: 0.10, group: th_voiced, ipa: "/ð/"]
these -> ðiːz / #_#;

[id: 189, name: "those word", weight: 0.10, group: th_voiced, ipa: "/ð/"]
those -> ðoʊz / #_#;

[id: 190, name: "thus word", weight: 0.10, group: th_voiced, ipa: "/ð/"]
thus -> ðʌs / #_#;

[id: 191, name: "though word", weight: 0.10, group: th_voiced, ipa: "/ð/"]
though -> ðoʊ / #_#;

// Medial voiced TH patterns (common words with -ther-, -the-)
[id: 192, name: "ther medial voiced", weight: 0.10, group: th_voiced, ipa: "/ð/"]
// mother, father, brother, gather, weather, feather, leather, together
ther -> ðər;

[id: 193, name: "the medial voiced", weight: 0.10, group: th_voiced, ipa: "/ð/"]
// breathe, bathe, clothe, soothe, loathe - th before e at word end
the -> ð / [:VOWEL:]_#;

// Default: voiceless TH
[id: 100, name: "th to θ", weight: 0.15, group: phonetic, ipa: "/θ/"]
// th -> θ (thing -> θɪŋ, think -> θɪŋk, bath -> bæθ)
th -> θ;

[id: 103, name: "nk cluster", weight: 0.15, group: phonetic, ipa: "/ŋk/"]
// nk -> ŋk (think -> θɪŋk, bank -> bæŋk)
nk -> ŋk;

[id: 104, name: "ng to engma", weight: 0.15, group: phonetic, ipa: "/ŋ/"]
// ng -> ŋ (sing -> sɪŋ, ring -> rɪŋ)
ng -> ŋ;

[id: 101, name: "qu to kw", weight: 0.15, group: phonetic]
// qu -> kw (queen -> kwiːn)
qu -> kw;

[id: 102, name: "kw to qu", weight: 0.15, group: phonetic, enabled: false]
// kw -> qu (reverse, disabled to avoid cycle)
kw -> qu;

// ============================================================
// Phase 10a: Magic-E Patterns (VCe trigraphs)
// Common word endings where silent-e changes vowel quality.
// These rules fire BEFORE silent-e deletion to produce proper IPA.
// ============================================================

// igh trigraph (handles silent gh)
[id: 145, name: "igh trigraph", weight: 0.04, group: magic_e, ipa: "/aɪ/"]
igh -> aɪ;

// -one endings (phone, tone, bone, zone, cone, lone)
[id: 146, name: "one ending", weight: 0.04, group: magic_e, ipa: "/oʊn/"]
one -> oʊn / _#;

// -ine endings (pine, wine, line, fine, mine, nine)
[id: 147, name: "ine ending", weight: 0.04, group: magic_e, ipa: "/aɪn/"]
ine -> aɪn / _#;

// -ane endings (plane, lane, sane, cane, mane)
[id: 148, name: "ane ending", weight: 0.04, group: magic_e, ipa: "/eɪn/"]
ane -> eɪn / _#;

// -ate endings (late, fate, gate, rate, mate, date)
[id: 149, name: "ate ending", weight: 0.04, group: magic_e, ipa: "/eɪt/"]
ate -> eɪt / _#;

// -ite endings (site, bite, kite, mite, white)
[id: 150, name: "ite ending", weight: 0.04, group: magic_e, ipa: "/aɪt/"]
ite -> aɪt / _#;

// -ote endings (note, vote, dote, quote)
[id: 151, name: "ote ending", weight: 0.04, group: magic_e, ipa: "/oʊt/"]
ote -> oʊt / _#;

// -ome endings (home, dome, Rome)
[id: 152, name: "ome ending", weight: 0.04, group: magic_e, ipa: "/oʊm/"]
ome -> oʊm / _#;

// -ake endings (make, take, lake, cake, wake, sake)
[id: 153, name: "ake ending", weight: 0.04, group: magic_e, ipa: "/eɪk/"]
ake -> eɪk / _#;

// -ike endings (like, bike, hike, mike, pike)
[id: 154, name: "ike ending", weight: 0.04, group: magic_e, ipa: "/aɪk/"]
ike -> aɪk / _#;

// -oke endings (poke, joke, woke, smoke, broke)
[id: 155, name: "oke ending", weight: 0.04, group: magic_e, ipa: "/oʊk/"]
oke -> oʊk / _#;

// -ose endings (nose, rose, close, those, chose)
[id: 156, name: "ose ending", weight: 0.04, group: magic_e, ipa: "/oʊz/"]
ose -> oʊz / _#;

// -ase endings (base, case, chase, phase)
[id: 157, name: "ase ending", weight: 0.04, group: magic_e, ipa: "/eɪs/"]
ase -> eɪs / _#;

// -use endings (use, fuse, muse)
[id: 158, name: "use ending", weight: 0.04, group: magic_e, ipa: "/uːz/"]
use -> uːz / _#;

// -ule endings (rule, mule)
[id: 159, name: "ule ending", weight: 0.04, group: magic_e, ipa: "/uːl/"]
ule -> uːl / _#;

// -ace endings (face, race, pace, place, space)
[id: 160, name: "ace ending", weight: 0.04, group: magic_e, ipa: "/eɪs/"]
ace -> eɪs / _#;

// -ice endings (nice, rice, price, twice, slice)
[id: 161, name: "ice ending", weight: 0.04, group: magic_e, ipa: "/aɪs/"]
ice -> aɪs / _#;

// -ive endings (five, hive, dive, drive)
[id: 162, name: "ive ending", weight: 0.04, group: magic_e, ipa: "/aɪv/"]
ive -> aɪv / _#;

// -ode endings (code, mode, node)
[id: 163, name: "ode ending", weight: 0.04, group: magic_e, ipa: "/oʊd/"]
ode -> oʊd / _#;

// -ide endings (side, wide, ride, hide, guide)
[id: 164, name: "ide ending", weight: 0.04, group: magic_e, ipa: "/aɪd/"]
ide -> aɪd / _#;

// -ade endings (made, fade, shade, grade, trade)
[id: 165, name: "ade ending", weight: 0.04, group: magic_e, ipa: "/eɪd/"]
ade -> eɪd / _#;

// -ime endings (time, dime, lime, crime, prime)
[id: 166, name: "ime ending", weight: 0.04, group: magic_e, ipa: "/aɪm/"]
ime -> aɪm / _#;

// -ame endings (name, game, same, flame, shame)
[id: 167, name: "ame ending", weight: 0.04, group: magic_e, ipa: "/eɪm/"]
ame -> eɪm / _#;

// -ope endings (hope, rope, scope, slope)
[id: 168, name: "ope ending", weight: 0.04, group: magic_e, ipa: "/oʊp/"]
ope -> oʊp / _#;

// -ipe endings (pipe, ripe, wipe, stripe)
[id: 169, name: "ipe ending", weight: 0.04, group: magic_e, ipa: "/aɪp/"]
ipe -> aɪp / _#;

// -ape endings (tape, cape, shape, grape)
[id: 170, name: "ape ending", weight: 0.04, group: magic_e, ipa: "/eɪp/"]
ape -> eɪp / _#;

// -ore endings (more, core, store)
[id: 171, name: "ore ending", weight: 0.04, group: magic_e, ipa: "/ɔːr/"]
ore -> ɔːr / _#;

// -ire endings (fire, wire, hire, tire)
[id: 172, name: "ire ending", weight: 0.04, group: magic_e, ipa: "/aɪr/"]
ire -> aɪr / _#;

// -are endings (care, rare, share)
[id: 173, name: "are ending", weight: 0.04, group: magic_e, ipa: "/ɛər/"]
are -> ɛər / _#;

// -ure endings (pure, cure)
[id: 174, name: "ure ending", weight: 0.04, group: magic_e, ipa: "/jʊər/"]
ure -> jʊər / _#;

// ============================================================
// Phase 11: Default/Fallback Rules (LOW PRIORITY)
// These apply after all specific patterns have been matched
// ============================================================

[id: 33, name: "silent final e", weight: 0.0, group: orthography]
// Final e is often silent - only applies to words not matched by VCe rules
e -> / _#;

[id: 34, name: "silent gh", weight: 0.0, group: orthography]
// gh is silent (catch-all after igh trigraph rule)
// Examples: through -> thru
gh -> ;

// ============================================================
// Test Rules (DISABLED - for verification only)
// ============================================================

[id: 200, name: "x expansion", weight: 0.0, group: test, enabled: false]
x -> yy;

[id: 201, name: "y to z", weight: 0.0, group: test, enabled: false]
y -> z;
