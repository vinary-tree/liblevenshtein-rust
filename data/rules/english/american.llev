nuclear -> nuːkliːəɹ;

[id: 527, name: "yod-drop newt", weight: 0.2, group: american_yod, ipa: "/nuːt/"]
newt -> nuːt;

// After S
[id: 530, name: "yod-drop suit", weight: 0.2, group: american_yod, ipa: "/suːt/"]
suit -> suːt;

[id: 531, name: "yod-drop sue", weight: 0.2, group: american_yod, ipa: "/suː/"]
sue -> suː;

[id: 532, name: "yod-drop super", weight: 0.2, group: american_yod, ipa: "/suːpəɹ/"]
super -> suːpəɹ;

