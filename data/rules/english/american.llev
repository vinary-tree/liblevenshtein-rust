// American English Phonetic Rules
// ================================
// Dialect-specific rules for American English phonetic transformations.
// These rules layer on top of the shared base rules.
//
// Key American English Features:
//   - Yod-dropping: No /j/ sound after alveolar consonants (t, d, n, s, z, l)
//     Examples: tune -> toon, new -> noo, dune -> doon
//   - T-flapping: Intervocalic /t/ becomes a flap sound (like /d/)
//     Examples: water -> wader, butter -> budder
//   - Rhotic: All Rs are pronounced (no r-dropping)

@name "American English Dialect Rules"
@version "2.0.0"
@author "liblevenshtein"
@description "Dialect-specific phonetic rules for American English"

// Import the shared base rules
@include "english/base.llev"

// ============================================================
// Symbol Definitions
// ============================================================

@define VOWEL = [aeiou]
@define CONSONANT = [bcdfghjklmnpqrstvwxyz]
@define ALVEOLAR = [tdnszl]

// ============================================================
// GA VOWEL PATTERNS (Dialect-Specific)
// ============================================================
// These rules were moved from zompist.llev because GA and RP
// have different vowel qualities for these patterns.

// GOAT vowel class - GA uses /oʊ/
[id: 400, name: "oa digraph GA", weight: 0.1, group: american_goat, ipa: "/oʊ/"]
// oa -> oʊ (boat -> boʊt, road -> roʊd)
oa -> oʊ;

[id: 401, name: "oe digraph GA", weight: 0.1, group: american_goat, ipa: "/oʊ/"]
// oe -> oʊ (toe -> toʊ, foe -> foʊ)
oe -> oʊ;

// OUGH patterns - GA specific
[id: 410, name: "through pattern GA", weight: 0.0, group: american_ough, ipa: "/θɹuː/"]
// through -> θɹuː (rhymes with "threw")
through -> θɹuː / #_#;

[id: 411, name: "rough ending GA", weight: 0.0, group: american_ough, ipa: "/ʌf/"]
// rough -> ɹʌf, tough -> tʌf (STRUT vowel)
ough -> ʌf / [rt]_;

[id: 412, name: "enough pattern GA", weight: 0.0, group: american_ough, ipa: "/ɪnʌf/"]
// enough -> ɪnʌf
enough -> ɪnʌf / #_#;

[id: 413, name: "cough pattern GA", weight: 0.0, group: american_ough, ipa: "/kɑf/"]
// cough -> kɑf (THOUGHT-LOT merger: uses /ɑ/)
cough -> kɑf / #_#;

[id: 414, name: "ough pattern GA", weight: 0.0, group: american_ough, ipa: "/oʊ/"]
// ough -> oʊ (dough -> doʊ, though -> ðoʊ) - GOAT vowel
ough -> oʊ;

[id: 415, name: "aught pattern GA", weight: 0.0, group: american_ough, ipa: "/ɑt/"]
// aught -> ɑt (caught -> kɑt, daughter -> dɑtəɹ) - THOUGHT-LOT merger
aught -> ɑt;

[id: 416, name: "ought pattern GA", weight: 0.0, group: american_ough, ipa: "/ɑt/"]
// ought -> ɑt (bought -> bɑt, thought -> θɑt) - THOUGHT-LOT merger
ought -> ɑt;

// Rhoticity - GA preserves /ɹ/ in all positions
[id: 420, name: "r to ɹ GA", weight: 0.3, group: american_rhotic, ipa: "/ɹ/"]
// r -> ɹ (car -> kɑɹ, better -> bɛtəɹ)
r -> ɹ;

// ============================================================
// YOD-DROPPING RULES (American English)
// ============================================================
// In American English, the /j/ (yod) sound is dropped after
// alveolar consonants: t, d, n, s, z, l
// British English preserves this sound.
//
// Pattern-based rules (consolidated from 55 word-specific rules):
// The pattern captures alveolar + u → alveolar + uː (yod dropped)

// After T: tu → tuː (tune, tube, tulip, etc.)
[id: 500, name: "yod-drop after t", weight: 0.2, group: american_yod, ipa: "/tuː/"]
tu -> tuː / #_;

// After D: du/dew → duː (dune, due, duke, etc.)
[id: 510, name: "yod-drop after d (du)", weight: 0.2, group: american_yod, ipa: "/duː/"]
du -> duː / #_;

[id: 511, name: "yod-drop dew", weight: 0.2, group: american_yod, ipa: "/duː/"]
dew -> duː;

// After N: new/nu → nuː (new, news, nude, nuclear, etc.)
[id: 520, name: "yod-drop new", weight: 0.2, group: american_yod, ipa: "/nuː/"]
new -> nuː;

[id: 521, name: "yod-drop after n (nu)", weight: 0.2, group: american_yod, ipa: "/nuː/"]
nu -> nuː / #_;

// After S: su → suː (suit, sue, super, etc.)
[id: 530, name: "yod-drop after s", weight: 0.2, group: american_yod, ipa: "/suː/"]
su -> suː / #_;

// After S medial: -sume patterns (assume, presume, consume, resume)
[id: 531, name: "yod-drop medial sume", weight: 0.2, group: american_yod, ipa: "/suːm/"]
sume -> suːm;

// After L: lu → luː (lute, lunar, lure, etc.)
[id: 540, name: "yod-drop after l", weight: 0.2, group: american_yod, ipa: "/luː/"]
lu -> luː / #_;

// After L medial: -luminate pattern (illuminate)
[id: 541, name: "yod-drop medial luminate", weight: 0.2, group: american_yod, ipa: "/luːmɪneɪt/"]
luminate -> luːmɪneɪt;

// After Z: zu → zuː (Zeus)
[id: 550, name: "yod-drop after z", weight: 0.2, group: american_yod, ipa: "/zuː/"]
zu -> zuː / #_;

// After Z medial: -zume pattern (resume)
[id: 551, name: "yod-drop medial zume", weight: 0.2, group: american_yod, ipa: "/zuːm/"]
zume -> zuːm;

// ============================================================
// T-FLAPPING RULES (American English)
// ============================================================
// In American English, intervocalic /t/ becomes a flap (sounds like /d/)
// This occurs between vowels, especially in unstressed syllables.
//
// Pattern-based rules (consolidated from 40 word-specific rules):
// - Double 'tt' between vowels → 'dd' (butter→budder)
// - Single 't' between vowels → 'd' (water→wader)
// - 't' before 'y' after vowel → 'd' (city→sidy)
// - 't' before 'le' after vowel → 'd' (little→liddle)

// Double T flapping: VttV → VddV
// Examples: butter, better, letter, matter, bitter, hotter, patter, scatter
[id: 560, name: "t-flap double tt intervocalic", weight: 0.25, group: american_flapping, ipa: "/ɾɾ/"]
tt -> dd / [aeiou]_[aeiou];

// Double T flapping before y: Vtty → Vddy
// Examples: pretty, kitty, fatty, patty
[id: 561, name: "t-flap double tt before y", weight: 0.25, group: american_flapping, ipa: "/ɾɾ/"]
tty -> ddy / [aeiou]_;

// Single T flapping: VtV → VdV
// Examples: water, later, eater, meter, atom, item
[id: 562, name: "t-flap single t intervocalic", weight: 0.25, group: american_flapping, ipa: "/ɾ/"]
t -> d / [aeiou]_[aeiou];

// T flapping before -ing: VtingV → VdingV
// Examples: eating, meeting, waiting, writing, putting, hitting, getting, setting
[id: 563, name: "t-flap before -ing", weight: 0.25, group: american_flapping, ipa: "/ɾ/"]
ting -> ding / [aeiou]_;

// T flapping before y: Vty → Vdy
// Examples: city, pity
[id: 564, name: "t-flap before y", weight: 0.25, group: american_flapping, ipa: "/ɾ/"]
ty -> dy / [aeiou]_;

// T flapping in -tle patterns: Vtle → Vdle
// Examples: little, bottle, metal (though metal is -tal not -tle)
[id: 565, name: "t-flap in -ttle", weight: 0.25, group: american_flapping, ipa: "/ɾl̩/"]
ttle -> ddle / [aeiou]_;

[id: 566, name: "t-flap in -tal", weight: 0.25, group: american_flapping, ipa: "/ɾəl/"]
tal -> dal / [aeiou]_;

// T flapping in -tom/-tem patterns: atom, item
[id: 567, name: "t-flap in -tom", weight: 0.25, group: american_flapping, ipa: "/ɾəm/"]
tom -> dom / [aeiou]_;

[id: 568, name: "t-flap in -tem", weight: 0.25, group: american_flapping, ipa: "/ɾəm/"]
tem -> dem / [aeiou]_;

// T flapping in -ograph pattern: photograph, autograph
[id: 569, name: "t-flap in -tograph", weight: 0.25, group: american_flapping, ipa: "/ɾ/"]
tograph -> dograph / [aeiou]_;

// T flapping in -tomatic pattern: automatic
[id: 570, name: "t-flap in -tomatic", weight: 0.25, group: american_flapping, ipa: "/ɾ/"]
tomatic -> domatic / [aeiou]_;

// T flapping in Saturday (special case: a-tu-r-day)
[id: 571, name: "t-flap saturday", weight: 0.25, group: american_flapping, ipa: "/sæɾəɹdeɪ/"]
saturday -> sadurday;
