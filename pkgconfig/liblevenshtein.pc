prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: liblevenshtein
Description: Fast spelling correction and fuzzy search with Levenshtein automata
Version: 4.0.0-rc.6
Requires: vinary-tree-interop = 4.0.0-rc.6
Libs: -L${libdir} -lliblevenshtein
Libs.private: -ldl -lpthread -lm
Cflags: -I${includedir}
