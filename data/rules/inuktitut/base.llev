// Inuktitut Base Phonetic Rules
// =============================
// Phonetic rules for Inuktitut (ᐃᓄᒃᑎᑐᑦ).
// Spoken by approximately 35,000 people in Nunavut and other Canadian territories.
//
// Inuktitut features:
//   - Canadian Aboriginal Syllabics writing system
//   - Also written in Inuktitut Latin orthography (qaliujaaqpait)
//   - Uvular consonants: q, ɢ (voiced uvular), ʁ (uvular fricative)
//   - Three vowels: i, u, a with phonemic length distinction
//   - Phonemic gemination (double consonants)
//   - Complex consonant clusters
//   - Polysynthetic morphology
//
// Writing systems:
//   - Inuktitut syllabics (ᐃᓄᒃᑎᑐᑦ)
//   - Latin orthography: vowels a, i, u; long vowels aa, ii, uu
//   - Unique letters: ł (voiceless lateral fricative in some dialects)
//
// Rule IDs: 8600-8799

@name "Inuktitut Phonetic Rules"
@version "1.0.1"
@author "liblevenshtein"
@description "Phonetic normalization rules for Inuktitut (Eastern Canadian Inuktitut)"

// CHANGELOG (v1.0.1):
// - Removed all identity mappings where pattern equals replacement
// - Kept only actual phonetic transformations (e.g., ng->ŋ, y->j, long vowels, geminates)
// - Kept all syllabics-to-Latin conversions and IPA normalizations

// ============================================================
// SHORT VOWELS
// NOTE: All identity mappings (i->i, u->u, a->a) removed in v1.0.1
// Only transformations are retained.
// ============================================================

// ============================================================
// LONG VOWELS (weight 0.05)
// Marked by doubling in Latin orthography
// ============================================================

[id: 8605, name: "ii long", weight: 0.05, group: inuktitut_long_vowels, ipa: "/iː/"]
ii -> iː;

[id: 8606, name: "uu long", weight: 0.05, group: inuktitut_long_vowels, ipa: "/uː/"]
uu -> uː;

[id: 8607, name: "aa long", weight: 0.05, group: inuktitut_long_vowels, ipa: "/aː/"]
aa -> aː;

// ============================================================
// STOPS
// NOTE: Identity mappings (p->p, t->t, k->k, q->q) removed in v1.0.1
// Only transformations are retained.
// ============================================================

// Voiced stops (in some dialects/loanwords)
[id: 8614, name: "g", weight: 0.05, group: inuktitut_stops, ipa: "/ɡ/"]
g -> ɡ;

// ============================================================
// FRICATIVES (weight 0.05)
// NOTE: Identity mappings (s->s, v->v, h->h) removed in v1.0.1
// Only transformations are retained.
// ============================================================

// Uvular fricative (voiced)
[id: 8623, name: "r uvular fricative", weight: 0.05, group: inuktitut_fricatives, ipa: "/ʁ/"]
r -> ʁ;

// Voiceless lateral fricative (some dialects)
[id: 8624, name: "l-slash voiceless lateral", weight: 0.05, group: inuktitut_fricatives, ipa: "/ɬ/"]
ł -> ɬ;

// ============================================================
// NASALS (weight 0.05)
// NOTE: Identity mappings (m->m, n->n, ŋ->ŋ) removed in v1.0.1
// Only transformations are retained.
// ============================================================

[id: 8632, name: "ng velar nasal", weight: 0.05, group: inuktitut_nasals, ipa: "/ŋ/"]
ng -> ŋ;

// ============================================================
// LIQUIDS AND APPROXIMANTS (weight 0.05)
// NOTE: Identity mappings (l->l, j->j) removed in v1.0.1
// Only transformations are retained.
// ============================================================

// Alternative y spelling
[id: 8642, name: "y approx alt", weight: 0.05, group: inuktitut_approximants, ipa: "/j/"]
y -> j;

// ============================================================
// GEMINATE CONSONANTS (weight 0.05)
// Phonemic in Inuktitut - represented with doubled letters
// ============================================================

[id: 8650, name: "pp geminate", weight: 0.05, group: inuktitut_geminates, ipa: "/pː/"]
pp -> pː;

[id: 8651, name: "tt geminate", weight: 0.05, group: inuktitut_geminates, ipa: "/tː/"]
tt -> tː;

[id: 8652, name: "kk geminate", weight: 0.05, group: inuktitut_geminates, ipa: "/kː/"]
kk -> kː;

[id: 8653, name: "qq geminate", weight: 0.05, group: inuktitut_geminates, ipa: "/qː/"]
qq -> qː;

[id: 8654, name: "mm geminate", weight: 0.05, group: inuktitut_geminates, ipa: "/mː/"]
mm -> mː;

[id: 8655, name: "nn geminate", weight: 0.05, group: inuktitut_geminates, ipa: "/nː/"]
nn -> nː;

[id: 8656, name: "ll geminate", weight: 0.05, group: inuktitut_geminates, ipa: "/lː/"]
ll -> lː;

[id: 8657, name: "ss geminate", weight: 0.05, group: inuktitut_geminates, ipa: "/sː/"]
ss -> sː;

[id: 8658, name: "vv geminate", weight: 0.05, group: inuktitut_geminates, ipa: "/vː/"]
vv -> vː;

[id: 8659, name: "rr geminate", weight: 0.05, group: inuktitut_geminates, ipa: "/ʁː/"]
rr -> ʁː;

[id: 8660, name: "jj geminate", weight: 0.05, group: inuktitut_geminates, ipa: "/jː/"]
jj -> jː;

// ============================================================
// INUKTITUT SYLLABICS - I series (ᐃ)
// ============================================================

[id: 8670, name: "syllabic i", weight: 0.05, group: inuktitut_syllabics, ipa: "/i/"]
ᐃ -> i;

[id: 8671, name: "syllabic pi", weight: 0.05, group: inuktitut_syllabics, ipa: "/pi/"]
ᐱ -> pi;

[id: 8672, name: "syllabic ti", weight: 0.05, group: inuktitut_syllabics, ipa: "/ti/"]
