@startuml
' Immutable-candidate recovery protocol exercised by RC.1 through RC.4.
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam sequence {
  ArrowColor #37474F
  ActorBorderColor #37474F
  LifeLineBorderColor #78909C
  LifeLineBackgroundColor #ECEFF1
  ParticipantBorderColor #37474F
  ParticipantFontColor #102027
}

title Immutable candidate recovery after a rejected prerelease

actor "Release operator" as OP #FFF9C4
participant "npm registry\nimmutable RC.1" as NPM1 #FFCDD2
participant "Fresh consumer\ninstalled bytes" as CONSUMER #FFE0B2
participant "Source repair\ncommit 75dc2cc" as SOURCE #C8E6C9
participant "Next-candidate validation\nand publication" as NEXT #BBDEFB
database "Append-only\nevidence ledger" as LEDGER #D1C4E9

OP -> NPM1 : publish facade with provenance
NPM1 --> OP : immutable 4.0.0-rc.1 coordinate
OP -> CONSUMER : install exact public package
CONSUMER --> OP : traversal fails: cursor.close absent
OP -> LEDGER : record run, integrity, and rejection
OP -> SOURCE : adapt to next + Symbol.dispose protocol
SOURCE --> OP : local packed-byte CJS/ESM smokes pass
OP -> NEXT : synchronize full train; mint new tag
NEXT -> CONSUMER : install exact public candidate bytes
alt installed contracts pass
  CONSUMER --> NEXT : CRUD, traversal, batching, disposal pass
  NEXT -> LEDGER : record digest and proof
  NEXT --> OP : downstream publication may resume
else any installed contract fails
  CONSUMER --> NEXT : reject candidate
  NEXT -> LEDGER : append failure; never overwrite bytes
  NEXT --> OP : advance to next unused candidate
end

legend right
  |= Color |= Meaning |
  |<#FFCDD2>| rejected immutable artifact |
  |<#FFE0B2>| registry-shaped consumer proof |
  |<#C8E6C9>| corrective source |
  |<#BBDEFB>| new candidate boundary |
  |<#D1C4E9>| durable evidence |
endlegend
@enduml
