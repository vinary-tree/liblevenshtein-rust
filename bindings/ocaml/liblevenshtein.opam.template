opam-version: "2.0"
synopsis: "Fast spelling correction and fuzzy search with Levenshtein automata"
description: "A high-performance library for spelling correction, fuzzy dictionary search, and phonetic matching using Levenshtein and related finite-state automata."
maintainer: "Dylon Edwards <dylon.devo@gmail.com>"
authors: ["Dylon Edwards <dylon.devo@gmail.com>"]
license: "Apache-2.0"
homepage: "https://github.com/vinary-tree/liblevenshtein-rust"
bug-reports: "https://github.com/vinary-tree/liblevenshtein-rust/issues"
dev-repo: "git+https://github.com/vinary-tree/liblevenshtein-rust.git"
depends: [
  "ocaml" {>= "5.2"}
  "dune" {>= "3.20"}
  "conf-pkg-config" {build}
  "vinary-tree-interop" {= "4.0.0~rc6"}
  "libdictenstein" {with-test & = "4.0.0~rc6"}
  "odoc" {with-doc}
]
build: [
  ["pkg-config" "--atleast-version=4.0.0-rc.6" "liblevenshtein"]
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
x-maintenance-intent: ["(latest)"]
