[id: 13962, name: "श sha", weight: 0.05, group: nepali_fricatives, ipa: "/ʃʌ/"]
श -> ʃʌ;

[id: 13963, name: "ष ṣa retroflex", weight: 0.05, group: nepali_fricatives, ipa: "/ʂʌ/"]
