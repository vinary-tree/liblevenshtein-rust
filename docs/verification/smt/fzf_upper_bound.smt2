; Cross-solver counterexample checks for the fzf local-alignment bound.
(set-logic QF_LIA)
(define-fun max2 ((a Int) (b Int)) Int (ite (>= a b) a b))

(push)
(declare-const exact Int)
(declare-const unstarted Int)
(declare-const active Int)
(assert (<= exact unstarted))
(assert (> exact (max2 unstarted active)))
(check-sat)
(pop)

(push)
(declare-const exact Int)
(declare-const unstarted Int)
(declare-const active Int)
(assert (<= exact active))
(assert (> exact (max2 unstarted active)))
(check-sat)
(pop)

(push)
(declare-const exact Int)
(declare-const unstarted Int)
(declare-const active Int)
(declare-const cutoff Int)
(assert (or (<= exact unstarted) (<= exact active)))
(assert (< (max2 unstarted active) cutoff))
(assert (>= exact cutoff))
(check-sat)
(pop)

(push)
(declare-const initial Int)
(declare-const middle Int)
(declare-const final-score Int)
(assert (not (= (+ initial (- middle initial) (- final-score middle)) final-score)))
(check-sat)
(pop)

(push)
(assert (not (and (< 10 20) (<= 20 (max2 20 10)))))
(check-sat)
(pop)
