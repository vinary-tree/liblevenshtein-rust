@startuml lockstep-dfs-sequence
' The transducer ∩ dictionary intersection as a single lock-step DFS: the
' query iterator advances the automaton in step with each dictionary edge,
' pruning the instant the automaton state becomes empty.
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam sequence {
  ArrowColor #37474F
  LifeLineBorderColor #455A64
  ParticipantBorderColor #1565C0
  ParticipantBackgroundColor #BBDEFB
  ParticipantFontColor #102027
}

title Transducer <latex>\cap</latex> Dictionary — one shared lock-step depth-first walk

participant "QueryIterator" as Q #BBDEFB
participant "DictionaryNode\ntrie / DAWG" as D #C8E6C9
participant "Transition  <latex>\delta\chi</latex>" as S #E3F2FD
participant "Subsumption" as Sub #E3F2FD

Q -> D : edges() → (symbol x, child)
loop each edge (x, child)
  Q -> S : <latex>\chi</latex> = char_vector(x, W);  <latex>q' = \delta\chi(q)</latex>
  S -> Sub : reduce(q')
  Sub --> S : minimal q'
  alt q' is empty
    S --> Q : <latex>\emptyset</latex>
    note over Q #FFCDD2: prune — do NOT descend child
  else q' non-empty
    Q -> D : descend into child (push frame)
    opt child terminal <latex>\land</latex> q' accepting
      Q -[#2E7D32]-> Q : emit (term, distance)
    end
  end
end
@enduml
