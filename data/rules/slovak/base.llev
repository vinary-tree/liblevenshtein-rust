[id: 3438, name: "j consonant", weight: 0.2, group: slovak_consonants, ipa: "/j/"]
j -> j;

[id: 3439, name: "J consonant", weight: 0.2, group: slovak_consonants, ipa: "/j/"]
J -> j;

[id: 3440, name: "k consonant", weight: 0.2, group: slovak_consonants]
k -> k;

[id: 3441, name: "K consonant", weight: 0.2, group: slovak_consonants]
K -> k;

[id: 3442, name: "l consonant", weight: 0.2, group: slovak_consonants]
l -> l;

[id: 3443, name: "L consonant", weight: 0.2, group: slovak_consonants]
L -> l;

[id: 3444, name: "m consonant", weight: 0.2, group: slovak_consonants]
m -> m;

[id: 3445, name: "M consonant", weight: 0.2, group: slovak_consonants]
M -> m;

[id: 3446, name: "n consonant", weight: 0.2, group: slovak_consonants]
n -> n;

[id: 3447, name: "N consonant", weight: 0.2, group: slovak_consonants]
