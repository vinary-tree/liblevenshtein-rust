[id: 13948, name: "प pa", weight: 0.05, group: nepali_labials, ipa: "/pʌ/"]
प -> pʌ;

[id: 13949, name: "फ pha", weight: 0.05, group: nepali_labials, ipa: "/pʰʌ/"]
