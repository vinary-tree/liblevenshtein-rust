{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "liblevenshtein",
  "author": {
    "name": "Dylon Edwards",
    "email": "dylon.devo@gmail.com"
  },
  "organization": {
    "github": "vinary-tree",
    "npmScope": "vinary-tree",
    "mavenGroup": "io.vinarytree",
    "javaPackage": "io.vinarytree.liblevenshtein",
    "fpmNamespace": "vinary-tree"
  },
  "interop": {
    "crate": "vinary-tree-interop",
    "cPrefix": "vt_",
    "cHeader": "vinary_tree_interop.h",
    "npm": "@vinary-tree/vinary-tree-interop",
    "maven": "io.vinarytree:vinary-tree-interop",
    "javaPackage": "io.vinarytree.interop",
    "resourceLayout": [
      "context",
      "vtable"
    ],
    "dictionaryInterfaceVersion": 1,
    "dictionaryVisitInterfaceVersion": 1,
    "dictionaryGraphInterfaceVersion": 1,
    "dictionaryEntriesInterfaceVersion": 1,
    "snapshotIdentityInterfaceVersion": 1,
    "scalarWfstInterfaceVersion": 1,
    "dictionaryEntries": {
      "interfaceId": "vt.dict.entry.v1",
      "statusValues": {
        "OK": 0,
        "END": 1,
        "INVALID_ARGUMENT": 2,
        "NULL_POINTER": 3,
        "UNSUPPORTED": 4,
        "IO_ERROR": 5,
        "CLOSED": 6,
        "LIMIT_EXCEEDED": 7,
        "PROVIDER_ERROR": 8,
        "BATCH_IN_USE": 9
      },
      "orderValues": {
        "LEXICOGRAPHIC": 1
      },
      "infoFlags": {
        "EXACT_LEN": 1,
        "SNAPSHOT_IDENTITY": 2
      },
      "vtableOperations": [
        "open",
        "next_batch",
        "release_batch",
        "reduce",
        "cancel",
        "close"
      ],
      "layouts": {
        "lp64": {
          "pointerWidth": 64,
          "types": {
            "VtDictionaryEntry": {
              "size": 40,
              "alignment": 8,
              "offsets": {
                "unit_offset": 0,
                "unit_len": 8,
                "value_offset": 16,
                "value_len": 24,
                "reserved": 32
              }
            },
            "VtDictionaryEntryBatchLimits": {
              "size": 32,
              "alignment": 8,
              "offsets": {
                "max_entries": 0,
                "max_units": 8,
                "max_values": 16,
                "reserved": 24
              }
            },
            "VtDictionaryEntryBatchView": {
              "size": 64,
              "alignment": 8,
              "offsets": {
                "entries": 0,
                "entry_count": 8,
                "units": 16,
                "unit_count": 24,
                "values": 32,
                "value_count": 40,
                "generation": 48,
                "reserved": 56
              }
            },
            "VtDictionaryEntriesInfo": {
              "size": 64,
              "alignment": 8,
              "offsets": {
                "unit_domain": 0,
                "value_domain": 4,
                "order": 8,
                "reserved0": 12,
                "flags": 16,
                "exact_len": 24,
                "identity": 32,
                "reserved": 48
              }
            },
            "VtDictionaryEntriesCursor": {
              "size": 16,
              "alignment": 8,
              "offsets": {
                "context": 0,
                "vtable": 8
              }
            },
            "VtDictionaryEntriesVTable": {
              "size": 64,
              "alignment": 8,
              "offsets": {
                "struct_size": 0,
                "interface_version": 8,
                "reserved": 12,
                "open": 16,
                "next_batch": 24,
                "release_batch": 32,
                "reduce": 40,
                "cancel": 48,
                "close": 56
              }
            }
          }
        },
        "arm32": {
          "pointerWidth": 32,
          "types": {
            "VtDictionaryEntry": {
              "size": 24,
              "alignment": 8,
              "offsets": {
                "unit_offset": 0,
                "unit_len": 4,
                "value_offset": 8,
                "value_len": 12,
                "reserved": 16
              }
            },
            "VtDictionaryEntryBatchLimits": {
              "size": 24,
              "alignment": 8,
              "offsets": {
                "max_entries": 0,
                "max_units": 4,
                "max_values": 8,
                "reserved": 16
              }
            },
            "VtDictionaryEntryBatchView": {
              "size": 40,
              "alignment": 8,
              "offsets": {
                "entries": 0,
                "entry_count": 4,
                "units": 8,
                "unit_count": 12,
                "values": 16,
                "value_count": 20,
                "generation": 24,
                "reserved": 32
              }
            },
            "VtDictionaryEntriesInfo": {
              "size": 64,
              "alignment": 8,
              "offsets": {
                "unit_domain": 0,
                "value_domain": 4,
                "order": 8,
                "reserved0": 12,
                "flags": 16,
                "exact_len": 24,
                "identity": 32,
                "reserved": 48
              }
            },
            "VtDictionaryEntriesCursor": {
              "size": 8,
              "alignment": 4,
              "offsets": {
                "context": 0,
                "vtable": 4
              }
            },
            "VtDictionaryEntriesVTable": {
              "size": 36,
              "alignment": 4,
              "offsets": {
                "struct_size": 0,
                "interface_version": 4,
                "reserved": 8,
                "open": 12,
                "next_batch": 16,
                "release_batch": 20,
                "reduce": 24,
                "cancel": 28,
                "close": 32
              }
            }
          }
        }
      }
    }
  },
  "packages": {
    "pypi": "liblevenshtein",
    "npm": "@vinary-tree/liblevenshtein",
    "maven": "io.vinarytree:liblevenshtein",
    "clojars": "io.vinarytree/liblevenshtein-clojure",
    "nuget": "Liblevenshtein",
    "goModule": "github.com/vinary-tree/liblevenshtein-rust/bindings/go/v4",
    "swift": "Liblevenshtein",
    "rubygems": "liblevenshtein",
    "fpm": "liblevenshtein",
    "opam": "liblevenshtein",
    "hackage": "liblevenshtein",
    "luarocks": "liblevenshtein"
  },
  "supportTiers": {
    "tier1": [
      "c",
      "cpp",
      "python",
      "jvm",
      "clojure",
      "javascript",
      "typescript",
      "clojurescript"
    ],
    "tier2": [
      "dotnet",
      "go",
      "swift",
      "ruby",
      "fortran"
    ],
    "tier3": [
      "ocaml",
      "haskell",
      "lua"
    ]
  },
  "packageVersion": "4.0.0-rc.5",
  "abiVersion": 1,
  "apiRevision": 2,
  "defaultMatchBatch": 256,
  "snapshot": {
    "boundary": "query-start",
    "revision": "immutable-resource",
    "captureComplexity": "O(1)",
    "cursorMayOutliveSource": true
  },
  "marshalling": {
    "resourceHandoff": "O(1)-retained-two-word-resource",
    "nativeHotPathSerialization": false,
    "nodeExpansion": "batched-contiguous-edges",
    "results": "leased-descriptors-and-contiguous-term-arenas",
    "managedExpertPath": "zero-copy-batch-reducer",
    "customProviderDefault": "serialized-caller-thread",
    "customProviderOptIn": "parallel-reentrant",
    "wfstHandoff": "O(1)-retained-two-word-resource",
    "wfstComposition": "retained-snapshots-and-lazy-product-states",
    "wfstExpansion": "one-batched-state-and-paged-contiguous-arcs"
  },
  "unitDomains": {
    "BYTE": 1,
    "UNICODE_SCALAR": 2,
    "U64": 3
  },
  "valueDomains": {
    "UNIT": 0,
    "OPTIONAL_U64": 1,
    "BYTES_RESERVED": 2
  },
  "enums": {
    "status": {
      "cType": "LlevStatus",
      "cPrefix": "LLEV_STATUS_",
      "values": {
        "OK": 0,
        "END": 1,
        "INVALID_ARGUMENT": 2,
        "INVALID_UTF8": 3,
        "NULL_POINTER": 4,
        "PANIC": 5,
        "UNSUPPORTED": 6,
        "IO_ERROR": 7,
        "CLOSED": 8,
        "LIMIT_EXCEEDED": 9,
        "PROVIDER_ERROR": 10,
        "BATCH_IN_USE": 11,
        "DOMAIN_MISMATCH": 12
      }
    },
    "algorithm": {
      "cType": "LlevAlgorithm",
      "cPrefix": "LLEV_ALGORITHM_",
      "values": {
        "STANDARD": 0,
        "TRANSPOSITION": 1,
        "MERGE_AND_SPLIT": 2,
        "DAMERAU_LEVENSHTEIN": 3
      }
    },
    "queryOrder": {
      "cType": "LlevQueryOrder",
      "cPrefix": "LLEV_QUERY_ORDER_",
      "values": {
        "TRAVERSAL": 0,
        "DISTANCE_THEN_TERM": 1
      }
    },
    "phoneticRuleSetKind": {
      "cType": "LlevPhoneticRuleSetKind",
      "cPrefix": "LLEV_PHONETIC_RULE_SET_",
      "values": {
        "ENGLISH_ORTHOGRAPHY": 0,
        "ENGLISH_PHONETIC": 1
      }
    }
  },
  "buildFeatures": {
    "CORE": 1,
    "PHONETIC": 2
  },
  "objects": {
    "ResourceTransducer": {
      "accepts": "VtResource(dictionary-v1)",
      "methods": [
        "snapshot",
        "unit_domain",
        "query_utf8",
        "query_bytes",
        "query_u64",
        "query_pattern"
      ]
    },
    "QueryCursor": {
      "ownership": "retains-query-start-snapshot",
      "methods": [
        "next_batch",
        "release_batch",
        "reduce",
        "close"
      ]
    },
    "PhoneticPattern": {
      "feature": "PHONETIC",
      "methods": [
        "compile_regex",
        "compile_llre",
        "size",
        "matches",
        "close"
      ]
    },
    "PhoneticRuleSet": {
      "feature": "PHONETIC",
      "methods": [
        "parse",
        "builtin",
        "len",
        "apply",
        "close"
      ]
    },
    "ScalarWfstResource": {
      "interface": "vt.scalar-wfst.1",
      "unitDomain": "UNICODE_SCALAR",
      "weightDomains": [
        "tropical-f64",
        "log-f64",
        "probability-f64",
        "arctic-f64",
        "signed-tropical-f64",
        "count-f64",
        "boolean-f64"
      ],
      "methods": [
        "snapshot",
        "start",
        "num_states",
        "state_info",
        "state_arcs"
      ]
    },
    "DictionaryEntriesCursor": {
      "interface": "vt.dict.entry.v1",
      "ownership": "move-only-captured-revision-with-one-live-batch-lease",
      "order": "lexicographic",
      "methods": [
        "next_batch",
        "release_batch",
        "reduce",
        "cancel",
        "close"
      ]
    }
  },
  "forbiddenOwnedObjects": [
    "StringIndex",
    "DynamicDawg",
    "DoubleArrayTrie",
    "Scdawg",
    "PersistentArTrie",
    "DictionarySnapshot"
  ],
