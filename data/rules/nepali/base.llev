// ============================================================

[id: 13942, name: "त ta", weight: 0.05, group: nepali_dentals, ipa: "/t̪ʌ/"]
त -> t̪ʌ;

[id: 13943, name: "थ tha", weight: 0.05, group: nepali_dentals, ipa: "/t̪ʰʌ/"]
थ -> t̪ʰʌ;

[id: 13944, name: "द da", weight: 0.05, group: nepali_dentals, ipa: "/d̪ʌ/"]
