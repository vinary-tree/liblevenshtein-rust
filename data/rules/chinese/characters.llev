// Chinese Hanzi Character Phonetic Rules
// =======================================
// Phonetic rules mapping Chinese characters (汉字/Hanzi) to Pinyin.
// Maps individual characters to their most common pronunciation.
//
// This is a comprehensive set of the most frequently used Chinese characters,
// covering approximately 99% of modern Chinese text. Characters are organized
// by frequency and HSK (Hanyu Shuiping Kaoshi) levels.
//
// Key features:
//   - Logographic script: each character represents a morpheme
//   - Character→Pinyin mapping with tone-stripped output
//   - Most common pronunciation used for polyphonic characters
//   - ~3,000 most common characters
//
// Polyphony notes:
//   Some characters have multiple pronunciations depending on context.
//   This file uses the most common pronunciation. Examples:
//   - 行: xíng (walk) is more common than háng (row)
//   - 了: le (aspect marker) is more common than liǎo (finish)
//   - 还: hái (still) is more common than huán (return)
//
// Rule IDs: 10000-19999 (reserved block for Chinese characters)

@name "Chinese Hanzi Character Phonetic Rules"
@version "1.0.0"
@author "liblevenshtein"
@description "Phonetic normalization rules for Chinese Hanzi characters (汉字)"

// ============================================================
// HSK 1 CHARACTERS (~150 most basic)
// ============================================================
// These are the most fundamental characters for beginners

// Pronouns and basic nouns
[id: 10001, name: "wo", weight: 0.01, group: hanzi_hsk1]
我 -> wo;

[id: 10002, name: "ni", weight: 0.01, group: hanzi_hsk1]
你 -> ni;

[id: 10003, name: "ta male", weight: 0.01, group: hanzi_hsk1]
他 -> ta;

[id: 10004, name: "ta female", weight: 0.01, group: hanzi_hsk1]
她 -> ta;

[id: 10005, name: "it/they", weight: 0.01, group: hanzi_hsk1]
它 -> ta;

// Multi-character compounds need lower weight (higher priority) than single characters
[id: 10006, name: "we", weight: 0.005, group: hanzi_hsk1]
我们 -> women;

[id: 10007, name: "you plural", weight: 0.005, group: hanzi_hsk1]
