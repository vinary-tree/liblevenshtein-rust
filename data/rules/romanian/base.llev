// Romanian Base Phonetic Rules
// ============================
// Phonetic rules for Romanian (română).
// Romanian uses Latin script with 5 special characters.
//
// Key features:
//   - Special vowels: ă (schwa), â/î (close central unrounded)
//   - Special consonants: ș (sh), ț (ts)
//   - â vs î: Same sound, â used mid-word, î at beginning/end
//   - Romance language with Latin roots
//
// Note: Only lowercase rules are defined. Input normalization should be
//       handled separately (case-folding before phonetic transformation).
//
// Rule IDs: 3100-3149

@name "Romanian Base Phonetic Rules"
@version "1.0.0"
@author "liblevenshtein"
@description "Phonetic normalization rules for Romanian"

// ============================================================
// SPECIAL CONSONANTS (highest priority)
// ============================================================

// ș → ʃ (like English "sh")
[id: 3100, name: "s cedilla to sh", weight: 0.05, group: romanian_special, ipa: "/ʃ/"]
ș -> ʃ;

// ț → t͡s (like "ts" in "cats")
[id: 3102, name: "t cedilla to ts", weight: 0.05, group: romanian_special, ipa: "/t͡s/"]
ț -> t͡s;

// ============================================================
// SPECIAL VOWELS
// ============================================================

// ă → ə (schwa)
[id: 3105, name: "a breve to schwa", weight: 0.1, group: romanian_vowels, ipa: "/ə/"]
ă -> ə;

// â → ɨ (close central unrounded, similar to Russian ы)
[id: 3107, name: "a circumflex to ɨ", weight: 0.1, group: romanian_vowels, ipa: "/ɨ/"]
â -> ɨ;

// î → ɨ (same sound as â, used at word beginning/end)
[id: 3109, name: "i circumflex to ɨ", weight: 0.1, group: romanian_vowels, ipa: "/ɨ/"]
î -> ɨ;

// ============================================================
// DIGRAPHS
// ============================================================

// ch → k (before e, i - like Italian)
[id: 3112, name: "ch digraph", weight: 0.08, group: romanian_digraphs, ipa: "/k/"]
ch -> k;

// gh → ɡ (before e, i - like Italian)
[id: 3115, name: "gh digraph", weight: 0.08, group: romanian_digraphs, ipa: "/ɡ/"]
gh -> ɡ;

// ============================================================
// CONSONANT TRANSFORMATIONS
// ============================================================

// c → k (before a, o, u) or ch (before e, i) - simplified to k
[id: 3132, name: "c consonant", weight: 0.2, group: romanian_consonants]
c -> k;

// j → ʒ (like French "j")
[id: 3142, name: "j to zh", weight: 0.2, group: romanian_consonants, ipa: "/ʒ/"]
j -> ʒ;

// w → v (loanwords, pronounced as v)
[id: 3226, name: "w to v", weight: 0.2, group: romanian_consonants]
w -> v;

// x → ks
[id: 3228, name: "x to ks", weight: 0.2, group: romanian_consonants]
x -> ks;

// y → i (rare, loanwords)
[id: 3230, name: "y to i", weight: 0.2, group: romanian_consonants]
y -> i;
