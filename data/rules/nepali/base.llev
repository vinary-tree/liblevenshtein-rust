[id: 13945, name: "ध dha", weight: 0.05, group: nepali_dentals, ipa: "/d̪ʱʌ/"]
ध -> d̪ʱʌ;

[id: 13946, name: "न na", weight: 0.05, group: nepali_dentals, ipa: "/nʌ/"]
न -> nʌ;

