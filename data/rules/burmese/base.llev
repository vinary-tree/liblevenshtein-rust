// Burmese Base Phonetic Rules
// ===========================
// Phonetic rules for Burmese (မြန်မာဘာသာ / Mranmabhasa).
// Spoken by approximately 52 million people in Myanmar.
//
// Burmese features:
//   - Sino-Tibetan language family
//   - Myanmar script (abugida)
//   - Aspirated vs unaspirated stops: p/pʰ, t/tʰ, k/kʰ
//   - Voiced vs voiceless distinction
//   - 4-tone system: low, high, creaky, checked
//   - Nasalized vowels
//   - Final glottal stop in checked tone
//
// Orthography (Romanization - MLC/BGN):
//   - Aspirated stops: hp, ht, hk, hc
//   - Tones: unmarked (low), acute (high), tilde (creaky), -' (checked)
//   - ng for velar nasal /ŋ/
//   - ny for palatal nasal /ɲ/
//
// Rule IDs: 10400-10499

@name "Burmese Phonetic Rules"
@version "1.0.0"
@author "liblevenshtein"
@description "Phonetic normalization rules for Burmese (Myanmar)"

// ============================================================
// VOWELS (weight 0.05)
// ============================================================
// Note: Identity mappings removed (a->a, e->e, i->i, o->o, u->u, ei->ei, ou->ou, ai->ai)

// ============================================================
// TONES (weight 0.05)
// Low tone: unmarked
// High tone: acute accent
// Creaky tone: tilde
// Checked tone: final glottal stop
// ============================================================

[id: 10410, name: "a high tone", weight: 0.05, group: burmese_tones, ipa: "/a˦/"]
á -> a˦;

[id: 10411, name: "e high tone", weight: 0.05, group: burmese_tones, ipa: "/e˦/"]
é -> e˦;

[id: 10412, name: "i high tone", weight: 0.05, group: burmese_tones, ipa: "/i˦/"]
í -> i˦;

[id: 10413, name: "o high tone", weight: 0.05, group: burmese_tones, ipa: "/o˦/"]
ó -> o˦;

[id: 10414, name: "u high tone", weight: 0.05, group: burmese_tones, ipa: "/u˦/"]
ú -> u˦;

[id: 10415, name: "a creaky tone", weight: 0.05, group: burmese_tones, ipa: "/a̰/"]
ã -> a̰;

[id: 10416, name: "e creaky tone", weight: 0.05, group: burmese_tones, ipa: "/ḛ/"]
ẽ -> ḛ;

[id: 10417, name: "i creaky tone", weight: 0.05, group: burmese_tones, ipa: "/ḭ/"]
ĩ -> ḭ;

[id: 10418, name: "o creaky tone", weight: 0.05, group: burmese_tones, ipa: "/o̰/"]
õ -> o̰;

[id: 10419, name: "u creaky tone", weight: 0.05, group: burmese_tones, ipa: "/ṵ/"]
ũ -> ṵ;

// ============================================================
// ASPIRATED STOPS (weight 0.05)
// ============================================================

[id: 10420, name: "hp aspirated", weight: 0.05, group: burmese_aspirated, ipa: "/pʰ/"]
hp -> pʰ;

[id: 10421, name: "ht aspirated", weight: 0.05, group: burmese_aspirated, ipa: "/tʰ/"]
ht -> tʰ;

[id: 10422, name: "hk aspirated", weight: 0.05, group: burmese_aspirated, ipa: "/kʰ/"]
hk -> kʰ;

[id: 10423, name: "hc aspirated palatal", weight: 0.05, group: burmese_aspirated, ipa: "/t͡ɕʰ/"]
hc -> t͡ɕʰ;

[id: 10424, name: "ph aspirated alt", weight: 0.05, group: burmese_aspirated, ipa: "/pʰ/"]
ph -> pʰ;

[id: 10425, name: "th aspirated alt", weight: 0.05, group: burmese_aspirated, ipa: "/tʰ/"]
th -> tʰ;

[id: 10426, name: "kh aspirated alt", weight: 0.05, group: burmese_aspirated, ipa: "/kʰ/"]
kh -> kʰ;

[id: 10427, name: "ch aspirated alt", weight: 0.05, group: burmese_aspirated, ipa: "/t͡ɕʰ/"]
ch -> t͡ɕʰ;

// ============================================================
// PLAIN STOPS (weight 0.05)
// ============================================================
// Note: Identity mappings removed (p->p, b->b, t->t, d->d, k->k)

[id: 10435, name: "g", weight: 0.05, group: burmese_stops, ipa: "/ɡ/"]
g -> ɡ;

[id: 10436, name: "glottal stop", weight: 0.05, group: burmese_stops, ipa: "/ʔ/"]
' -> ʔ;

// ============================================================
// AFFRICATES (weight 0.05)
// ============================================================

[id: 10440, name: "c voiceless palatal", weight: 0.05, group: burmese_affricates, ipa: "/t͡ɕ/"]
c -> t͡ɕ;

[id: 10441, name: "j voiced palatal", weight: 0.05, group: burmese_affricates, ipa: "/d͡ʑ/"]
j -> d͡ʑ;

// ============================================================
// FRICATIVES (weight 0.05)
// ============================================================
// Note: Identity mappings removed (s->s, z->z, h->h)

[id: 10447, name: "sh postalveolar", weight: 0.05, group: burmese_fricatives, ipa: "/ʃ/"]
sh -> ʃ;

// ============================================================
// NASALS (weight 0.05)
// ============================================================
// Note: Identity mappings removed (m->m, n->n)

[id: 10451, name: "hm voiceless", weight: 0.05, group: burmese_nasals, ipa: "/m̥/"]
hm -> m̥;

[id: 10453, name: "hn voiceless", weight: 0.05, group: burmese_nasals, ipa: "/n̥/"]
hn -> n̥;

[id: 10454, name: "ng velar nasal", weight: 0.05, group: burmese_nasals, ipa: "/ŋ/"]
ng -> ŋ;

[id: 10455, name: "hng voiceless velar", weight: 0.05, group: burmese_nasals, ipa: "/ŋ̊/"]
hng -> ŋ̊;

[id: 10456, name: "ny palatal nasal", weight: 0.05, group: burmese_nasals, ipa: "/ɲ/"]
ny -> ɲ;

[id: 10457, name: "hny voiceless palatal", weight: 0.05, group: burmese_nasals, ipa: "/ɲ̥/"]
hny -> ɲ̥;

// ============================================================
// LIQUIDS AND APPROXIMANTS (weight 0.05)
// ============================================================
// Note: Identity mappings removed (l->l, w->w)

[id: 10461, name: "hl voiceless", weight: 0.05, group: burmese_liquids, ipa: "/l̥/"]
hl -> l̥;

[id: 10463, name: "hw voiceless", weight: 0.05, group: burmese_approximants, ipa: "/ʍ/"]
hw -> ʍ;

[id: 10464, name: "y", weight: 0.05, group: burmese_approximants, ipa: "/j/"]
y -> j;

// ============================================================
// COMMON WORDS (weight 0.02)
// ============================================================

[id: 10480, name: "myanma myanmar", weight: 0.02, group: burmese_common]
myanma -> mjanma;

[id: 10481, name: "mingalaba hello", weight: 0.02, group: burmese_common]
mingalaba -> miŋɡalaba;

[id: 10482, name: "kyeizu thank you", weight: 0.02, group: burmese_common]
kyeizu -> t͡ɕeizu;

[id: 10483, name: "houk yes", weight: 0.02, group: burmese_common]
houk -> houʔ;

[id: 10484, name: "mahote no", weight: 0.02, group: burmese_common]
mahote -> mahouʔtʰe;

[id: 10485, name: "ye water", weight: 0.02, group: burmese_common]
ye -> je;

[id: 10486, name: "htamin rice food", weight: 0.02, group: burmese_common]
htamin -> tʰamin;

[id: 10487, name: "ein house", weight: 0.02, group: burmese_common]
ein -> eiɰ̃;

// Note: Identity mappings removed (lu -> lu, kale -> kale)

