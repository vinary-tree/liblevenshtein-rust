@startuml concurrency-model
' liblevenshtein — read/write concurrency model, grouped by synchronization strategy.
' Every dictionary backend is Send + Sync and cheap to share via Arc; what differs
' is HOW concurrent readers and writers are coordinated.
' Color legend:
'   concurrency  #CFD8DC / #ECEFF1 / #455A64  = the two sync-strategy groups
'   dictionary   #E8F5E9 (green tint)         = the dictionary backends themselves
'   border/arrow #455A64 (slate)              = concurrency borders & arrows
' Strategies (per the SyncStrategy enum):
'   Wait-free / lock-free reads — readers never block: an immutable snapshot
'     (DoubleArrayTrie), ArcSwap RCU (DynamicDawgU64), or lock-free CAS over a
'     memory-mapped overlay (PersistentARTrie — dynamic AND disk-persisted)
'   RwLock readers — parking_lot read guards; readers block only a concurrent writer
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam rectangle {
  RoundCorner 14
  BorderColor #455A64
  FontColor #102027
}
skinparam ArrowColor #37474F
skinparam ArrowThickness 2

title Concurrency model — dictionary reads grouped by synchronization strategy

rectangle "All dictionaries: Send + Sync · Arc cheap-clone" as banner #CFD8DC

rectangle "Wait-free / lock-free reads (immutable · ArcSwap · CAS)" as gfree #CFD8DC {
  rectangle "DoubleArrayTrie\nimmutable array · O(1) reads · static" as dat #E8F5E9
  rectangle "DynamicDawgU64 (ArcSwap RCU)\nper-node copy-on-write · CAS writes" as ddu64 #E8F5E9
  rectangle "PersistentARTrie (mmap, disk-persisted)\ndynamic · lock-free CAS reads + writes" as art #E8F5E9
}

rectangle "RwLock readers (parking_lot)" as glock #CFD8DC {
  rectangle "DynamicDawg" as dd #E8F5E9
  rectangle "SuffixAutomaton" as sa #E8F5E9
  rectangle "Scdawg" as sc #E8F5E9
}

banner -[#455A64,thickness=3]down-> gfree
banner -[#455A64,thickness=3]down-> glock

@enduml
