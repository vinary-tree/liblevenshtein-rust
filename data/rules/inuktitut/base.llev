[id: 8675, name: "syllabic mi", weight: 0.05, group: inuktitut_syllabics, ipa: "/mi/"]
ᒥ -> mi;

[id: 8676, name: "syllabic ni", weight: 0.05, group: inuktitut_syllabics, ipa: "/ni/"]
ᓂ -> ni;

[id: 8677, name: "syllabic si", weight: 0.05, group: inuktitut_syllabics, ipa: "/si/"]
