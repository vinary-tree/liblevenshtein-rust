<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>Liblevenshtein</PackageId>
    <Version>4.0.0-rc.6</Version>
    <Description>A high-performance library for spelling correction, fuzzy dictionary search, and phonetic matching using Levenshtein and related finite-state automata.</Description>
    <Authors>Dylon Edwards</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/vinary-tree/liblevenshtein-rust</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup Condition="'$(VinaryTreeInteropRoot)' != ''">
    <ProjectReference Include="$(VinaryTreeInteropRoot)/bindings/dotnet/src/VinaryTree.Interop/VinaryTree.Interop.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(VinaryTreeInteropRoot)' == ''">
    <PackageReference Include="VinaryTree.Interop" Version="4.0.0-rc.6" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="README.md" />
    <None Include="../../native/runtimes/**/*"
          Pack="true"
          PackagePath="runtimes/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
