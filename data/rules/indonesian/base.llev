// Indonesian Base Phonetic Rules
// ===============================
// Phonetic rules for Indonesian (Bahasa Indonesia).
// Indonesian uses Latin script with nearly phonemic orthography.
//
// Key features:
//   - Very simple, nearly phonetic spelling
//   - No diacritics in standard spelling
//   - C = ch sound (like English "ch")
//   - J = dj sound (like English "j")
//   - Digraphs: ng, ny, sy, kh
//   - 6 vowels: /a/, /e/, /i/, /o/, /u/ (e can be schwa)
//   - Consonants: /b/, /d/, /f/, /g/, /h/, /k/, /l/, /m/, /n/, /p/, /r/, /s/, /t/, /w/, /y/, /z/
//
// Rule IDs: 3150-3199

@name "Indonesian Base Phonetic Rules"
@version "1.0.0"
@author "liblevenshtein"
@description "Phonetic normalization rules for Indonesian"

// ============================================================
// DIGRAPHS (highest priority - must match before single letters)
// ============================================================

// Ng -> ŋ (velar nasal, very common)
[id: 3150, name: "ng digraph", weight: 0.05, group: indonesian_digraphs, ipa: "/ŋ/"]
ng -> ŋ;

// Ny -> ɲ (palatal nasal, like Spanish ñ)
[id: 3153, name: "ny digraph", weight: 0.05, group: indonesian_digraphs, ipa: "/ɲ/"]
ny -> ɲ;

// Sy -> ʃ (like English "sh", from Arabic loanwords)
[id: 3156, name: "sy digraph", weight: 0.05, group: indonesian_digraphs, ipa: "/ʃ/"]
sy -> ʃ;

// Kh -> x (voiceless velar fricative, Arabic loanwords)
[id: 3159, name: "kh digraph", weight: 0.05, group: indonesian_digraphs, ipa: "/x/"]
kh -> x;

// ============================================================
// SPECIAL CONSONANTS
// ============================================================

// C -> t͡ʃ (always like English "ch", never like "k" or "s")
[id: 3165, name: "c to t͡ʃ", weight: 0.1, group: indonesian_consonants, ipa: "/t͡ʃ/"]
c -> t͡ʃ;

// J -> d͡ʒ (like English "j" in "judge")
[id: 3167, name: "j to d͡ʒ", weight: 0.1, group: indonesian_consonants, ipa: "/d͡ʒ/"]
j -> d͡ʒ;

// V -> f (often pronounced as f in Indonesian)
[id: 3206, name: "v to f", weight: 0.2, group: indonesian_consonants, ipa: "/f/"]
v -> f;
