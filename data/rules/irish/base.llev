// Irish Base Phonetic Rules
// =========================
// Phonetic rules for Irish (Gaeilge).
// Celtic language spoken in Ireland.
//
// Key features:
//   - Séimhiú (lenition): consonant + h changes sound
//   - Lenited consonants: bh, ch, dh, fh, gh, mh, ph, sh, th
//   - Fadas (acute accent): á, é, í, ó, ú (long vowels)
//   - FH is completely silent!
//
// Rule IDs: 4880-4949

@name "Irish Base Phonetic Rules"
@version "1.0.0"
@author "liblevenshtein"
@description "Phonetic normalization rules for Irish"

// ============================================================
// SÉIMHIÚ (LENITION) - consonant + h
// ============================================================

// BH → V (like English "v")
[id: 4880, name: "bh lenition", weight: 0.05, group: irish_lenition]
bh -> v;

[id: 4881, name: "Bh lenition", weight: 0.05, group: irish_lenition]
Bh -> v;

[id: 4882, name: "BH lenition upper", weight: 0.05, group: irish_lenition]
BH -> v;

// CH → x (voiceless velar fricative, like Scottish "loch")
[id: 4883, name: "ch lenition", weight: 0.05, group: irish_lenition, ipa: "/x/"]
ch -> x;

[id: 4884, name: "Ch lenition", weight: 0.05, group: irish_lenition, ipa: "/x/"]
Ch -> x;

[id: 4885, name: "CH lenition upper", weight: 0.05, group: irish_lenition, ipa: "/x/"]
CH -> x;

// DH → ɣ (voiced velar fricative)
[id: 4886, name: "dh lenition", weight: 0.05, group: irish_lenition, ipa: "/ɣ/"]
dh -> ɣ;

[id: 4887, name: "Dh lenition", weight: 0.05, group: irish_lenition, ipa: "/ɣ/"]
Dh -> ɣ;

[id: 4888, name: "DH lenition upper", weight: 0.05, group: irish_lenition, ipa: "/ɣ/"]
DH -> ɣ;

// FH → (silent!) - completely silent in Irish
[id: 4889, name: "fh lenition", weight: 0.05, group: irish_lenition]
fh -> ;

[id: 4890, name: "Fh lenition", weight: 0.05, group: irish_lenition]
Fh -> ;

[id: 4891, name: "FH lenition upper", weight: 0.05, group: irish_lenition]
FH -> ;

// GH → ɣ (voiced velar fricative)
[id: 4892, name: "gh lenition", weight: 0.05, group: irish_lenition, ipa: "/ɣ/"]
gh -> ɣ;

[id: 4893, name: "Gh lenition", weight: 0.05, group: irish_lenition, ipa: "/ɣ/"]
Gh -> ɣ;

[id: 4894, name: "GH lenition upper", weight: 0.05, group: irish_lenition, ipa: "/ɣ/"]
GH -> ɣ;

// MH → V (like English "v")
[id: 4895, name: "mh lenition", weight: 0.05, group: irish_lenition]
mh -> v;

[id: 4896, name: "Mh lenition", weight: 0.05, group: irish_lenition]
Mh -> v;

[id: 4897, name: "MH lenition upper", weight: 0.05, group: irish_lenition]
MH -> v;

// PH → F (like English "f")
[id: 4898, name: "ph lenition", weight: 0.05, group: irish_lenition]
ph -> f;

[id: 4899, name: "Ph lenition", weight: 0.05, group: irish_lenition]
Ph -> f;

[id: 4900, name: "PH lenition upper", weight: 0.05, group: irish_lenition]
PH -> f;

// SH → H (like English "h")
[id: 4901, name: "sh lenition", weight: 0.05, group: irish_lenition]
sh -> h;

[id: 4902, name: "Sh lenition", weight: 0.05, group: irish_lenition]
Sh -> h;

[id: 4903, name: "SH lenition upper", weight: 0.05, group: irish_lenition]
SH -> h;

// TH → H (like English "h")
[id: 4904, name: "th lenition", weight: 0.05, group: irish_lenition]
th -> h;

[id: 4905, name: "Th lenition", weight: 0.05, group: irish_lenition]
Th -> h;

[id: 4906, name: "TH lenition upper", weight: 0.05, group: irish_lenition]
TH -> h;

// ============================================================
// FADAS (long vowels with acute accent)
// ============================================================

[id: 4907, name: "a fada", weight: 0.1, group: irish_fadas]
á -> a;

[id: 4908, name: "A fada", weight: 0.1, group: irish_fadas]
Á -> a;

[id: 4909, name: "e fada", weight: 0.1, group: irish_fadas]
é -> e;

[id: 4910, name: "E fada", weight: 0.1, group: irish_fadas]
É -> e;

[id: 4911, name: "i fada", weight: 0.1, group: irish_fadas]
í -> i;

[id: 4912, name: "I fada", weight: 0.1, group: irish_fadas]
Í -> i;

[id: 4913, name: "o fada", weight: 0.1, group: irish_fadas]
ó -> o;

[id: 4914, name: "O fada", weight: 0.1, group: irish_fadas]
Ó -> o;

[id: 4915, name: "u fada", weight: 0.1, group: irish_fadas]
ú -> u;

[id: 4916, name: "U fada", weight: 0.1, group: irish_fadas]
Ú -> u;

