// Spanish Base Phonetic Rules
// ===========================
// Shared rules for all Spanish dialects.
// These rules normalize Spanish orthography to phonetic representation.
//
// Spanish has highly regular orthography with few exceptions.
// Key features:
//   - 5 pure vowels (a, e, i, o, u)
//   - C/G softening before front vowels
//   - Silent H (always)
//   - LL/Y merger (yeísmo in most dialects)
//   - Ñ as distinct phoneme
//
// Note: Castilian distinción (z/c vs s) is handled in dialect files.

@name "Spanish Base Phonetic Rules"
@version "1.0.0"
@author "liblevenshtein"
@description "Shared phonetic rules for all Spanish dialects"

// ============================================================
// Symbol Definitions
// ============================================================

@define VOWEL = [aeiouáéíóúü]
@define FRONT_VOWEL = [eiéí]
@define CONSONANT = [bcdfghjklmnñpqrstvwxyz]

// ============================================================
// MULTI-CHARACTER PATTERNS (must come first)
// ============================================================

// QU handling - qu before e/i is just k sound
[id: 1000, name: "qu before e", weight: 0.1, group: spanish_digraphs]
que -> ke;

[id: 1001, name: "qu before i", weight: 0.1, group: spanish_digraphs]
qui -> ki;

// GU handling - gu before e/i is just g sound (u is silent)
[id: 1002, name: "gu before e", weight: 0.1, group: spanish_digraphs]
gue -> ge;

[id: 1003, name: "gu before i", weight: 0.1, group: spanish_digraphs]
gui -> gi;

// GÜ - the diaeresis indicates u is pronounced
[id: 1004, name: "gü before e", weight: 0.1, group: spanish_digraphs]
güe -> gwe;

[id: 1005, name: "gü before i", weight: 0.1, group: spanish_digraphs]
güi -> gwi;

// CH digraph - historically a single letter, represents /tʃ/
[id: 1010, name: "ch digraph", weight: 0.1, group: spanish_digraphs, ipa: "/t͡ʃ/"]
ch -> t͡ʃ;

// LL digraph - /ʎ/ historically, but /y/ in most modern dialects (yeísmo)
[id: 1011, name: "ll to y (yeísmo)", weight: 0.1, group: spanish_digraphs]
ll -> y;

// Note: RR represents a trill distinct from single r tap.
// No transformation needed - trill passes through unchanged.

// ============================================================
// SILENT H
// ============================================================
// H is always silent in Spanish (except in 'ch' digraph handled above)

[id: 1020, name: "silent h word-initial", weight: 0.15, group: spanish_silent]
h -> / #_;

[id: 1021, name: "silent h after vowel", weight: 0.15, group: spanish_silent]
h -> / $VOWEL _;

// ============================================================
// X PATTERNS (must come before G/J softening)
// ============================================================
// X in modern Spanish orthography is /ks/ (like "taxi", "extra")
// This rule must be applied BEFORE G/J softening rules below,
// so that the /x/ phoneme output from J and soft G is not converted.

[id: 1030, name: "x to ks", weight: 0.2, group: spanish_x]
x -> ks;

// ============================================================
// G SOFTENING
// ============================================================
// G before e/i is pronounced as velar fricative /x/ (like Scottish 'loch')

[id: 1040, name: "soft g before e", weight: 0.2, group: spanish_softening, ipa: "/x/"]
ge -> xe;

[id: 1041, name: "soft g before i", weight: 0.2, group: spanish_softening, ipa: "/x/"]
gi -> xi;

[id: 1042, name: "soft g before é", weight: 0.2, group: spanish_softening, ipa: "/x/"]
gé -> xé;

[id: 1043, name: "soft g before í", weight: 0.2, group: spanish_softening, ipa: "/x/"]
gí -> xí;

// ============================================================
// J PRONUNCIATION
// ============================================================
// J is always /x/ (velar fricative)

[id: 1050, name: "j to x", weight: 0.2, group: spanish_j, ipa: "/x/"]
j -> x;

// ============================================================
// B/V MERGER
// ============================================================
// In Spanish, B and V are allophones (both /b/)

[id: 1060, name: "v to b", weight: 0.2, group: spanish_bv]
v -> b;

// ============================================================
// ACCENT NORMALIZATION
// ============================================================
// Normalize accented vowels to base vowels for matching
// (accents indicate stress, not different sounds)

[id: 1070, name: "á to a", weight: 0.3, group: spanish_accents]
á -> a;

[id: 1071, name: "é to e", weight: 0.3, group: spanish_accents]
é -> e;

[id: 1072, name: "í to i", weight: 0.3, group: spanish_accents]
í -> i;

[id: 1073, name: "ó to o", weight: 0.3, group: spanish_accents]
ó -> o;

[id: 1074, name: "ú to u", weight: 0.3, group: spanish_accents]
ú -> u;

[id: 1075, name: "ü to u", weight: 0.3, group: spanish_accents]
ü -> u;

// ============================================================
// Ñ PRESERVATION
// ============================================================
// Ñ is a distinct phoneme /ɲ/ (palatal nasal)

[id: 1080, name: "ñ to ɲ", weight: 0.2, group: spanish_special, ipa: "/ɲ/"]
ñ -> ɲ;

// ============================================================
// W HANDLING
// ============================================================
// W only appears in loanwords, pronounced as /w/ or /b/

[id: 1085, name: "w to u", weight: 0.3, group: spanish_loanwords]
w -> u;

// Note: K only appears in loanwords (Spanish uses 'c' or 'qu').
// No transformation needed - k passes through unchanged.

// ============================================================
// Geminate (Double Consonant) Simplification
// ============================================================
// Spanish doesn't have meaningful geminates except RR (trill) and LL
// (palatal lateral, handled above as digraphs, not true geminates).
// Other orthographic doubles are simplified for phonetic matching.

[id: 1090, name: "cc to k", weight: 0.25, group: spanish_geminates]
cc -> k;

[id: 1091, name: "nn to n", weight: 0.25, group: spanish_geminates]
nn -> n;

[id: 1092, name: "ss to s", weight: 0.25, group: spanish_geminates]
ss -> s;

// ============================================================
// FINAL CONSONANTS
// ============================================================
// Spanish preserves final consonants (unlike French)
// No rules needed here - consonants are pronounced

// ============================================================
// Spanish Metaphone Derived Rules
// ============================================================
// Additional rules based on the Spanish Metaphone algorithm
// for improved phonetic matching.
// ID Range: 2500-2599

// ------------------------------------------------------------
// R/RR Patterns
// ------------------------------------------------------------
// Spanish distinguishes between single R (tap) and RR (trill)
// For matching purposes, we can normalize them

[id: 2500, name: "rr trill spanish", weight: 0.15, group: spanish_metaphone_r, ipa: "/r/"]
// RR (alveolar trill) at any position
// Keeping as rr to distinguish from single r
rr -> r;

[id: 2501, name: "r initial trill spanish", weight: 0.15, group: spanish_metaphone_r, ipa: "/r/"]
// Initial R is also a trill (phonetically same as RR)
// For matching: initial r treated equivalently to rr
// No transformation needed, but document pattern

// ------------------------------------------------------------
// Y Handling
// ------------------------------------------------------------

[id: 2510, name: "y final vowel spanish", weight: 0.20, group: spanish_metaphone_y, ipa: "/i/"]
// Y at word end is a vowel (sounds like 'i'): rey, muy, hoy
y -> i / _#;

[id: 2511, name: "y initial consonant spanish", weight: 0.15, group: spanish_metaphone_y, ipa: "/ʝ/"]
// Y at word start is consonantal: yo, ya
// Note: In yeísmo dialects, this merges with ll
y -> ʝ / #_;

// ------------------------------------------------------------
// Initial S + Consonant (Prothetic E)
// ------------------------------------------------------------
// Some speakers add prothetic 'e' before s+consonant clusters
// This helps match with/without the prothesis

[id: 2520, name: "s cluster prothesis", weight: 0.25, group: spanish_metaphone_cluster]
// es- before s+consonant: España/Spain, especial/special
// Note: This is for matching loanwords with/without prothesis
// No transformation needed, but document pattern

// ------------------------------------------------------------
// NV/NF Nasal Assimilation
// ------------------------------------------------------------

[id: 2530, name: "nv to mb spanish", weight: 0.20, group: spanish_metaphone_nasal]
// NV can assimilate: envidia -> embidia (casual speech)
// Higher weight indicates this is dialectal variation
nv -> mb;

[id: 2531, name: "nf to mf spanish", weight: 0.20, group: spanish_metaphone_nasal]
// NF can assimilate: enfermo -> emfermo (casual speech)
nf -> mf;

// ------------------------------------------------------------
// Final Consonant Weakening (Dialectal)
// ------------------------------------------------------------
// In some dialects, final consonants are weakened or dropped
// These rules have high weights as they're dialectally variable

[id: 2540, name: "d final weak spanish", weight: 0.30, group: spanish_metaphone_final]
// Final D often weakened or silent: Madrid -> Madri(d)
// Weight indicates significant variation
d -> / _#;

[id: 2541, name: "s final weak spanish", weight: 0.35, group: spanish_metaphone_final]
// Final S can be aspirated or dropped in Caribbean/Andalusian
// Very high weight - this is major dialectal feature
// Keeping as 's' in base, dialect files can override

[id: 2542, name: "r final weak spanish", weight: 0.30, group: spanish_metaphone_final]
// Final R can be weakened: amor -> amo(r)
// Weight indicates variation

[id: 2543, name: "n final velar spanish", weight: 0.25, group: spanish_metaphone_final, ipa: "/ŋ/"]
// Final N often velarized: pan -> paŋ
n -> ŋ / _#;

// ------------------------------------------------------------
// NG/NK Patterns
// ------------------------------------------------------------

[id: 2550, name: "ng spanish", weight: 0.15, group: spanish_metaphone_ng, ipa: "/ŋg/"]
// NG: tango -> taŋgo
ng -> ŋg;

[id: 2551, name: "nk spanish", weight: 0.15, group: spanish_metaphone_ng, ipa: "/ŋk/"]
// NK in loanwords: tanque
nk -> ŋk;

// ------------------------------------------------------------
// CT Pattern
// ------------------------------------------------------------

[id: 2560, name: "ct cluster spanish", weight: 0.20, group: spanish_metaphone_cluster]
// CT cluster: often simplified in casual speech
// doctor -> dotor, acto -> ato
// Higher weight indicates variation
ct -> t;

// ------------------------------------------------------------
// PS/PT Initial Clusters
// ------------------------------------------------------------
// Spanish keeps these clusters (unlike English which drops first letter)

[id: 2570, name: "ps initial spanish", weight: 0.0, group: spanish_metaphone_initial, ipa: "/ps/"]
// PS: psicología (p is pronounced in Spanish)
// No change needed

[id: 2571, name: "pt initial spanish", weight: 0.0, group: spanish_metaphone_initial, ipa: "/pt/"]
// PT: pterodáctilo (p is pronounced in Spanish)
// No change needed

